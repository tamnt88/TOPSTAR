@page "/dang-ky"
@model Topstar.Web.Pages.Public.RegisterModel
@{
    ViewData["Title"] = "Chọn loại tài khoản";
    ViewData["Description"] = "Chọn hướng đăng ký phù hợp: KOC hoặc Brand.";
    ViewData["Keywords"] = "đăng ký KOC, đăng ký Brand, TopStar";
}

<section class="login-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-9 col-xl-8">
                <div class="login-shell register-shell p-4 p-md-5">
                    <h1 class="mb-2" style="font-family:'Saira Stencil',sans-serif;">Chọn kiểu tài khoản</h1>
                    <p class="text-muted mb-4">Mỗi nhóm có hành trình đăng ký khác nhau để phù hợp mục tiêu sử dụng.</p>

                    <div class="row g-3 register-choice-grid">
                        <div class="col-md-6">
                            <a asp-page="/Public/RegisterKocStep1" class="register-choice-card register-choice-link">
                                <span class="register-choice-icon"><i class="fa-solid fa-user-check"></i></span>
                                <span class="register-choice-text">
                                    <strong>Tôi là KOC/KOL</strong>
                                    <small>Tạo hồ sơ cá nhân, social, kỹ năng và nhận job từ brand.</small>
                                </span>
                            </a>
                        </div>
                        <div class="col-md-6">
                            <a asp-page="/Public/RegisterBrand" class="register-choice-card register-choice-link">
                                <span class="register-choice-icon"><i class="fa-solid fa-building"></i></span>
                                <span class="register-choice-text">
                                    <strong>Tôi là Brand/Doanh nghiệp</strong>
                                    <small>Tạo tài khoản doanh nghiệp để triển khai chiến dịch KOC.</small>
                                </span>
                            </a>
                        </div>
                    </div>

                    <div class="text-center mt-4">
                        Đã có tài khoản? <a asp-page="/Public/Login" class="login-link">Đăng nhập ngay</a>
                    </div>

                    <div class="social-auth-block mt-4">
                        <p class="social-auth-title">Đăng ký nhanh</p>
                        <div class="quick-role-picker mb-2">
                            <label><input type="radio" name="quickRole" value="Koc" checked /> Tôi là KOC/KOL</label>
                            <label><input type="radio" name="quickRole" value="Brand" /> Tôi là Brand</label>
                        </div>
                        <div class="social-auth-grid">
                            <form method="post" asp-page="/Public/Login" asp-page-handler="External" class="m-0">
                                <input type="hidden" name="provider" value="Facebook" />
                                <input type="hidden" name="mode" value="register" />
                                <input type="hidden" name="role" value="Koc" class="quick-role-input" />
                                <button type="submit" class="social-auth-btn social-auth-btn-inline w-100" aria-label="Đăng ký nhanh với Facebook">
                                    <img src="~/images/icon/facebook.png" alt="Facebook" />
                                    <span>Facebook</span>
                                </button>
                            </form>
                            <form method="post" asp-page="/Public/Login" asp-page-handler="External" class="m-0">
                                <input type="hidden" name="provider" value="Google" />
                                <input type="hidden" name="mode" value="register" />
                                <input type="hidden" name="role" value="Koc" class="quick-role-input" />
                                <button type="submit" class="social-auth-btn social-auth-btn-inline w-100" aria-label="Đăng ký nhanh với Google">
                                    <img src="~/images/icon/google.png" alt="Google" />
                                    <span>Google</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            const roleRadios = document.querySelectorAll('input[name="quickRole"]');
            const roleInputs = document.querySelectorAll('.quick-role-input');
            const syncRole = () => {
                const selected = document.querySelector('input[name="quickRole"]:checked');
                const value = selected ? selected.value : 'Koc';
                roleInputs.forEach(x => x.value = value);
            };
            roleRadios.forEach(r => r.addEventListener('change', syncRole));
            syncRole();
        })();
    </script>
}
