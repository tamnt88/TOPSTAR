@page
@{ ViewData["Title"] = "Register KOC - Step 1"; }
<div class="page-wrap card-list">
  <h1 class="section-title">Dang ky KOC - Buoc 1/5</h1>
  <div class="card-x">
    <div class="kpi-title mb-2">Thong tin tai khoan</div>
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">Ho va ten</label><input class="form-control" placeholder="Nguyen Minh Anh" /></div>
      <div class="col-md-6"><label class="form-label">So dien thoai</label><input class="form-control" placeholder="09xxxxxxxx" /></div>
      <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" placeholder="name@email.com" /></div>
      <div class="col-md-6"><label class="form-label">Mat khau</label><input type="password" class="form-control" /></div>
    </div>
    <div class="mt-3 d-flex justify-content-end">
      <a class="btn-x btn-orange text-decoration-none" asp-page="/Public/RegisterKocStep2">Tiep tuc</a>
    </div>
  </div>
</div>
