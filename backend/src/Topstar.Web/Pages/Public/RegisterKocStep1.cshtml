@page "/dang-ky-koc/buoc-1"
@{
    ViewData["Title"] = "Đăng ký KOC - Bước 1";
}

<section class="koc-register-page py-4 py-md-5">
    <div class="container">
        <a asp-page="/Public/Register" class="koc-back-link"><i class="fa-solid fa-arrow-left"></i>Quay lại</a>

        <div class="koc-register-card mt-3 mt-md-2">
            <div class="koc-register-head text-center">
                <span class="koc-register-avatar"><i class="fa-regular fa-user"></i></span>
                <h1>Đăng ký KOC</h1>
                <p>Tạo tài khoản và bắt đầu sự nghiệp KOC</p>
            </div>

            <div class="koc-stepper mb-4">
                <div class="koc-step active">
                    <span>1</span>
                    <small>Thông tin cơ bản</small>
                </div>
                <div class="koc-step-line active"></div>
                <div class="koc-step">
                    <span>2</span>
                    <small>Mạng xã hội</small>
                </div>
                <div class="koc-step-line"></div>
                <div class="koc-step">
                    <span>3</span>
                    <small>Thông tin cá nhân</small>
                </div>
            </div>

            <h2 class="koc-form-title">Thông tin cơ bản</h2>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Họ và tên <span class="text-danger">*</span></label>
                    <input class="form-control" placeholder="Nguyễn Văn A" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email <span class="text-danger">*</span></label>
                    <input class="form-control" placeholder="you@example.com" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Số điện thoại</label>
                    <input class="form-control" placeholder="VD: 0912345678" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ngày sinh</label>
                    <input type="date" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">Địa chỉ</label>
                    <input class="form-control" placeholder="VD: 123 Đường ABC, Quận XYZ, TP.HCM" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Mật khẩu <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" placeholder="••••••••" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Ảnh đại diện</label>
                    <input type="file" class="form-control" />
                </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
                <a asp-page="/Public/RegisterKocStep2" class="btn koc-btn-primary">Tiếp tục <i class="fa-solid fa-arrow-right"></i></a>
            </div>

            <p class="koc-login-hint">Đã có tài khoản? <a asp-page="/Public/Login">Đăng nhập ngay</a></p>
        </div>
    </div>
</section>
