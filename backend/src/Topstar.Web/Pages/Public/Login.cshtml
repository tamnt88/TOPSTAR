@page "/dang-nhap"
@model Topstar.Web.Pages.Public.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["Description"] = "Đăng nhập tài khoản TopStar để quản lý chiến dịch KOC, theo dõi báo cáo và tối ưu hiệu quả.";
    ViewData["Keywords"] = "đăng nhập TopStar, tài khoản KOC, tài khoản Brand";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public/login-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public/auth-polish.css" asp-append-version="true" />
}

<div class="login-page login-page-theme">
    <section class="login-section section-flow reveal-up py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-9">
                    <div class="login-shell flow-item">
                        <div class="row g-0">
                            <div class="col-lg-5 login-aside">
                                <div class="login-aside-content">
                                    <p class="login-eyebrow"><i class="fa-solid fa-star"></i> TopStar Platform</p>
                                    <h1>Đăng nhập<br><span>tài khoản</span></h1>
                                    <p>Quản lý công việc, theo dõi hiệu quả chiến dịch và kết nối KOC/Brand nhanh chóng trên một nền tảng thống nhất.</p>
                                    <ul>
                                        <li><i class="fa-solid fa-circle-check"></i> Đăng nhập nhanh, bảo mật cao</li>
                                        <li><i class="fa-solid fa-circle-check"></i> Theo dõi tiến độ realtime</li>
                                        <li><i class="fa-solid fa-circle-check"></i> Tối ưu hiệu quả chiến dịch</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-7 login-main">
                                <div class="login-main-content">
                                    <h2>Chào mừng quay lại</h2>
                                    <p class="text-muted mb-4">Vui lòng nhập thông tin tài khoản của bạn</p>

                                    <form method="post">
                                        <input type="hidden" asp-for="ReturnUrl" />
                                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                                        {
                                            <div class="alert alert-danger py-2">@Model.ErrorMessage@if (Model.NeedsActivation) { <div class="mt-2"><a asp-page="/Public/ActivateAccount" asp-route-email="@Model.Input.EmailOrPhone" class="alert-link"><i class="fa-solid fa-envelope-circle-check me-1"></i>Kích hoạt hoặc gửi lại mã</a></div> }</div>
                                        }

                                        <div class="mb-3">
                                            <label asp-for="Input.EmailOrPhone" class="form-label"></label>
                                            <input asp-for="Input.EmailOrPhone" class="form-control" placeholder="vd: nguyenan@email.com" />
                                            <span asp-validation-for="Input.EmailOrPhone" class="text-danger"></span>
                                        </div>
                                        <div class="mb-3">
                                            <label asp-for="Input.Password" class="form-label"></label>
                                            <input asp-for="Input.Password" type="password" class="form-control" placeholder="••••••••" />
                                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                                        </div>

                                        <div class="d-flex justify-content-between align-items-center mb-4">
                                            <div class="form-check mb-0">
                                                <input asp-for="Input.RememberMe" class="form-check-input" />
                                                <label asp-for="Input.RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                                            </div>
                                            <a asp-page="/Public/ForgotPassword" class="login-link">Quên mật khẩu?</a>
                                        </div>

                                        <button type="submit" class="btn login-submit-btn w-100">Đăng nhập</button>
                                    </form>

                                    @if (Model.GoogleLoginEnabled || Model.FacebookLoginEnabled)
                                    {
                                    <div class="social-auth-block">
                                        <p class="social-auth-title">Đăng nhập nhanh</p>
                                        <div class="social-auth-grid">
                                            @if (Model.FacebookLoginEnabled) { <form method="post" asp-page-handler="External" class="m-0">
                                                <input type="hidden" name="provider" value="Facebook" />
                                                <input type="hidden" name="mode" value="login" />
                                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                                <button type="submit" class="social-auth-btn social-auth-btn-inline w-100" aria-label="Đăng nhập với Facebook">
                                                    <img src="~/images/icon/facebook.png" alt="Facebook" />
                                                    <span>Facebook</span>
                                                </button>
                                            </form> }
                                            @if (Model.GoogleLoginEnabled) { <form method="post" asp-page-handler="External" class="m-0">
                                                <input type="hidden" name="provider" value="Google" />
                                                <input type="hidden" name="mode" value="login-or-register" />
                                                <input type="hidden" name="role" value="Koc" />
                                                <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                                                <button type="submit" class="social-auth-btn social-auth-btn-inline w-100" aria-label="Đăng nhập hoặc đăng ký với Google">
                                                    <img src="~/images/icon/google.png" alt="Google" />
                                                    <span>Tiếp tục với Google</span>
                                                </button>
                                            </form> }
                                        </div>
                                    </div>
                                    }

                                    <div class="login-divider"><span>hoặc</span></div>

                                    <div class="d-grid gap-2">
                                        <a asp-page="/Public/Register" class="btn login-secondary-btn"><i class="fa-solid fa-user-plus me-2"></i>Tạo tài khoản mới</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
