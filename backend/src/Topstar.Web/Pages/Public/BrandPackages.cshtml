@page "/goi-koc"
@model Topstar.Web.Pages.Public.BrandPackagesModel
@{ViewData["Title"]="Các gói KOC";ViewData["Description"]="Các gói dịch vụ KOC dành cho Brand.";}
@section Styles {
 <link rel="stylesheet" href="~/css/public/brand-packages.css" asp-append-version="true" />
}
<div class="brand-package-page">
 <section class="brand-package-head section-flow reveal-up"><div class="container">
  <a asp-page="/Public/BrandPublic" class="brand-package-back flow-item"><i class="fa-solid fa-arrow-left"></i> Dành cho Brand</a>
  <div class="brand-package-head-copy">
   <p class="brand-package-eyebrow flow-item"><i class="fa-solid fa-sparkles"></i> GIẢI PHÁP CHIẾN DỊCH KOC</p>
   <h1 class="flow-item">Chọn gói phù hợp.<br /><span>Triển khai hiệu quả.</span></h1>
   <p class="flow-item">Tham khảo ngân sách và số KOC, hoặc tùy chỉnh theo nhu cầu. Thanh toán khi tạo chiến dịch, không cần mua gói trước.</p>
   <div class="brand-package-assurances flow-item"><span><i class="fa-solid fa-bullhorn"></i> Ngân sách trả KOC</span><span><i class="fa-solid fa-users"></i> Giới hạn theo số KOC</span><span><i class="fa-solid fa-calendar-check"></i> Tùy chỉnh theo nhu cầu</span></div>
  </div>
 </div></section>
 <section class="brand-package-grid section-flow reveal-up"><div class="container">
  <div class="brand-package-grid-heading"><div><p>GÓI DỊCH VỤ</p><h2>Chọn cách triển khai</h2></div><span>Chọn hình thức tuyển chọn và số lượng KOC phù hợp cho chiến dịch.</span></div>
  @if(Model.Items.Count==0){<div class="brand-package-empty">Bảng giá tham khảo đang được cập nhật. Bạn vẫn có thể tùy chỉnh nhu cầu khi tạo chiến dịch.</div>}
  @if(Model.Items.Any(x=>!x.BrandSelectionEnabled)){
   <section class="package-method-section is-topstar"><header><span><i class="fa-solid fa-people-arrows"></i></span><div><small>PHƯƠNG ÁN 1</small><h3>Để Topstar tuyển chọn và phân công KOC</h3><p>Brand cung cấp brief; Topstar tìm KOC phù hợp và gửi đủ số lượng cần xác nhận.</p></div></header><div class="row g-4 align-items-stretch">@foreach(var item in Model.Items.Where(x=>!x.BrandSelectionEnabled)){<div class="col-lg-6 col-xl-4"><partial name="_BrandPackageCard" model="item" /></div>}</div></section>
  }
  @if(Model.Items.Any(x=>x.BrandSelectionEnabled)){
   <section class="package-method-section is-brand"><header><span><i class="fa-solid fa-user-check"></i></span><div><small>PHƯƠNG ÁN 2</small><h3>Brand chủ động lựa chọn KOC</h3><p>Topstar cung cấp shortlist; Brand trực tiếp chọn và xác nhận KOC tham gia.</p></div></header><div class="row g-4 align-items-stretch">@foreach(var item in Model.Items.Where(x=>x.BrandSelectionEnabled)){<div class="col-lg-6 col-xl-4"><partial name="_BrandPackageCard" model="item" /></div>}</div></section>
  }
 </div></section>
</div>
