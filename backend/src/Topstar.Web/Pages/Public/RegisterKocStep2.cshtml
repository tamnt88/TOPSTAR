@page "/dang-ky-koc/buoc-2"
@{
    ViewData["Title"] = "Đăng ký KOC - Bước 2";
}

<section class="koc-register-page py-4 py-md-5">
    <div class="container">
        <a asp-page="/Public/RegisterKocStep1" class="koc-back-link"><i class="fa-solid fa-arrow-left"></i>Quay lại</a>

        <div class="koc-register-card mt-3 mt-md-2">
            <div class="koc-register-head text-center">
                <span class="koc-register-avatar"><i class="fa-regular fa-user"></i></span>
                <h1>Đăng ký KOC</h1>
                <p>Tạo tài khoản và bắt đầu sự nghiệp KOC</p>
            </div>

            <div class="koc-stepper mb-4">
                <div class="koc-step done">
                    <span><i class="fa-solid fa-check"></i></span>
                    <small>Thông tin cơ bản</small>
                </div>
                <div class="koc-step-line active"></div>
                <div class="koc-step active">
                    <span>2</span>
                    <small>Mạng xã hội</small>
                </div>
                <div class="koc-step-line"></div>
                <div class="koc-step">
                    <span>3</span>
                    <small>Thông tin cá nhân</small>
                </div>
            </div>

            <h2 class="koc-form-title">Thông tin mạng xã hội</h2>

            <div class="koc-social-box mb-3">
                <h3>TikTok <span class="text-danger">*</span></h3>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Link TikTok</label>
                        <input class="form-control" placeholder="username hoặc link đầy đủ" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Số Followers</label>
                        <input class="form-control" placeholder="VD: 50,000" />
                    </div>
                </div>
            </div>

            <div class="koc-social-box mb-3">
                <h3>Facebook</h3>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Link Facebook</label>
                        <input class="form-control" placeholder="Link profile/page" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Số Followers</label>
                        <input class="form-control" placeholder="VD: 20,000" />
                    </div>
                </div>
            </div>

            <div class="koc-social-box mb-3">
                <h3>Instagram</h3>
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label">Link Instagram</label>
                        <input class="form-control" placeholder="Link profile Instagram" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Số Followers</label>
                        <input class="form-control" placeholder="VD: 10,000" />
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <a asp-page="/Public/RegisterKocStep1" class="btn koc-btn-outline"><i class="fa-solid fa-arrow-left"></i>Quay lại</a>
                <a asp-page="/Public/RegisterKocStep3" class="btn koc-btn-primary flex-grow-1">Tiếp tục <i class="fa-solid fa-arrow-right"></i></a>
            </div>

            <p class="koc-login-hint">Đã có tài khoản? <a asp-page="/Public/Login">Đăng nhập ngay</a></p>
        </div>
    </div>
</section>
