@page "/quen-mat-khau"
@model Topstar.Web.Pages.Public.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["Description"] = "Yêu cầu đặt lại mật khẩu tài khoản TopStar.";
    ViewData["Keywords"] = "quên mật khẩu, đặt lại mật khẩu, TopStar";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public/login-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public/auth-polish.css" asp-append-version="true" />
}

<div class="login-page login-page-theme">
    <section class="login-section section-flow reveal-up py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-9">
                    <div class="login-shell flow-item">
                        <div class="row g-0">
                            <div class="col-lg-5 login-aside">
                                <div class="login-aside-content">
                                    <p class="login-eyebrow"><i class="fa-solid fa-shield-halved"></i> Khôi phục an toàn</p>
                                    <h1>Lấy lại<br><span>tài khoản</span></h1>
                                    <p>Nhận liên kết bảo mật qua email để thiết lập mật khẩu mới cho tài khoản TopStar.</p>
                                    <ul>
                                        <li><i class="fa-solid fa-circle-check"></i> Liên kết có thời hạn</li>
                                        <li><i class="fa-solid fa-circle-check"></i> Không chia sẻ mã hoặc liên kết</li>
                                        <li><i class="fa-solid fa-circle-check"></i> Kiểm tra cả thư mục Spam</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-7 login-main">
                                <div class="login-main-content">
                                    <h2>Quên mật khẩu?</h2>
                                    <p class="text-muted mb-4">Nhập email hoặc số điện thoại đã đăng ký để nhận liên kết đặt lại mật khẩu.</p>
                                    <form method="post">
                                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                                        {
                                            <div class="alert alert-danger py-2"><i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                                        {
                                            <div class="alert alert-success py-2 mb-3"><i class="fa-solid fa-circle-check me-2"></i>@Model.SuccessMessage</div>
                                        }
                                        <div class="mb-3">
                                            <label asp-for="Input.EmailOrPhone" class="form-label">Email hoặc số điện thoại</label>
                                            <input asp-for="Input.EmailOrPhone" class="form-control" placeholder="vd: nguyenan@email.com" autocomplete="username" autofocus />
                                            <span asp-validation-for="Input.EmailOrPhone" class="text-danger"></span>
                                        </div>
                                        <button type="submit" class="btn login-submit-btn w-100"><i class="fa-regular fa-paper-plane me-2"></i>@(string.IsNullOrWhiteSpace(Model.SuccessMessage) ? "Gửi liên kết" : "Gửi lại liên kết")</button>
                                        <div class="text-center mt-3">
                                            <a asp-page="/Public/Login" class="login-link"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại đăng nhập</a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
