@page "/quen-mat-khau"
@model Topstar.Web.Pages.Public.ForgotPasswordModel
@{
    ViewData["Title"] = "Quên mật khẩu";
    ViewData["Description"] = "Yêu cầu đặt lại mật khẩu tài khoản TopStar.";
    ViewData["Keywords"] = "quên mật khẩu, đặt lại mật khẩu, TopStar";
}

<section class="login-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-shell p-4 p-md-5">
                    <h1 class="mb-2" style="font-family:'Saira Stencil',sans-serif;">Quên mật khẩu</h1>
                    <p class="text-muted mb-4">Nhập email hoặc số điện thoại để tạo liên kết đặt lại mật khẩu.</p>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                        {
                            <div class="alert alert-success py-2 mb-3">
                                @Model.SuccessMessage
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="Input.EmailOrPhone" class="form-label">Email hoặc số điện thoại</label>
                            <input asp-for="Input.EmailOrPhone" class="form-control" placeholder="email hoặc số điện thoại" />
                            <span asp-validation-for="Input.EmailOrPhone" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn login-submit-btn w-100">Tạo link đặt lại mật khẩu</button>

                        <div class="text-center mt-3">
                            <a asp-page="/Public/Login" class="login-link">Quay lại đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
