@page
@{ ViewData["Title"] = "Brand Public"; }
<div class="page-wrap card-list">
  <section class="public-light">
    <div class="d-flex justify-content-between align-items-center mb-2">
      <span class="badge-x badge-blue">Dang tin cay boi 500+ thuong hieu</span>
      <div class="d-flex gap-2">
        <a class="btn btn-sm btn-outline-primary" asp-page="/Public/RegisterKocStep1">Dang ky KOC</a>
        <button class="btn btn-sm btn-primary">Xem goi KOC</button>
      </div>
    </div>
    <h1 class="section-title">Ket noi voi hang ngan KOC trong vai phut</h1>
    <p class="text-muted">Nen tang quan ly chien dich KOC Marketing toan dien cho doanh nghiep.</p>
    <div class="d-flex gap-2 mt-2">
      <button class="btn-x btn-blue">Mua goi KOC ngay</button>
      <button class="btn-x" style="background:#fff;border:1px solid #d1d5db">Dang ky mien phi</button>
    </div>
  </section>

  <section class="card-x public-block">
    <h2 class="section-title">Tai sao chon chung toi?</h2>
    <div class="kpi-grid">
      <div class="kpi-box"><div class="fw-bold">Hang ngan KOC chat luong</div><div class="kpi-title">Data phan khuc theo nganh</div></div>
      <div class="kpi-box"><div class="fw-bold">Trien khai nhanh</div><div class="kpi-title">Tao campaign trong vai phut</div></div>
      <div class="kpi-box"><div class="fw-bold">Targeting chinh xac</div><div class="kpi-title">Goi y KOC phu hop muc tieu</div></div>
      <div class="kpi-box"><div class="fw-bold">Bao cao chi tiet</div><div class="kpi-title">Theo doi metrics theo bai dang</div></div>
    </div>
  </section>

  <section class="card-x public-block">
    <h2 class="section-title">Quy trinh lam viec don gian</h2>
    <div class="kpi-grid">
      <div class="kpi-box"><span class="badge-x badge-blue">1</span><div class="fw-bold mt-2">Chon goi KOC</div></div>
      <div class="kpi-box"><span class="badge-x badge-blue">2</span><div class="fw-bold mt-2">Tao chien dich</div></div>
      <div class="kpi-box"><span class="badge-x badge-blue">3</span><div class="fw-bold mt-2">Phan bo KOC</div></div>
      <div class="kpi-box"><span class="badge-x badge-blue">4</span><div class="fw-bold mt-2">Theo doi va hoan thanh</div></div>
    </div>
  </section>
</div>
