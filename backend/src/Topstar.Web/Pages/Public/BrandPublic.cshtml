@page "/danh-cho-brand"
@model Topstar.Web.Pages.Public.BrandPublicModel
@{
    ViewData["Title"] = "Giải pháp KOC dành cho Brand";
    ViewData["Description"] = "TopStar giúp Brand tuyển chọn KOC, ký quỹ, vận hành, duyệt nội dung và đo lường chiến dịch trên một nền tảng.";
    ViewData["Keywords"] = "KOC cho Brand, chiến dịch KOC, influencer marketing, TopStar";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public/brand-landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public/brand-landing-journey-fix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public/landing-polish.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public/brand-partners-swiper.css" asp-append-version="true" />
}

<main class="brand-landing">
    <section class="brand-landing__hero">
        <div class="brand-landing__container brand-landing__hero-grid">
            <div class="brand-landing__hero-copy">
                <p class="brand-landing__eyebrow"><i class="fa-solid fa-sparkles"></i> VẬN HÀNH CHIẾN DỊCH KOC TẬP TRUNG</p>
                <h1>Từ brief đến báo cáo,<br /><span>mọi việc ở một nơi.</span></h1>
                <p class="brand-landing__lead">TopStar giúp doanh nghiệp chọn đúng KOC, kiểm soát ngân sách và theo dõi từng đầu việc mà không phải quản lý bằng nhiều bảng tính rời rạc.</p>
                <div class="brand-landing__actions">
                    <a href="/goi-koc" class="brand-landing__button brand-landing__button--primary">Xem gói dịch vụ <i class="fa-solid fa-arrow-right"></i></a>
                    <a href="/dang-ky?tab=brand" class="brand-landing__button brand-landing__button--outline">Tạo tài khoản Brand</a>
                </div>
                <ul class="brand-landing__assurances">
                    <li><i class="fa-solid fa-circle-check"></i> Chi phí minh bạch</li>
                    <li><i class="fa-solid fa-circle-check"></i> Quy trình có audit</li>
                    <li><i class="fa-solid fa-circle-check"></i> Theo dõi theo thời gian thực</li>
                </ul>
            </div>
            <div class="brand-landing__visual" aria-label="Trung tâm điều hành chiến dịch TopStar">
                <div class="brand-landing__visual-head"><span><i class="fa-solid fa-chart-pie"></i> Trung tâm điều hành</span><strong>Đang vận hành</strong></div>
                <div class="brand-landing__visual-kpis">
                    <article><small>Tiến độ</small><b>78%</b><span class="is-purple"></span></article>
                    <article><small>KOC đã chốt</small><b>12/12</b><span class="is-green"></span></article>
                    <article><small>Nội dung đã duyệt</small><b>28</b><span class="is-gold"></span></article>
                </div>
                <div class="brand-landing__visual-flow">
                    <span class="done"><i class="fa-solid fa-check"></i> Chốt KOC</span><i class="fa-solid fa-chevron-right"></i>
                    <span class="done"><i class="fa-solid fa-check"></i> Ký quỹ</span><i class="fa-solid fa-chevron-right"></i>
                    <span class="active"><i class="fa-solid fa-play"></i> Thực hiện</span>
                </div>
                <div class="brand-landing__visual-list">
                    <div><i class="fa-solid fa-user"></i><span><b>KOC Beauty 01</b><small>Video TikTok · Chờ duyệt</small></span><em>Hôm nay</em></div>
                    <div><i class="fa-solid fa-user"></i><span><b>KOC Lifestyle 08</b><small>Reels Instagram · Đã duyệt</small></span><em>Đúng hạn</em></div>
                    <div><i class="fa-solid fa-user"></i><span><b>KOC Review 12</b><small>Bài đăng Facebook · Đang thực hiện</small></span><em>2 ngày</em></div>
                </div>
            </div>
        </div>
    </section>

    <section class="brand-landing__trust">
        <div class="brand-landing__container">
            <p>Quy trình phù hợp cho đội Marketing, Agency và doanh nghiệp đa ngành</p>
            @if (Model.Partners.Count > 0)
            {
                <div class="brand-partners__shell">
                    <div class="swiper brand-partners-swiper" data-partner-count="@Model.Partners.Count">
                        <div class="swiper-wrapper">
                            @foreach (var partner in Model.Partners)
                            {
                                <div class="swiper-slide"><a href="@partner.Url" aria-label="@partner.Name"><img src="@partner.LogoUrl" alt="@partner.Name" loading="lazy" /></a></div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="brand-landing__section">
        <div class="brand-landing__container">
            <header class="brand-landing__section-head"><p>GIẢI QUYẾT ĐÚNG ĐIỂM NGHẼN</p><h2>Không chỉ tìm KOC.<br />TopStar quản lý trọn vòng đời chiến dịch.</h2></header>
            <div class="brand-landing__benefits">
                <article><span><i class="fa-solid fa-users-viewfinder"></i></span><h3>Tuyển chọn có căn cứ</h3><p>Đối chiếu hồ sơ, tệp người theo dõi, ngành nội dung và mức độ phù hợp trước khi chốt cộng tác.</p></article>
                <article><span><i class="fa-solid fa-wallet"></i></span><h3>Ngân sách có kiểm soát</h3><p>Chốt thù lao từng KOC hoặc chia đều, ký quỹ và đối soát theo snapshot không bị sửa ngược.</p></article>
                <article><span><i class="fa-solid fa-list-check"></i></span><h3>Vận hành không thất lạc</h3><p>Booking, giao nhận, nội dung bàn giao, lịch sử trao đổi và phát sinh đều gắn với chiến dịch.</p></article>
                <article><span><i class="fa-solid fa-chart-line"></i></span><h3>Hiệu quả đo được</h3><p>Theo dõi lượt hiển thị, tương tác, chi phí và hiệu quả từng KOC trên cùng một báo cáo.</p></article>
            </div>
        </div>
    </section>

    <section class="brand-landing__section brand-landing__section--soft">
        <div class="brand-landing__container brand-landing__process">
            <header class="brand-landing__section-head brand-landing__section-head--center"><p>QUY TRÌNH RÕ RÀNG</p><h2>Bốn giai đoạn, một hành trình liền mạch.</h2><span>Brand luôn biết việc nào đã xong, việc nào đang chờ và ai cần xử lý tiếp theo.</span></header>
            <ol class="brand-landing__steps" aria-label="Quy trình triển khai chiến dịch KOC">
                <li><b>01</b><div><h3>Chọn gói và tạo brief</h3><p>Chọn quyền tuyển KOC phù hợp, khai báo mục tiêu, ngân sách và đầu việc bàn giao.</p></div></li>
                <li><b>02</b><div><h3>Chốt KOC và ký quỹ</h3><p>Duyệt danh sách cộng tác, phân bổ thù lao và hoàn tất bảo đảm ngân sách chiến dịch.</p></div></li>
                <li><b>03</b><div><h3>Thực hiện và nghiệm thu</h3><p>Theo dõi booking, giao nhận, duyệt nội dung và xử lý phát sinh ngay trong workspace.</p></div></li>
                <li><b>04</b><div><h3>Giải ngân và báo cáo</h3><p>Đối soát kết quả, giải ngân theo nghiệm thu và xem hiệu quả theo từng KOC.</p></div></li>
            </ol>
        </div>
    </section>

    <section class="brand-landing__section brand-landing__section--governance">
        <div class="brand-landing__container brand-landing__governance-layout">
            <header class="brand-landing__section-head">
                <p>MINH BẠCH TỪ ĐẦU ĐẾN CUỐI</p>
                <h2>Kiểm soát rõ từng quyết định, từng khoản chi.</h2>
                <span>Brand theo dõi được trạng thái, căn cứ xử lý và lịch sử của toàn bộ chiến dịch ngay tại một nơi.</span>
                <strong><i class="fa-solid fa-shield-halved"></i> Dữ liệu được lưu xuyên suốt để đối soát khi cần</strong>
            </header>
            <div class="brand-landing__governance">
                <article><span><i class="fa-solid fa-file-shield"></i></span><div><small>01 · KIỂM SOÁT HỒ SƠ</small><h3>Chỉ cộng tác với hồ sơ đủ điều kiện</h3><p>KOC chỉ tham gia tuyển chọn và cộng tác sau khi hoàn tất các bước xác minh cần thiết.</p></div></article>
                <article><span><i class="fa-solid fa-money-check-dollar"></i></span><div><small>02 · KIỂM SOÁT THANH TOÁN</small><h3>Thanh toán linh hoạt, đối soát rõ ràng</h3><p>Brand có thể chuyển khoản hoặc thanh toán trực tuyến; mỗi yêu cầu đều có mã theo dõi và chứng từ đi kèm.</p></div></article>
                <article><span><i class="fa-solid fa-clock-rotate-left"></i></span><div><small>03 · KIỂM SOÁT LỊCH SỬ</small><h3>Mọi thay đổi đều được ghi nhận</h3><p>Trạng thái, lý do, người thực hiện và thời gian được lưu xuyên suốt quá trình vận hành.</p></div></article>
            </div>
        </div>
    </section>

    <section class="brand-landing__cta">
        <div class="brand-landing__container"><div><p>BẮT ĐẦU CÙNG TOPSTAR</p><h2>Sẵn sàng vận hành chiến dịch KOC bài bản?</h2><span>Chọn gói phù hợp hoặc tạo tài khoản Brand để hoàn thiện hồ sơ doanh nghiệp.</span></div><div class="brand-landing__actions"><a href="/goi-koc" class="brand-landing__button brand-landing__button--light">Xem gói dịch vụ</a><a href="/dang-ky?tab=brand" class="brand-landing__button brand-landing__button--ghost">Đăng ký Brand</a></div></div>
    </section>
</main>

@section Scripts {
    <script src="~/js/public/brand-landing.js" asp-append-version="true"></script>
}
