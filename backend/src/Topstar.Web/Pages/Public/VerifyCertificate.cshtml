@page "/xac-minh-chung-nhan"
@model Topstar.Web.Pages.Public.VerifyCertificateModel
@{ViewData["Title"]="Xác minh chứng nhận Học viện KOC";ViewData["Description"]="Kiểm tra chứng nhận học tập được Topstar phát hành.";}
<section class="py-5 bg-light min-vh-100"><div class="container" style="max-width:760px">
 <div class="text-center mb-4"><i class="fa-solid fa-certificate text-primary fs-1"></i><h1 class="h2 mt-3">Xác minh chứng nhận</h1><p class="text-muted">Kết quả được đọc trực tiếp từ lịch sử hoàn thành Học viện Topstar.</p></div>
 <form method="get" class="card border-0 shadow-sm p-3 p-md-4 mb-4"><label for="code" class="form-label fw-semibold">Mã chứng nhận</label><div class="input-group"><input id="code" name="code" value="@Model.Code" minlength="10" maxlength="40" autocomplete="off" required class="form-control text-uppercase" placeholder="TS-YYYYMMDD-..."/><button class="btn btn-primary">Xác minh</button></div></form>
 @if(Model.Certificate is not null){<article class="card border-success shadow-sm"><div class="card-body p-4 p-md-5"><div class="d-flex align-items-center gap-3 mb-4"><span class="rounded-circle bg-success text-white d-inline-flex align-items-center justify-content-center" style="width:52px;height:52px"><i class="fa-solid fa-check fs-4"></i></span><div><div class="text-success fw-semibold">Chứng nhận hợp lệ</div><div class="small text-muted">@Model.Certificate.CertificateCode</div></div></div><dl class="row mb-0"><dt class="col-sm-4">Học viên</dt><dd class="col-sm-8">@Model.Certificate.KocDisplayName</dd><dt class="col-sm-4">Khóa học</dt><dd class="col-sm-8">@Model.Certificate.CourseTitle</dd><dt class="col-sm-4">Số bài bắt buộc</dt><dd class="col-sm-8">@Model.Certificate.RequiredLessonCount</dd><dt class="col-sm-4">Ngày hoàn thành</dt><dd class="col-sm-8">@Model.Certificate.CompletedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") (UTC+7)</dd></dl></div></article>}
 else if(Model.WasSearched){<div class="alert alert-danger"><strong>Không tìm thấy chứng nhận hợp lệ.</strong><div class="small mt-1">Hãy kiểm tra lại mã. Topstar không xác nhận chứng nhận chỉ bằng ảnh hoặc nội dung tự khai.</div></div>}
</div></section>
