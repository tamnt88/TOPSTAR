@page
@{ ViewData["Title"] = "Register KOC - Step 2.1"; }
<div class="page-wrap card-list">
  <h1 class="section-title">Dang ky KOC - Buoc 3/5</h1>
  <div class="card-x">
    <div class="kpi-title mb-2">Mang xa hoi</div>
    <div class="row g-3">
      <div class="col-md-6"><label class="form-label">TikTok URL</label><input class="form-control" placeholder="https://www.tiktok.com/@@yourname" /></div>
      <div class="col-md-6"><label class="form-label">Followers TikTok</label><input class="form-control" placeholder="25000" /></div>
      <div class="col-md-6"><label class="form-label">Instagram URL</label><input class="form-control" placeholder="https://www.instagram.com/yourname" /></div>
      <div class="col-md-6"><label class="form-label">Followers Instagram</label><input class="form-control" placeholder="18000" /></div>
      <div class="col-md-12"><label class="form-label">Linh vuc</label><input class="form-control" placeholder="Beauty, Lifestyle" /></div>
    </div>
    <div class="mt-3 d-flex justify-content-between"><a class="btn btn-light" asp-page="/Public/RegisterKocStep2">Quay lai</a><a class="btn-x btn-orange text-decoration-none" asp-page="/Public/RegisterKocStep22">Tiep tuc</a></div>
  </div>
</div>

