@page "/hoc-vien-koc"
@model Topstar.Web.Pages.Public.AcademyModel
@{
    var c = Model.LandingContent;
    var statIcons = new[] { "fa-route", "fa-book-open-reader", "fa-id-card" };
    ViewData["Title"] = c.HeroTitle;
    ViewData["Description"] = c.HeroDescription;
    ViewData["Keywords"] = "học viện KOC, khóa học KOC, đào tạo KOC, TopStar";
}

@section Styles {
    <link rel="stylesheet" href="/css/public/academy.css?v=20260916-dark-contrast" />
    <link rel="stylesheet" href="/css/public/landing-polish.css?v=20260916-dark-contrast" />
}

<main class="academy-page">
    <section class="academy-hero">
        <div class="container academy-hero-grid">
            <div class="academy-hero-copy">
                <p class="academy-eyebrow"><i class="fa-solid fa-graduation-cap"></i> @c.Eyebrow</p>
                <h1>@c.HeroTitle <span>@c.HeroHighlight</span></h1>
                <p class="academy-lead">@c.HeroDescription</p>
                <div class="academy-actions">
                    <a href="@c.PrimaryCtaUrl" class="academy-btn academy-btn-primary">@c.PrimaryCtaText <i class="fa-solid fa-arrow-right"></i></a>
                    <a href="@c.SecondaryCtaUrl" class="academy-btn academy-btn-outline">@c.SecondaryCtaText</a>
                </div>
                <div class="academy-proof"><i class="fa-solid fa-circle-check"></i><span>Lộ trình thực hành</span><i class="fa-solid fa-circle-check"></i><span>Hồ sơ minh bạch</span><i class="fa-solid fa-circle-check"></i><span>Cơ hội hợp tác thực tế</span></div>
            </div>
            <div class="academy-hero-visual">
                <div class="academy-image-frame"><img src="@c.HeroImageUrl" alt="@c.HeroTitle" /></div>
                <div class="academy-floating-note"><i class="fa-solid fa-star"></i><div><strong>Học để làm được</strong><span>Nội dung gắn với quy trình chiến dịch</span></div></div>
            </div>
        </div>
        <div class="container academy-stats">
            @{ var statIndex = 0; }
            @foreach (var item in c.Stats.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder))
            {
                var icon = statIcons[Math.Min(statIndex, statIcons.Length - 1)];
                <article class="academy-stat academy-stat-@((statIndex % 3) + 1)">
                    <span class="academy-stat-icon"><i class="fa-solid @icon"></i></span>
                    <span class="academy-stat-copy"><strong>@item.Value</strong><small>@item.Label</small></span>
                    <i class="fa-solid fa-arrow-trend-up academy-stat-accent" aria-hidden="true"></i>
                </article>
                statIndex++;
            }
        </div>
    </section>

    <section id="academy-courses" class="academy-block academy-course-section">
        <div class="container">
            <div class="academy-heading"><p>Chương trình đào tạo</p><h2>Các khóa học đang mở</h2><span>Chọn chương trình phù hợp với kinh nghiệm hiện tại và mục tiêu phát triển của bạn.</span></div>
            @if (Model.Courses.Count == 0)
            { <div class="academy-empty"><i class="fa-solid fa-book-open"></i><strong>Chương trình mới đang được cập nhật</strong><span>Đăng ký tài khoản để nhận thông báo khi khóa học mở.</span></div> }
            else
            {
                <div class="academy-course-grid">
                    @foreach (var course in Model.Courses)
                    {
                        <article class="academy-course-card">
                            <div class="academy-course-meta"><span>@course.Level</span><span><i class="fa-regular fa-clock"></i> @course.DurationWeeks tuần</span></div>
                            <h3>@course.Title</h3><p>@course.Summary</p>
                            @if (!string.IsNullOrWhiteSpace(course.Syllabus))
                            { <ul>@foreach (var line in course.Syllabus.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)) { <li><i class="fa-solid fa-check"></i>@line</li> }</ul> }
                        </article>
                    }
                </div>
            }
        </div>
    </section>

    <section class="academy-block academy-soft">
        <div class="container"><div class="academy-heading"><p>Lộ trình phát triển</p><h2>@c.RoadmapTitle</h2><span>@c.RoadmapDescription</span></div>
            <div class="academy-roadmap">@foreach (var item in c.Roadmap.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder)) { <article><span>@item.Stage</span><h3>@item.Title</h3><p>@item.Description</p></article> }</div>
        </div>
    </section>

    <section class="academy-block">
        <div class="container"><div class="academy-heading"><p>Năng lực cốt lõi</p><h2>@c.TrustTitle</h2><span>@c.TrustDescription</span></div>
            <div class="academy-card-grid four">@foreach (var item in c.TrustItems.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder)) { <article><i class="@item.Icon"></i><h3>@item.Title</h3><p>@item.Description</p></article> }</div>
        </div>
    </section>

    <section class="academy-block academy-dark">
        <div class="container"><div class="academy-heading"><p>Chuẩn vận hành TopStar</p><h2>@c.QualityTitle</h2><span>Mỗi hoạt động đều có quy trình, dữ liệu và lịch sử để KOC an tâm phát triển lâu dài.</span></div>
            <div class="academy-card-grid two">@foreach (var item in c.QualityItems.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder)) { <article><i class="@item.Icon"></i><div><h3>@item.Title</h3><p>@item.Description</p></div></article> }</div>
        </div>
    </section>

    <section class="academy-block">
        <div class="container"><div class="academy-heading"><p>Kết quả hướng tới</p><h2>@c.OutcomeTitle</h2><span>@c.OutcomeDescription</span></div>
            <div class="academy-card-grid two academy-outcomes">@foreach (var item in c.Outcomes.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder)) { <article><i class="@item.Icon"></i><div><h3>@item.Title</h3><p>@item.Description</p></div></article> }</div>
        </div>
    </section>

    <section class="academy-block academy-soft">
        <div class="container"><div class="academy-heading"><p>Thư viện học tập</p><h2>@c.ResourceTitle</h2><span>@c.ResourceDescription</span></div>
            <div class="academy-resources">@foreach (var item in c.Resources.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder)) { <article><i class="@item.Icon"></i><strong>@item.Title</strong></article> }</div>
        </div>
    </section>

    <section class="academy-final"><div class="container"><div><p class="academy-final-label">Bắt đầu cùng TopStar</p><h2>@c.FinalCtaTitle</h2><p>@c.FinalCtaDescription</p></div><a href="@c.FinalCtaUrl" class="academy-btn academy-btn-light">@c.FinalCtaText <i class="fa-solid fa-arrow-right"></i></a></div></section>
</main>
