@page
@{ ViewData["Title"] = "Hoc vien KOC"; }
<div class="page-wrap card-list">
  <div class="d-flex justify-content-between align-items-end">
    <div>
      <h1 class="section-title mb-0">Hoc vien KOC</h1>
      <div class="kpi-title">Hoc, Thuc hanh, Nhan viec</div>
    </div>
    <a class="btn-x btn-orange text-decoration-none" asp-page="/Public/RegisterKocStep1">Dang ky hoc vien</a>
  </div>

  <div class="kpi-grid">
    <div class="kpi-box"><div class="kpi-title">Trinh do hien tai</div><div class="kpi-value">Beginner</div></div>
    <div class="kpi-box"><div class="kpi-title">Bai hoc hoan thanh</div><div class="kpi-value">8/18</div></div>
    <div class="kpi-box"><div class="kpi-title">Chung chi</div><div class="kpi-value">0</div></div>
    <div class="kpi-box"><div class="kpi-title">Diem tich luy</div><div class="kpi-value">120</div></div>
  </div>

  <div class="card-x">
    <h2 class="h5">Khoa hoc dang tham gia</h2>
    <div class="list-row"><div><b>Content Creation Fundamentals</b><div class="kpi-title">Bai 7: Editing & Post-Production</div></div><div style="width:240px"><div class="progress-x"><span style="width:75%"></span></div></div></div>
    <div class="list-row"><div><b>Social Media Strategy & Growth</b><div class="kpi-title">Bai 5: Hashtag Strategy & Trends</div></div><div style="width:240px"><div class="progress-x"><span style="width:40%"></span></div></div></div>
  </div>

  <div class="card-x">
    <h2 class="h5">Khoa hoc co ban</h2>
    <div class="kpi-grid">
      <div class="kpi-box"><div class="fw-bold">Foundation Hieu ve KOC</div><div class="kpi-title">2 gio • 7 bai</div></div>
      <div class="kpi-box"><div class="fw-bold">Lam noi dung co ban</div><div class="kpi-title">2 gio • 8 bai</div></div>
      <div class="kpi-box"><div class="fw-bold">Quy trinh nhan job</div><div class="kpi-title">1 gio • 6 bai</div></div>
    </div>
  </div>
</div>
