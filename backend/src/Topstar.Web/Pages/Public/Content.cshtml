@page "/{**pagePath}"
@model Topstar.Web.Pages.Public.ContentModel
@{ ViewData["Title"] = Model.Item?.SeoTitle ?? Model.Item?.PageTitle; ViewData["Description"] = Model.Item?.SeoDescription ?? Model.Item?.ShortDescription; }
@section Styles { <link rel="stylesheet" href="~/lib/ckeditor5/ckeditor5.css" /> }
<article class="container py-5" style="max-width:1100px">
    <h1>@Model.Item?.PageTitle</h1>
    @if (!string.IsNullOrWhiteSpace(Model.Item?.ShortDescription)) { <p class="lead text-muted">@Model.Item.ShortDescription</p> }
    <div class="ck-content">@Html.Raw(Model.Item?.PageContent)</div>
</article>
