@page "/dat-lai-mat-khau"
@model Topstar.Web.Pages.Public.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["Description"] = "Cập nhật mật khẩu mới cho tài khoản TopStar.";
    ViewData["Keywords"] = "đặt lại mật khẩu, đổi mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public/login-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public/auth-polish.css" asp-append-version="true" />
}

<div class="login-page login-page-theme">
    <section class="login-section section-flow reveal-up py-5">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-10 col-xl-9">
                    <div class="login-shell flow-item">
                        <div class="row g-0">
                            <div class="col-lg-5 login-aside">
                                <div class="login-aside-content">
                                    <p class="login-eyebrow"><i class="fa-solid fa-lock"></i> Bảo mật tài khoản</p>
                                    <h1>Tạo mật khẩu<br><span>mới an toàn</span></h1>
                                    <p>Chọn mật khẩu mạnh và khác với mật khẩu bạn từng sử dụng trước đây.</p>
                                    <ul>
                                        <li><i class="fa-solid fa-circle-check"></i> Tối thiểu 8 ký tự</li>
                                        <li><i class="fa-solid fa-circle-check"></i> Có chữ hoa, chữ thường và số</li>
                                        <li><i class="fa-solid fa-circle-check"></i> Không chia sẻ mật khẩu</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-7 login-main">
                                <div class="login-main-content">
                                    <h2>Đặt lại mật khẩu</h2>
                                    <p class="text-muted mb-4">Nhập mật khẩu mới cho tài khoản của bạn.</p>
                                    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                                    {
                                        <div class="alert alert-success py-2 mb-3"><i class="fa-solid fa-circle-check me-2"></i>@Model.SuccessMessage</div>
                                        <a asp-page="/Public/Login" class="btn login-submit-btn w-100"><i class="fa-solid fa-right-to-bracket me-2"></i>Đăng nhập</a>
                                    }
                                    else
                                    {
                                        <form method="post">
                                            <input type="hidden" asp-for="Token" />
                                            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                                            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                                            {
                                                <div class="alert alert-danger py-2"><i class="fa-solid fa-circle-exclamation me-2"></i>@Model.ErrorMessage</div>
                                            }
                                            <div class="mb-3">
                                                <label asp-for="Input.NewPassword" class="form-label">Mật khẩu mới</label>
                                                <input asp-for="Input.NewPassword" type="password" class="form-control" autocomplete="new-password" autofocus />
                                                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                                            </div>
                                            <div class="mb-3">
                                                <label asp-for="Input.ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                                                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                                                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                                            </div>
                                            <button type="submit" class="btn login-submit-btn w-100"><i class="fa-solid fa-key me-2"></i>Đổi mật khẩu</button>
                                            <div class="text-center mt-3">
                                                <a asp-page="/Public/Login" class="login-link"><i class="fa-solid fa-arrow-left me-1"></i> Quay lại đăng nhập</a>
                                            </div>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
