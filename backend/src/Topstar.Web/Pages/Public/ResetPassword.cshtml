@page "/dat-lai-mat-khau"
@model Topstar.Web.Pages.Public.ResetPasswordModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    ViewData["Description"] = "Cập nhật mật khẩu mới cho tài khoản TopStar.";
    ViewData["Keywords"] = "đặt lại mật khẩu, đổi mật khẩu";
}

<section class="login-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="login-shell p-4 p-md-5">
                    <h1 class="mb-2" style="font-family:'Saira Stencil',sans-serif;">Đặt lại mật khẩu</h1>
                    <p class="text-muted mb-4">Nhập mật khẩu mới cho tài khoản của bạn.</p>

                    <form method="post">
                        <input type="hidden" asp-for="Token" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

                        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
                        {
                            <div class="alert alert-success py-2">@Model.SuccessMessage</div>
                        }

                        <div class="mb-3">
                            <label asp-for="Input.NewPassword" class="form-label">Mật khẩu mới</label>
                            <input asp-for="Input.NewPassword" type="password" class="form-control" />
                            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn login-submit-btn w-100">Cập nhật mật khẩu</button>

                        <div class="text-center mt-3">
                            <a asp-page="/Public/Login" class="login-link">Quay lại đăng nhập</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
