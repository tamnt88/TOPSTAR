@model IReadOnlyList<Topstar.Application.Reviews.ReceivedReviewItem>

<section class="koc-review-section koc-received-reviews" aria-label="Danh sách đánh giá nhận được">
    @if (Model.Count == 0)
    {
        <div class="koc-empty-state">
            <i class="fa-regular fa-comments"></i>
            <strong>Chưa có đánh giá từ đối tác</strong>
            <span>Đánh giá mới sẽ xuất hiện sau khi Brand hoàn tất nhận xét.</span>
        </div>
    }

    @foreach (var item in Model)
    {
        <article class="koc-received-card">
            <details class="koc-review-card-details">
                <summary>
                    <div class="koc-review-card-header">
                        <div class="koc-review-task-info">
                            <span class="koc-review-brand-icon"><i class="fa-regular fa-building"></i></span>
                            <div>
                                <h3>@item.ReviewerName</h3>
                                <p><i class="fa-solid fa-bullhorn"></i>@item.CampaignTitle</p>
                                <small><i class="fa-regular fa-calendar"></i>@item.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</small>
                            </div>
                        </div>
                        <div class="text-end">
                            <div class="koc-stars" aria-label="@item.Rating trên 5 sao">
                                @for (var star = 1; star <= 5; star++)
                                {
                                    <i class="@(star <= item.Rating ? "fa-solid" : "fa-regular") fa-star"></i>
                                }
                            </div>
                            @if (item.Status == "Hidden")
                            {
                                <span class="badge text-bg-secondary mt-1"><i class="fa-solid fa-eye-slash me-1"></i>Đã ẩn</span>
                            }
                            <span class="koc-review-card-toggle">
                                <i class="fa-regular fa-eye me-1"></i>Xem nội dung và thao tác<i class="fa-solid fa-chevron-down ms-2"></i>
                            </span>
                        </div>
                    </div>
                </summary>
                <div class="koc-review-card-body">
            @if (!string.IsNullOrWhiteSpace(item.Comment))
            {
                <blockquote class="koc-review-quote"><i class="fa-solid fa-quote-left"></i>@item.Comment</blockquote>
            }

            @if (!string.IsNullOrWhiteSpace(item.ReplyBody))
            {
                <div class="koc-review-reply">
                    <strong><i class="fa-solid fa-reply me-1"></i>Phản hồi của bạn</strong>
                    <p>@item.ReplyBody</p>
                    <small><i class="fa-regular fa-clock me-1"></i>@item.RepliedAtUtc?.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</small>
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Reply" class="koc-review-reply-form" novalidate>
                    <input type="hidden" name="id" value="@item.Id" />
                    <label class="form-label fw-semibold" for="reply-@item.Id">
                        <i class="fa-solid fa-reply me-1"></i>Phản hồi đánh giá
                    </label>
                    <textarea id="reply-@item.Id" name="body" minlength="2" maxlength="2000" rows="3"
                              class="form-control" placeholder="Cảm ơn hoặc giải thích ngắn gọn, chuyên nghiệp"></textarea>
                    <button class="btn btn-primary btn-sm mt-2">
                        <i class="fa-solid fa-paper-plane me-1"></i>Gửi phản hồi
                    </button>
                </form>
            }

            @if (!string.IsNullOrWhiteSpace(item.AppealStatus))
            {
                var (appealLabel, appealBadge, appealIcon) = item.AppealStatus switch
                {
                    "Accepted" => ("Đã chấp nhận", "text-bg-success", "fa-circle-check"),
                    "Rejected" => ("Đã từ chối", "text-bg-danger", "fa-circle-xmark"),
                    "Withdrawn" => ("Đã rút", "text-bg-secondary", "fa-ban"),
                    _ => ("Đang xem xét", "text-bg-warning", "fa-clock")
                };
                var decisionLabel = item.AppealStatus == "Withdrawn" ? "Lý do rút yêu cầu:" : "Kết luận Admin:";
                <div class="koc-review-appeal">
                    <div>
                        <strong><i class="fa-solid fa-scale-balanced me-1"></i>Yêu cầu xem xét</strong>
                        <span class="badge @appealBadge"><i class="fa-solid @appealIcon me-1"></i>@appealLabel</span>
                    </div>
                    <p>@item.AppealReason</p>
                    @if (!string.IsNullOrWhiteSpace(item.AppealDecisionNote))
                    {
                        <small><strong>@decisionLabel</strong> @item.AppealDecisionNote</small>
                    }
                </div>
                @if (item.AppealStatus == "Open")
                {
                    <div class="koc-appeal-actions">
                        <details>
                            <summary><i class="fa-solid fa-plus me-1"></i>Bổ sung thông tin</summary>
                            <form method="post" asp-page-handler="SupplementAppeal" class="mt-2" novalidate>
                                <input type="hidden" name="id" value="@item.Id" />
                                <textarea name="body" minlength="10" maxlength="2000" rows="3" class="form-control" placeholder="Thông tin hoặc bằng chứng bổ sung (10–2.000 ký tự)"></textarea>
                                <button class="btn btn-primary btn-sm mt-2"><i class="fa-solid fa-paper-plane me-1"></i>Gửi bổ sung</button>
                            </form>
                        </details>
                        <details>
                            <summary class="text-danger"><i class="fa-solid fa-ban me-1"></i>Rút yêu cầu</summary>
                            <form method="post" asp-page-handler="WithdrawAppeal" class="mt-2" novalidate>
                                <input type="hidden" name="id" value="@item.Id" />
                                <textarea name="reason" minlength="10" maxlength="500" rows="2" class="form-control" placeholder="Lý do rút yêu cầu (10–500 ký tự)"></textarea>
                                <button class="btn btn-outline-danger btn-sm mt-2"><i class="fa-solid fa-ban me-1"></i>Xác nhận rút</button>
                            </form>
                        </details>
                    </div>
                }
            }
            else if (item.Status != "Hidden")
            {
                <details class="koc-review-appeal-form">
                    <summary><i class="fa-solid fa-flag me-1"></i>Yêu cầu Admin xem xét</summary>
                    <form method="post" asp-page-handler="Appeal" class="mt-3" novalidate>
                        <input type="hidden" name="id" value="@item.Id" />
                        <label class="form-label fw-semibold" for="appeal-@item.Id">Căn cứ yêu cầu xem xét</label>
                        <textarea id="appeal-@item.Id" name="reason" minlength="10" maxlength="2000" rows="3"
                                  class="form-control" placeholder="Nêu rõ nội dung chưa chính xác và căn cứ để Admin kiểm tra"></textarea>
                        <div class="form-text">Mỗi đánh giá chỉ tạo được một yêu cầu xem xét.</div>
                        <button class="btn btn-outline-danger btn-sm mt-2">
                            <i class="fa-solid fa-shield-halved me-1"></i>Gửi đến Admin
                        </button>
                    </form>
                </details>
            }
                </div>
            </details>
        </article>
    }
</section>
