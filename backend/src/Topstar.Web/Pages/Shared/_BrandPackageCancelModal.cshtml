<div class="modal fade" id="brandPackageCancelModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content brand-action-modal">
            <form method="post" asp-page-handler="Cancel" id="brandPackageCancelForm" novalidate>
                <div class="modal-header">
                    <div class="brand-modal-title"><span class="is-danger"><i class="fa-solid fa-triangle-exclamation"></i></span><div><h2>Hủy gói dịch vụ</h2><p id="brandPackageCancelName"></p></div></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="brandPackageCancelId"/>
                    <input type="hidden" name="packageName" id="brandPackageCancelPackageName"/>
                    <div class="mt-3"><label for="brandPackageCancelReason" class="form-label">Lý do hủy <span class="text-danger">*</span></label><div class="brand-validation-field"><textarea name="reason" id="brandPackageCancelReason" class="form-control" rows="4" maxlength="500" aria-describedby="brandPackageCancelReasonError" placeholder="Nhập lý do hủy đơn (10–500 ký tự)"></textarea><i class="fa-solid fa-circle-exclamation brand-validation-icon" aria-hidden="true"></i></div><div class="invalid-feedback" id="brandPackageCancelReasonError">Vui lòng nhập lý do hủy từ 10 đến 500 ký tự.</div><div class="form-text text-end"><span id="brandPackageCancelCount">0</span>/500</div></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i> Đóng</button><button type="submit" class="btn btn-danger btn-sm" id="brandPackageCancelSubmit"><i class="fa-solid fa-ban"></i> Xác nhận yêu cầu</button></div>
            </form>
        </div>
    </div>
</div>
