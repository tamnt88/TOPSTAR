@model Topstar.Web.Pages.Admin.Finance.KocIncomeTaxModel
<div class="tax-fees-editor"><form asp-page="/Admin/Finance/TaxFees" asp-page-handler="KocTax" method="post" novalidate><input type="hidden" name="Tab" value="Koc"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="tax-koc-tax-grid"><div class="tax-form-field"><label class="form-label">Áp dụng</label><div class="form-check form-switch"><input asp-for="Enabled" class="form-check-input"/><label asp-for="Enabled">Bật khấu trừ thuế</label></div></div><div class="tax-form-field"><label asp-for="Rate" class="form-label">Thuế suất (%)</label><input asp-for="Rate" type="number" step="0.01" class="form-control"/><span asp-validation-for="Rate" class="text-danger"></span></div><div class="tax-form-field"><label asp-for="Threshold" class="form-label">Ngưỡng mỗi khoản chi trả (đ)</label><input id="kocTaxThresholdDisplay" class="form-control js-money" inputmode="numeric" data-target="Threshold" value="@Model.Threshold.ToString("N0", PortalFormat.Vietnamese)"/><input asp-for="Threshold" type="hidden" asp-format="{0:0}"/><span asp-validation-for="Threshold" class="text-danger"></span></div><div class="tax-form-field"><label asp-for="EffectiveAt" class="form-label">Hiệu lực</label><input asp-for="EffectiveAt" asp-format="{0:yyyy-MM-ddTHH:mm}" type="datetime-local" step="60" class="form-control"/><span asp-validation-for="EffectiveAt" class="text-danger"></span></div><div class="tax-inline-save"><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Lưu</button></div></div></form>
@if(Model.Policies.Count>0){<details class="mt-3"><summary>Lịch sử chính sách</summary><table class="table"><thead><tr><th>Hiệu lực</th><th>Áp dụng</th><th>Thuế suất</th><th>Ngưỡng</th></tr></thead><tbody>@foreach(var p in Model.Policies){<tr><td>@p.EffectiveAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(p.IsEnabled?"Bật":"Tắt")</td><td>@p.Rate%</td><td>@PortalFormat.Money(p.Threshold)</td></tr>}</tbody></table></details>}</div>
