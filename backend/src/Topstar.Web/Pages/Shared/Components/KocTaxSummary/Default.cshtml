@model Topstar.Web.Services.Payments.KocTaxDisplay
<div class="tax-income-summary border rounded-3 p-3 my-3" style="background:var(--bs-light,#f8f9fa)"><div class="d-flex justify-content-between gap-2 flex-wrap small mb-2"><strong><i class="fa-solid fa-calculator"></i> @(Model.Final?"Thù lao đã chốt":"Thù lao dự kiến")</strong><span class="text-muted">@Model.Label</span></div><div class="d-flex flex-wrap gap-4"><div><small class="text-muted d-block">Trước thuế</small><strong class="text-nowrap">@PortalFormat.Money(Model.Gross)</strong></div><div><small class="text-muted d-block">Phí nền tảng KOC</small><strong class="text-nowrap">@PortalFormat.Money(Model.PlatformFee)</strong></div><div><small class="text-muted d-block">Thuế @(Model.Final?"khấu trừ":"dự kiến")</small><strong class="text-nowrap">@(Model.Tax.HasValue?PortalFormat.Money(Model.Tax.Value):"Chờ xác định")</strong></div><div><small class="text-muted d-block">Thực nhận @(Model.Final?"":"dự kiến")</small><strong class="text-nowrap">@(Model.Net.HasValue?PortalFormat.Money(Model.Net.Value):"Chờ xác định")</strong></div></div></div>
