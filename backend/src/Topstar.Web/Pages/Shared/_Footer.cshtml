@using Topstar.Application.Website
@inject IWebsiteContentService WebsiteContentService
@{
    var website = await WebsiteContentService.GetWebsiteContentAsync(Context?.RequestAborted ?? default);
    var websiteName = website?.WebsiteName ?? "TopStar";
    var contactEmail = string.IsNullOrWhiteSpace(website?.ContactEmail) ? "info@topstar.vn" : website!.ContactEmail!;
    var hotline = string.IsNullOrWhiteSpace(website?.Hotline) ? "08 3333 1004" : website!.Hotline!;
    var domain = string.IsNullOrWhiteSpace(website?.Domain) ? "www.topstar.vn" : website!.Domain!;
    var address = string.IsNullOrWhiteSpace(website?.Address) ? "Việt Nam" : website!.Address!;
    var logoUrl = string.IsNullOrWhiteSpace(website?.LogoUrl) ? "/images/logo.png" : website!.LogoUrl!;
    var copyright = string.IsNullOrWhiteSpace(website?.CopyrightText)
        ? $"© {DateTime.UtcNow.Year} {websiteName}. Bảo lưu mọi quyền."
        : website!.CopyrightText!;
    var domainUrl = domain.StartsWith("http://", StringComparison.OrdinalIgnoreCase) || domain.StartsWith("https://", StringComparison.OrdinalIgnoreCase)
        ? domain
        : $"https://{domain.TrimStart('/')}";
    var phoneUrl = hotline.Replace(" ", string.Empty).Replace(".", string.Empty).Replace("-", string.Empty);
}


<footer class="topstar-public-footer" aria-label="Thông tin TopStar">
    <div class="container">
        <div class="topstar-public-footer__grid">
            <section class="topstar-public-footer__brand" aria-labelledby="footer-brand-name">
                <a class="topstar-public-footer__logo" href="/" aria-label="Về trang chủ @websiteName">
                    <img src="@logoUrl" alt="@websiteName" />
                </a>
                <h2 id="footer-brand-name">Kết nối đúng người.<br />Tạo chiến dịch hiệu quả.</h2>
                <p>Nền tảng quản trị chiến dịch KOC/KOL toàn diện dành cho Brand và nhà sáng tạo nội dung.</p>
                <div class="topstar-public-footer__actions">
                    <a class="topstar-public-footer__primary" href="/danh-cho-brand">
                        Dành cho Brand <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <a class="topstar-public-footer__secondary" href="/dang-ky?tab=koc">Trở thành KOC</a>
                </div>
            </section>

            <nav class="topstar-public-footer__column" aria-label="Khám phá">
                <h3>Khám phá</h3>
                <a href="/"><i class="fa-solid fa-house" aria-hidden="true"></i>Trang chủ</a>
                <a href="/hoc-vien-koc"><i class="fa-solid fa-graduation-cap" aria-hidden="true"></i>Học viện KOC</a>
                <a href="/danh-cho-brand"><i class="fa-solid fa-briefcase" aria-hidden="true"></i>Dành cho Brand</a>
                <a href="/goi-koc"><i class="fa-solid fa-box-open" aria-hidden="true"></i>Gói dịch vụ KOC</a>
            </nav>

            <nav class="topstar-public-footer__column" aria-label="Tài khoản">
                <h3>Tài khoản</h3>
                <a href="/dang-ky?tab=koc"><i class="fa-solid fa-users" aria-hidden="true"></i>Đăng ký KOC/KOL</a>
                <a href="/dang-ky?tab=brand"><i class="fa-solid fa-building" aria-hidden="true"></i>Đăng ký Brand</a>
                <a href="/dang-nhap"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>Đăng nhập</a>
            </nav>

            <section class="topstar-public-footer__column topstar-public-footer__contact" aria-labelledby="footer-contact-title">
                <h3 id="footer-contact-title">Liên hệ</h3>
                <a href="tel:@phoneUrl">
                    <span class="topstar-public-footer__contact-icon"><i class="fa-solid fa-phone" aria-hidden="true"></i></span>
                    <span><small>Hotline</small><strong>@hotline</strong></span>
                </a>
                <a href="mailto:@contactEmail">
                    <span class="topstar-public-footer__contact-icon"><i class="fa-solid fa-envelope" aria-hidden="true"></i></span>
                    <span><small>Email</small><strong>@contactEmail</strong></span>
                </a>
                <a href="@domainUrl" target="_blank" rel="noopener noreferrer">
                    <span class="topstar-public-footer__contact-icon"><i class="fa-solid fa-globe" aria-hidden="true"></i></span>
                    <span><small>Website</small><strong>@domain</strong></span>
                </a>
                <div class="topstar-public-footer__address">
                    <span class="topstar-public-footer__contact-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
                    <span><small>Địa chỉ</small><strong>@address</strong></span>
                </div>
            </section>
        </div>

        <div class="topstar-public-footer__bottom">
            <span>@copyright</span>
            <span class="topstar-public-footer__commitment"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i>Minh bạch · An toàn · Đồng hành</span>
        </div>
    </div>
</footer>
