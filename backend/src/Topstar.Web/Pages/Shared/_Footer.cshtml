@using Topstar.Application.Website
@inject IWebsiteContentService WebsiteContentService
@{
    var website = await WebsiteContentService.GetWebsiteContentAsync(Context?.RequestAborted ?? default);
    var websiteName = website?.WebsiteName ?? "TopStar";
    var logoPath = string.IsNullOrWhiteSpace(website?.LogoUrl) ? "/images/logo.png" : website!.LogoUrl!;
    var contactEmail = string.IsNullOrWhiteSpace(website?.ContactEmail) ? "hello@topstar.vn" : website!.ContactEmail!;
    var hotline = string.IsNullOrWhiteSpace(website?.Hotline) ? "+84 (0) 28 1234 5678" : website!.Hotline!;
    var address = string.IsNullOrWhiteSpace(website?.Address) ? "TP. Hồ Chí Minh, Việt Nam" : website!.Address!;
    var domain = string.IsNullOrWhiteSpace(website?.Domain) ? "#" : website!.Domain!;
    var copyrightText = string.IsNullOrWhiteSpace(website?.CopyrightText)
        ? $"© {DateTime.UtcNow.Year} {websiteName}. Tất cả quyền được bảo lưu."
        : website!.CopyrightText!;
}
<footer class="site-footer">
    <div class="container py-5">
        <div class="row g-4 align-items-start">
            <div class="col-lg-3 col-md-6">
                <a asp-page="/Index" class="site-footer-brand text-decoration-none">
                    <img src="@logoPath" alt="@websiteName" class="site-footer-logo" />
                </a>
                <p class="site-footer-desc">
                    Nền tảng kết nối KOC, KOL và thương hiệu lớn. Chúng tôi giúp triển khai chiến dịch
                    chuyên nghiệp, minh bạch và tăng trưởng bền vững.
                </p>
                <div class="site-footer-social d-flex gap-2">
                    <a href="#" class="social-btn" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                    <a href="#" class="social-btn" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="social-btn" aria-label="X"><i class="fa-brands fa-x-twitter"></i></a>
                    <a href="#" class="social-btn" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                </div>
            </div>

            <div class="col-lg-2 col-md-6">
                <h6 class="site-footer-title">Dịch vụ</h6>
                <ul class="list-unstyled site-footer-list mb-0">
                    <li>Chiến dịch KOC</li>
                    <li>Chiến dịch KOL</li>
                    <li>Đào tạo Creator</li>
                    <li>Báo cáo hiệu suất</li>
                </ul>
            </div>

            <div class="col-lg-2 col-md-6">
                <h6 class="site-footer-title">Công ty</h6>
                <ul class="list-unstyled site-footer-list mb-0">
                    <li>Về chúng tôi</li>
                    <li>Tin tức & Blog</li>
                    <li>Dự án nổi bật</li>
                    <li>Liên hệ</li>
                </ul>
            </div>

            <div class="col-lg-3 col-md-6">
                <h6 class="site-footer-title">Liên hệ</h6>
                <ul class="list-unstyled site-footer-list mb-0">
                    <li>@contactEmail</li>
                    <li>@hotline</li>
                    <li>@address</li>
                    <li>@domain</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="site-footer-bottom">
        <div class="container text-center py-3">
            @copyrightText
        </div>
    </div>
</footer>

