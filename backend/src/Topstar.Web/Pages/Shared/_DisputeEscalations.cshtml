@model Topstar.Application.Operations.OperationsAdminDashboard
<section class="mb-5 ops-work-panel">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3"><div><h2 class="h4 mb-1">Tranh chấp quá SLA</h2><p class="small text-muted mb-0">Không có hoạt động từ 24 giờ; Critical từ 48 giờ.</p>@if(Model.DisputeScanRuns.Count>0){var last=Model.DisputeScanRuns[0];<div class="small mt-1">Quét gần nhất <strong>@last.CompletedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</strong> bởi @last.ActorLabel · thấy @last.DetectedCount, tạo @last.CreatedCount, đóng @last.ResolvedCount</div>}else{<div class="small text-warning mt-1">Chưa có lịch sử quét SLA tranh chấp.</div>}</div><form method="post" asp-page-handler="ScanDisputes"><button class="btn btn-outline-danger">Quét SLA tranh chấp</button></form></div>
    @if(Model.DisputeEscalations.Count==0){<div class="card-x text-center py-4 text-muted">Không có tranh chấp quá SLA đang mở.</div>}
    <div class="row g-3">@foreach(var item in Model.DisputeEscalations){<div class="col-12 col-xl-6"><article class="card-x h-100 @(item.Severity=="Critical"?"border-danger":"border-warning")"><div class="d-flex justify-content-between gap-2"><div><div class="small text-muted">@item.Category · @item.Priority</div><h3 class="h5 mb-1">@item.Subject</h3><div class="small">Dispute: @item.DisputeStatus · escalation: @item.EscalationStatus</div></div><span class="badge @(item.Severity=="Critical"?"bg-danger":"bg-warning text-dark") align-self-start">@item.Severity</span></div><div class="d-flex flex-wrap gap-2 mt-3"><a asp-page="/Admin/DisputeDetail" asp-route-id="@item.DisputeCaseId" class="btn btn-primary">Mở hồ sơ</a>@if(item.EscalationStatus=="Open"){<form method="post" asp-page-handler="Acknowledge" class="input-group flex-grow-1"><input type="hidden" name="id" value="@item.EscalationId"/><input name="note" minlength="5" maxlength="1000" required class="form-control" placeholder="Hướng xử lý"/><button class="btn btn-outline-primary">Tiếp nhận</button></form>}</div><div class="small text-muted mt-2">Phát hiện @item.FirstDetectedAtUtc.ToVietnamTime().ToString("dd/MM HH:mm") · quét gần nhất @item.LastDetectedAtUtc.ToVietnamTime().ToString("dd/MM HH:mm")</div>@if(item.History.Count>0){<details class="mt-3"><summary class="small text-primary">Timeline SLA (@item.History.Count)</summary><div class="border-start ps-3 mt-2">@foreach(var h in item.History){<div class="small mb-2">@(h.FromStatus??"Khởi tạo") → <strong>@h.ToStatus</strong> · @h.CreatedAtUtc.ToVietnamTime().ToString("dd/MM HH:mm")<div class="text-muted">@h.ActorLabel · @h.Note</div></div>}</div></details>}</article></div>}</div>
</section>
