@model Topstar.Application.Disputes.DisputePortal
@using Topstar.Application.Disputes
<div class="card-x mb-4"><button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#open-dispute">Mở tranh chấp mới</button><div class="collapse mt-3" id="open-dispute"><form method="post" asp-page-handler="Open" class="row g-3"><div class="col-md-6"><label class="form-label">Chiến dịch / đối tác</label><select name="participationId" class="form-select" required><option value="">Chọn lượt tham gia</option>@foreach(var c in Model.Candidates){<option value="@c.ParticipationId">@c.CampaignTitle · @c.CounterpartyName</option>}</select></div><div class="col-md-6"><label class="form-label">Loại vấn đề</label><select name="category" class="form-select" required>@foreach(var c in DisputeCategories.All){<option value="@c">@c</option>}</select></div><div class="col-12"><label class="form-label">Tiêu đề</label><input name="subject" minlength="5" maxlength="200" class="form-control" required/></div><div class="col-12"><label class="form-label">Mô tả và mong muốn xử lý</label><textarea name="description" minlength="10" maxlength="2000" rows="4" class="form-control" required></textarea></div><div class="col-12"><button class="btn btn-danger">Gửi tranh chấp cho Admin</button></div></form></div></div>
@if(Model.Cases.Count==0){<div class="card-x text-center py-5 text-muted">Chưa có tranh chấp nào.</div>}@{var detailPage=ViewData["DisputeDetailPage"] as string;}@foreach(var item in Model.Cases){var badge=DisputeTransitions.IsActive(item.Status)?"bg-warning text-dark":item.Status==DisputeStatuses.Resolved?"bg-success":"bg-secondary";<article class="card-x mb-3"><div class="d-flex flex-column flex-sm-row justify-content-between gap-2"><div><div class="small text-muted">@item.CampaignTitle · @item.Category</div><h2 class="h5 mb-1">@item.Subject</h2><div class="small">@item.BrandName ↔ @item.KocName</div></div><span class="badge @badge align-self-start">@item.Status</span></div><p class="mt-3 mb-2">@item.Description</p>@if(!string.IsNullOrWhiteSpace(item.ResolutionNote)){<div class="alert alert-success py-2"><strong>Kết luận:</strong> @item.ResolutionNote</div>}<a asp-page="@detailPage" asp-route-id="@item.Id" class="btn btn-outline-primary w-100 mt-2">Mở hồ sơ & trao đổi</a>@if(DisputeTransitions.CanCancel(item.Status)){<details class="mt-2"><summary class="small text-danger">Hủy yêu cầu</summary><form method="post" asp-page-handler="Cancel" class="input-group mt-2"><input type="hidden" name="id" value="@item.Id"/><input name="reason" maxlength="1000" class="form-control" placeholder="Lý do" required/><button class="btn btn-outline-danger">Hủy</button></form></details>}@if(item.History.Count>0){<details class="mt-2"><summary class="small text-primary">Xem timeline xử lý</summary><div class="border-start ps-3 mt-2">@foreach(var h in item.History){<div class="small mb-2">@h.FromStatus → <strong>@h.ToStatus</strong> · @h.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")@if(!string.IsNullOrWhiteSpace(h.Note)){<div class="text-muted">@h.Note</div>}</div>}</div></details>}</article>}
