@using System.Security.Claims
@using Topstar.Application.Website
@using Topstar.Application.Operations
@using Topstar.Application.Notifications
@inject IWebsiteContentService WebsiteContentService
@inject IOperationsAdminService OperationsAdminService
@inject INotificationInboxService NotificationInboxService
@{
    var path = ViewData["AdminActivePath"] as string ?? Context?.Request?.Path.Value ?? string.Empty;
    var lowerPath = path.ToLowerInvariant();
    var isPackagePolicyPath = lowerPath.StartsWith("/admin/settings/packagepolic", StringComparison.OrdinalIgnoreCase);
    var website = await WebsiteContentService.GetWebsiteContentAsync(Context?.RequestAborted ?? default);
    var websiteName = website?.WebsiteName ?? "TopStar";
    var logoPath = string.IsNullOrWhiteSpace(website?.LogoUrl) ? "/images/logo.png" : website!.LogoUrl!;

    var userDisplay = User?.Identity?.Name
        ?? User?.Claims?.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
        ?? "Admin";
    var parts = userDisplay.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = parts.Length switch
    {
        0 => "AD",
        1 => parts[0][..1].ToUpperInvariant(),
        _ => string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant()
    };

    var queueCount = await OperationsAdminService.GetQueueCountAsync(Context?.RequestAborted ?? default);
    var adminUserIdRaw = User?.Claims?.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
    var unreadNotifications = Guid.TryParse(adminUserIdRaw, out var adminUserId)
        ? await NotificationInboxService.GetUnreadCountAsync(adminUserId, "ADMIN", Context?.RequestAborted ?? default)
        : 0;

    bool IsActive(params string[] prefixes) => prefixes.Any(prefix => lowerPath.StartsWith(prefix, StringComparison.OrdinalIgnoreCase));
}

<header class="admin-layout-header">
    <div class="admin-appbar">
    <div class="admin-appbar-inner">
        <a class="admin-header-logo" asp-page="/Index" aria-label="@websiteName">
            <img src="@logoPath" alt="@websiteName" />
        </a>
        <button type="button" class="admin-nav-mobile-toggle" aria-expanded="false" aria-controls="admin-primary-nav">
            <i class="fa-solid fa-bars"></i><span>Menu quản trị</span><i class="fa-solid fa-chevron-down ms-auto"></i>
        </button>
        <nav id="admin-primary-nav" class="ts-tabs admin-dashboard-tabs admin-tabs-dynamic" aria-label="Điều hướng quản trị">
            <a class="admin-tab-link @(IsActive("/admin/dashboard") ? "active" : "")" asp-page="/Admin/Dashboard"><i class="fa-solid fa-chart-pie"></i><span>Tổng quan</span></a>
            <a class="admin-tab-link @(IsActive("/admin/operations", "/admin/dispute", "/admin/profiles", "/admin/profilereview", "/admin/reviewmoderation", "/admin/violations") ? "active" : "")" asp-page="/Admin/Operations">
                <i class="fa-solid fa-list-check"></i><span>Công việc</span>
                @if (queueCount.Total > 0)
                {
                    <span class="admin-nav-count @(queueCount.Critical > 0 ? "is-critical" : string.Empty)" title="@queueCount.Open chưa tiếp nhận, @queueCount.Critical Critical">@(queueCount.Total > 99 ? "99+" : queueCount.Total)</span>
                }
            </a>
            <a class="admin-tab-link @(IsActive("/admin/accounts/brand") ? "active" : "")" asp-page="/Admin/Brands" asp-route-Type="Brand"><i class="fa-regular fa-building"></i><span>Brand</span></a>
            <a class="admin-tab-link @(IsActive("/admin/accounts/koc") ? "active" : "")" asp-page="/Admin/Brands" asp-route-Type="KOC"><i class="fa-solid fa-users"></i><span>KOC</span></a>
            <a class="admin-tab-link @(IsActive("/admin/campaign", "/admin/matching", "/admin/collaborations", "/admin/calendar") ? "active" : "")" asp-page="/Admin/Campaigns"><i class="fa-solid fa-bullhorn"></i><span>Chiến dịch</span></a>
            <a class="admin-tab-link @(IsActive("/admin/finance") || isPackagePolicyPath ? "active" : "")" asp-page="/Admin/Finance/Index"><i class="fa-solid fa-wallet"></i><span>Tài chính</span></a>
            <a class="admin-tab-link @(!isPackagePolicyPath && IsActive("/admin/management", "/admin/myaccount", "/admin/settings", "/admin/reports", "/admin/auditlogs", "/admin/academy") ? "active" : "")" asp-page="/Admin/Management"><i class="fa-solid fa-sliders"></i><span>Quản trị</span></a>
        </nav>
        <div class="admin-header-actions">
            <a asp-page="/Admin/Notifications" class="admin-notification-link @(IsActive("/admin/notifications") ? "active" : "")" aria-label="Thông báo, @unreadNotifications chưa đọc" title="Thông báo">
                <i class="fa-regular fa-bell"></i>
                @if (unreadNotifications > 0) { <b>@(unreadNotifications > 99 ? "99+" : unreadNotifications)</b> }
            </a>
            <div class="admin-dashboard-userbar">
                <div class="admin-user-chip"><span>@initials</span> @userDisplay</div>
                <a class="admin-logout-link" asp-page="/Public/Logout"><i class="fa-solid fa-right-from-bracket"></i> Đăng xuất</a>
            </div>
        </div>
    </div>
    </div>
</header>
