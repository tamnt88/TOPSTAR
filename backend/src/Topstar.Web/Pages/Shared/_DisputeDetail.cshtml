@model Topstar.Application.Disputes.DisputeCaseDetail
@using Topstar.Application.Disputes
@{var isAdmin=(ViewData["DisputeRole"] as string)=="ADMIN";var backPage=ViewData["DisputeBackPage"] as string;var c=Model.Case;}
<div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-4"><div><div class="small text-muted">@c.CampaignTitle · @c.Category</div><h1 class="section-title mb-1">@c.Subject</h1><div>@c.BrandName ↔ @c.KocName</div></div><a asp-page="@backPage" class="btn btn-outline-secondary align-self-start">Quay lại danh sách</a></div>
<div class="card-x mb-4"><div class="d-flex justify-content-between"><strong>Nội dung ban đầu</strong><span class="badge @(DisputeTransitions.IsActive(c.Status)?"bg-warning text-dark":"bg-secondary")">@c.Status</span></div><p class="mb-0 mt-2">@c.Description</p>@if(!string.IsNullOrWhiteSpace(c.ResolutionNote)){<div class="alert alert-success mt-3 mb-0"><strong>Kết luận:</strong> @c.ResolutionNote</div>}</div>
@if(isAdmin&&Model.CanReply&&c.CampaignStatus=="InProgress"){<details class="card-x border-danger mb-4"><summary class="fw-semibold text-danger">Can thiệp: hủy toàn bộ campaign</summary><div class="alert alert-warning py-2 mt-3">Hành động này hủy participation và booking, đồng thời tạm giữ earning chưa payout. Shipment đang giao phải xử lý riêng.</div><form method="post" asp-page-handler="CancelCampaign"><textarea name="reason" minlength="10" maxlength="900" rows="3" class="form-control" placeholder="Căn cứ và lý do hủy campaign" required></textarea><button class="btn btn-danger mt-2" onclick="return confirm('Hủy campaign là hành động không thể hoàn tác. Tiếp tục?')">Xác nhận hủy campaign</button></form></details>}
@if(isAdmin&&Model.OnHoldTransactionCount>0){<details class="card-x border-warning mb-4"><summary class="fw-semibold">Tài chính đang tạm giữ · @Model.OnHoldTransactionCount khoản · @Model.OnHoldAmount.ToString("N0", PortalFormat.Vietnamese) ₫</summary>@if(c.Status is "Resolved" or "Rejected"){<form method="post" asp-page-handler="ReleaseEarnings" class="mt-3"><textarea name="reason" minlength="10" maxlength="900" rows="2" class="form-control" placeholder="Căn cứ giải phóng earning" required></textarea><button class="btn btn-success mt-2" onclick="return confirm('Chuyển toàn bộ earning do case này giữ về Available?')">Giải phóng earning</button></form>}else{<div class="alert alert-warning py-2 mt-3 mb-0">Chỉ được giải phóng sau khi dispute có kết quả Resolved hoặc Rejected.</div>}</details>}
<div class="card-x mb-4"><h2 class="h5 mb-3">Trao đổi & bằng chứng</h2>@if(Model.Messages.Count==0){<div class="text-muted mb-3">Chưa có phản hồi bổ sung.</div>}<div class="d-flex flex-column gap-3">@foreach(var m in Model.Messages){var internalNote=m.Visibility=="AdminOnly";<div class="p-3 rounded @(internalNote?"border border-warning bg-light":"border")"><div class="d-flex justify-content-between gap-2"><div><strong>@m.AuthorName</strong> <span class="badge bg-light text-dark border">@m.AuthorRole</span>@if(internalNote){<span class="badge bg-warning text-dark ms-1">Nội bộ Admin</span>}</div><span class="small text-muted">@m.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</span></div><div class="mt-2" style="white-space:pre-wrap">@m.Body</div>@if(!string.IsNullOrWhiteSpace(m.EvidenceUrl)){<a href="@m.EvidenceUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary mt-2">Mở bằng chứng ↗</a>}</div>}</div></div>
@if(Model.CanReply){<form method="post" asp-page-handler="Message" class="card-x"><h2 class="h5">Thêm phản hồi</h2><textarea name="body" minlength="2" maxlength="2000" rows="4" class="form-control" placeholder="Nội dung xác minh, phản hồi hoặc thông tin bổ sung" required></textarea><input name="evidenceUrl" type="url" maxlength="1000" class="form-control mt-2" placeholder="Link bằng chứng http/https (không bắt buộc)"/>@if(isAdmin){<div class="form-check mt-2"><input class="form-check-input" type="checkbox" name="adminOnly" value="true" id="adminOnly"><label class="form-check-label" for="adminOnly">Ghi chú nội bộ, không hiển thị cho Brand/KOC</label></div>}<button class="btn btn-primary mt-3">Lưu phản hồi</button></form>}else{<div class="alert alert-secondary">Case đã đóng. Trao đổi được giữ ở chế độ chỉ đọc.</div>}
<details class="card-x mt-4"><summary class="fw-semibold">Timeline trạng thái</summary><div class="border-start ps-3 mt-3">@foreach(var h in c.History){<div class="small mb-2">@h.FromStatus → <strong>@h.ToStatus</strong> · @h.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")@if(!string.IsNullOrWhiteSpace(h.Note)){<div class="text-muted">@h.Note</div>}</div>}</div></details>
