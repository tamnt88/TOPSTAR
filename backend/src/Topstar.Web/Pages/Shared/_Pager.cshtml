@model Topstar.Web.Features.Common.Paging.PagerViewModel
@{
    var startPage = Math.Max(1, Model.PageIndex - 2);
    var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);

    Dictionary<string, string?> Routes(int target) {
        var values = new Dictionary<string, string?>(Model.RouteValues, StringComparer.OrdinalIgnoreCase);
        values["pageIndex"] = Math.Clamp(target, 1, Math.Max(1, Model.TotalPages)).ToString();
        values["pageSize"] = Model.PageSize.ToString();
        return values;
    }
}
<div class="menu-pagination">
    <div class="text-muted">Tổng: @Model.TotalItems bản ghi • Trang @Model.PageIndex/@Model.TotalPages</div>
    <div class="menu-pagination-right">


        <ul class="menu-pager mb-0" aria-label="Phân trang danh sách">
            <li class="@(Model.PageIndex <= 1 ? "disabled" : "")"><a asp-page="@Model.PageName" asp-all-route-data="@Routes(1)" aria-label="Trang đầu" title="Trang đầu">«</a></li>
            <li class="@(Model.PageIndex <= 1 ? "disabled" : "")"><a asp-page="@Model.PageName" asp-all-route-data="@Routes(Model.PageIndex - 1)" aria-label="Trang trước" title="Trang trước">‹</a></li>
            @for (var p = startPage; p <= endPage; p++)
            {
                <li class="@(p == Model.PageIndex ? "active" : "")"><a asp-page="@Model.PageName" asp-all-route-data="@Routes(p)">@p</a></li>
            }
            <li class="@(Model.PageIndex >= Model.TotalPages ? "disabled" : "")"><a asp-page="@Model.PageName" asp-all-route-data="@Routes(Model.PageIndex + 1)" aria-label="Trang sau" title="Trang sau">›</a></li>
            <li class="@(Model.PageIndex >= Model.TotalPages ? "disabled" : "")"><a asp-page="@Model.PageName" asp-all-route-data="@Routes(Model.TotalPages)" aria-label="Trang cuối" title="Trang cuối">»</a></li>
        </ul>
    </div>
</div>
