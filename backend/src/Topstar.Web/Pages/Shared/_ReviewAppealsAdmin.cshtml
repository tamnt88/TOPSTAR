@model IReadOnlyList<Topstar.Application.Reviews.AdminReviewAppealItem>
<section class="mb-4" aria-labelledby="appeals-title">
  <div class="d-flex justify-content-between align-items-center mb-3"><div><h2 id="appeals-title" class="h4 mb-1">Khiếu nại review</h2><p class="small text-muted mb-0">Chấp nhận sẽ ẩn review; từ chối giữ nguyên trạng thái hiện tại.</p></div><span class="badge bg-danger">@Model.Count(x => x.Status == "Open") chờ xử lý</span></div>
  @if (Model.Count == 0) { <div class="alert alert-light border">Chưa có hồ sơ khiếu nại.</div> }
  @foreach (var item in Model) {
    var badge = item.Status == "Accepted" ? "bg-success" : item.Status == "Rejected" ? "bg-danger" : "bg-warning text-dark";
    <article class="card-x mb-3"><div class="d-flex flex-column flex-xl-row justify-content-between gap-3"><div class="flex-grow-1"><div class="d-flex flex-wrap gap-2"><h3 class="h5 mb-0">@item.CampaignTitle</h3><span class="badge @badge">@item.Status</span></div><div class="small text-muted mt-1">Người khiếu nại: @item.AppellantEmail · người đánh giá: @item.ReviewerEmail</div><div class="text-warning mt-2">@string.Concat(Enumerable.Repeat("★", item.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - item.Rating))</div>@if (!string.IsNullOrWhiteSpace(item.Comment)) { <div class="mt-2"><strong>Review:</strong> @item.Comment</div> }<div class="alert alert-warning py-2 mt-2 mb-0"><strong>Căn cứ:</strong> @item.Reason</div>@if (!string.IsNullOrWhiteSpace(item.DecisionNote)) { <div class="small mt-2"><strong>Kết luận:</strong> @item.DecisionNote</div> }@if (item.History.Count > 0) { <details class="mt-2"><summary class="small text-primary">Timeline hồ sơ</summary><div class="border-start ps-3 mt-2">@foreach (var e in item.History) { <div class="small mb-2"><strong>@e.ToStatus</strong> · @e.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")<div class="text-muted">@e.Note</div></div> }</div></details> }</div>
      @if (item.Status == "Open") { <div class="w-100" style="max-width:520px"><form method="post" asp-page-handler="ResolveAppeal"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="targetStatus" value="Accepted" /><label class="form-label">Kết luận chấp nhận</label><textarea name="decisionNote" minlength="10" maxlength="2000" required rows="2" class="form-control"></textarea><button class="btn btn-success mt-2" onclick="return confirm('Chấp nhận sẽ ẩn review. Tiếp tục?')">Chấp nhận và ẩn</button></form><hr><form method="post" asp-page-handler="ResolveAppeal"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="targetStatus" value="Rejected" /><label class="form-label">Kết luận từ chối</label><textarea name="decisionNote" minlength="10" maxlength="2000" required rows="2" class="form-control"></textarea><button class="btn btn-outline-danger mt-2">Từ chối</button></form></div> }
    </div></article>
  }
</section>
