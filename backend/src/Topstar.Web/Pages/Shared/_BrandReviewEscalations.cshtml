@model Topstar.Application.Operations.OperationsAdminDashboard
<section class="mb-5 ops-work-panel" aria-labelledby="brand-review-sla-title">
 <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-3"><div><h2 id="brand-review-sla-title" class="h4 mb-1">Brand chậm duyệt bài</h2><p class="small text-muted mb-0">Bài đã được KOC nộp nhưng chưa có quyết định của Brand trong ngưỡng SLA.</p></div><form method="post" asp-page-handler="ScanBrandReviews"><button class="btn btn-outline-primary">Quét bài chờ duyệt</button></form></div>
 @if(Model.BrandReviewScanRuns.Count>0){var run=Model.BrandReviewScanRuns[0];<div class="alert alert-light border py-2 small">Lần quét gần nhất @run.CompletedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm") · @run.ActorLabel · phát hiện @run.DetectedCount · tạo @run.CreatedCount · đóng @run.ResolvedCount · critical @run.CriticalCount</div>}else{<div class="alert alert-warning py-2">Chưa có lịch sử quét Brand review SLA.</div>}
 @if(Model.BrandReviewEscalations.Count==0){<div class="card-x text-center py-4 text-muted">Không có bài đang quá SLA duyệt.</div>}
 <div class="row g-3">@foreach(var item in Model.BrandReviewEscalations){<div class="col-12 col-xl-6"><article class="card-x h-100 @(item.Severity=="Critical"?"border-danger":"border-warning")"><div class="d-flex justify-content-between gap-2"><div><div class="small text-muted">@item.CampaignTitle · @item.DeliverableType</div><h3 class="h5 mb-1">@item.KocName</h3><div class="small">Brand: @item.BrandName · nộp @item.DueDateUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</div></div><span class="badge @(item.Severity=="Critical"?"bg-danger":"bg-warning text-dark") align-self-start">@item.Severity</span></div>@if(item.EscalationStatus=="Open"){<form method="post" asp-page-handler="Acknowledge" class="input-group mt-3"><input type="hidden" name="id" value="@item.EscalationId"/><input name="note" minlength="5" maxlength="1000" required class="form-control" placeholder="Hướng liên hệ và xử lý"/><button class="btn btn-primary">Tiếp nhận</button></form>}@if(item.History.Count>0){<details class="mt-3"><summary class="small text-primary">Timeline SLA (@item.History.Count)</summary><div class="border-start ps-3 mt-2">@foreach(var h in item.History){<div class="small mb-2">@(h.FromStatus??"Khởi tạo") → <strong>@h.ToStatus</strong> · @h.CreatedAtUtc.ToVietnamTime().ToString("dd/MM HH:mm")<div class="text-muted">@h.ActorLabel · @h.Note</div></div>}</div></details>}</article></div>}</div>
</section>
