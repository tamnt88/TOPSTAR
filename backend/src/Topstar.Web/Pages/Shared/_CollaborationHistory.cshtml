@model IReadOnlyList<Topstar.Application.Collaborations.CollaborationItem>
@if(Model.Count==0){<div class="card-x text-center py-5 text-muted">Chưa có lần hợp tác nào.</div>}
<div class="row g-3">
@foreach(var item in Model)
{
    <div class="col-12 col-xl-6"><article class="card-x h-100"><div class="d-flex flex-wrap justify-content-between gap-2"><div><div class="small text-muted">@item.CampaignTitle</div><h2 class="h5 mb-1">@item.BrandName ↔ @item.KocName</h2><div class="small text-muted">Xác nhận @item.ConfirmedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</div></div><span class="badge bg-secondary align-self-start">@item.Status</span></div>
    @if(item.Events.Count==0){<div class="small text-muted mt-3">Chưa có sự kiện lịch sử.</div>}else{<details class="mt-3"><summary class="text-primary">Timeline tổng hợp (@item.Events.Count)</summary><div class="border-start ps-3 mt-3">@foreach(var e in item.Events){<div class="mb-3"><div class="d-flex flex-wrap gap-2 align-items-center"><span class="badge bg-light text-dark border">@e.Domain</span><strong>@e.Status</strong><span class="small text-muted">@e.OccurredAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</span></div>@if(!string.IsNullOrWhiteSpace(e.Note)){<div class="small mt-1">@e.Note</div>}@if(!string.IsNullOrWhiteSpace(e.ActorRole)){<div class="small text-muted">Thao tác bởi vai trò @e.ActorRole</div>}</div>}</div></details>}
    </article></div>
}
</div>
