@page
@model Topstar.Web.Pages.Admin.Settings.SeoSocialFormModel
@{ViewData["Title"]=Model.Editing?"Sửa cấu hình SEO":"Thêm cấu hình SEO";ViewData["AdminHeaderTitle"]=ViewData["Title"];ViewData["AdminActivePath"]="/Admin/Settings/SeoSocial";}
@section Styles{<link rel="stylesheet" href="~/css/admin/seo-social.css" asp-append-version="true"/><link rel="stylesheet" href="~/lib/ckeditor5/ckeditor5.css"/>}
<main class="seo-form-page"><header><a asp-page="SeoSocial"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</a><h1>@ViewData["Title"]</h1><p>Cấu hình nội dung tìm kiếm và chia sẻ mạng xã hội cho một trang public.</p></header>
<form method="post" enctype="multipart/form-data" class="seo-form-card" novalidate><input asp-for="Input.Id" type="hidden"/><input asp-for="Input.OgImageUrl" type="hidden"/><input asp-for="Input.TwitterImageUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<section><h2><i class="fa-solid fa-globe"></i> Thông tin trang</h2><div class="row g-3"><div class="col-md-4 admin-validation-field"><label asp-for="Input.PageKey">Mã trang <span>*</span></label><div><input asp-for="Input.PageKey" class="form-control" placeholder="Ví dụ: home"/><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.PageKey" class="invalid-feedback"></span></div><div class="col-md-8 admin-validation-field"><label asp-for="Input.PagePath">Đường dẫn <span>*</span></label><div><input asp-for="Input.PagePath" class="form-control" placeholder="Ví dụ: /"/><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.PagePath" class="invalid-feedback"></span></div><div class="col-12"><label>Tiêu đề SEO</label><input asp-for="Input.SeoTitle" class="form-control" maxlength="200"/></div><div class="col-12"><label>Mô tả SEO</label><textarea asp-for="Input.SeoDescription" class="form-control" rows="3" maxlength="500"></textarea></div><div class="col-12"><label>Từ khóa SEO</label><input asp-for="Input.SeoKeywords" class="form-control" maxlength="500"/></div><div class="col-12"><label>Đường dẫn chính tắc</label><input asp-for="Input.CanonicalUrl" class="form-control" placeholder="https://topstar.vn/..."/></div></div></section>
<section><h2><i class="fa-solid fa-file-lines"></i> Nội dung trang</h2><div class="row g-3">
<div class="col-md-9"><label asp-for="Input.PageTitle">Tiêu đề trang</label><input asp-for="Input.PageTitle" class="form-control"/><span asp-validation-for="Input.PageTitle" class="text-danger"></span></div>
<div class="col-md-3"><label>Lượt xem</label><input value="@Model.Input.ViewCount.ToString("N0")" class="form-control" readonly/></div>
<div class="col-12"><label asp-for="Input.ShortDescription">Mô tả ngắn</label><textarea asp-for="Input.ShortDescription" class="form-control" rows="3" maxlength="1000"></textarea><span asp-validation-for="Input.ShortDescription" class="text-danger"></span></div>
<div class="col-12"><label asp-for="Input.PageContent">Chi tiết trang</label><textarea asp-for="Input.PageContent" class="form-control" rows="12"></textarea><span asp-validation-for="Input.PageContent" class="text-danger"></span></div>
</div></section>
<section><h2><i class="fa-solid fa-share-nodes"></i> Nội dung chia sẻ</h2><div class="row g-3"><div class="col-md-6"><label>Tiêu đề Open Graph</label><input asp-for="Input.OgTitle" class="form-control"/></div><div class="col-md-6"><label>Ảnh Open Graph</label><input asp-for="OgImageFile" type="file" class="form-control" accept=".png,.jpg,.jpeg,.webp"/></div><div class="col-12"><label>Mô tả Open Graph</label><textarea asp-for="Input.OgDescription" class="form-control" rows="2"></textarea></div><div class="col-md-6"><label>Tiêu đề X/Twitter</label><input asp-for="Input.TwitterTitle" class="form-control"/></div><div class="col-md-6"><label>Ảnh X/Twitter</label><input asp-for="TwitterImageFile" type="file" class="form-control" accept=".png,.jpg,.jpeg,.webp"/></div><div class="col-12"><label>Mô tả X/Twitter</label><textarea asp-for="Input.TwitterDescription" class="form-control" rows="2"></textarea></div><div class="col-12"><label>Dữ liệu có cấu trúc JSON-LD</label><textarea asp-for="Input.JsonLd" class="form-control font-monospace" rows="5"></textarea></div></div></section>
<section class="seo-options"><label><input asp-for="Input.IsActive"/><span></span><b>Đang kích hoạt</b></label><label><input asp-for="Input.IsVisible"/><span></span><b>Cho phép hiển thị</b></label></section><footer><a asp-page="SeoSocial" class="btn btn-light">Hủy</a><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Lưu cấu hình</button></footer></form></main>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script src="~/lib/ckeditor5/ckeditor5.umd.js"></script><script src="~/lib/ckeditor5/translations/vi.umd.js"></script><script src="~/js/admin/seo-page-editor.js" asp-append-version="true"></script>}
