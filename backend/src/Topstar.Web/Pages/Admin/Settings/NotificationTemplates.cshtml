@page
@model Topstar.Web.Pages.Admin.Settings.NotificationTemplatesModel
@using Topstar.Application.Notifications
@{ViewData["Title"]="Notification templates";ViewData["AdminHeaderTitle"]="Mẫu thông báo";}
<div ><div class="mb-4"><h1 class="section-title mb-1">Notification templates</h1><p class="text-muted">Tùy biến theo Type + portal nhận. Placeholder hỗ trợ: <code>{Title}</code>, <code>{Body}</code>. Không có template Active thì dùng nội dung gốc.</p></div>
@if(!string.IsNullOrWhiteSpace(Model.Message)){<div class="alert @(Model.Success?"alert-success":"alert-danger")">@Model.Message</div>}
<details class="card-x mb-4"><summary class="fw-semibold">Tạo template</summary><form method="post" asp-page-handler="Save" class="row g-3 mt-1"><div class="col-md-6"><label class="form-label">Notification Type</label><input name="type" required minlength="2" maxlength="50" class="form-control" placeholder="AccountStatus, Violation..."/></div><div class="col-md-3"><label class="form-label">Portal nhận</label><select name="audienceRole" class="form-select">@foreach(var role in NotificationTemplateRules.Roles){<option>@role</option>}</select></div><div class="col-md-3 d-flex align-items-end"><label><input type="checkbox" name="isActive" value="true" checked/> Active</label></div><div class="col-12"><label class="form-label">Title template</label><input name="titleTemplate" required maxlength="200" value="{Title}" class="form-control"/></div><div class="col-12"><label class="form-label">Body template</label><textarea name="bodyTemplate" required maxlength="1000" rows="3" class="form-control">{Body}</textarea></div><div class="col-12"><button class="btn btn-primary">Tạo version đầu tiên</button></div></form></details>
<div class="row g-3">@foreach(var item in Model.Items){<div class="col-12 col-xl-6"><article class="card-x h-100"><div class="d-flex justify-content-between"><div><h2 class="h5">@item.Type</h2><span class="badge bg-secondary">@item.AudienceRole</span></div><span class="badge @(item.IsActive?"bg-success":"bg-secondary")">@(item.IsActive?"Active":"Inactive")</span></div><div class="mt-3"><div class="small text-muted">Title</div><code>@item.TitleTemplate</code><div class="small text-muted mt-2">Body</div><code class="text-break">@item.BodyTemplate</code></div><details class="mt-3"><summary class="text-primary small">Tạo version mới</summary><form method="post" asp-page-handler="Save" class="row g-2 mt-2"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="type" value="@item.Type"/><input type="hidden" name="audienceRole" value="@item.AudienceRole"/><div class="col-12"><input name="titleTemplate" required maxlength="200" value="@item.TitleTemplate" class="form-control"/></div><div class="col-12"><textarea name="bodyTemplate" required maxlength="1000" rows="3" class="form-control">@item.BodyTemplate</textarea></div><div class="col-12"><label><input type="checkbox" name="isActive" value="true" checked="@(item.IsActive?"checked":null)"/> Active</label></div><div class="col-12"><button class="btn btn-sm btn-outline-primary">Lưu</button></div></form></details>@if(item.History.Count>0){<details class="mt-3"><summary class="small">Version history (@item.History.Count)</summary>@foreach(var h in item.History.Reverse()){<div class="small border-start ps-2 mt-2"><strong>@(h.IsActive?"Active":"Inactive")</strong> · @h.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm") · @h.Actor<div>@h.Reason</div><div class="text-muted text-break">@h.TitleTemplate / @h.BodyTemplate</div></div>}</details>}</article></div>}</div></div>
