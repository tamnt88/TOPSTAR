@page
@model Topstar.Web.Pages.Admin.Settings.EmailAccountsModel
@{ViewData["Title"]="Tài khoản email hệ thống";ViewData["AdminHeaderTitle"]=ViewData["Title"];var active=Model.Rows.Count(x=>x.IsActive);}
@section Styles{<link rel="stylesheet" href="~/css/admin/email-accounts.css" asp-append-version="true"/>}
<main class="account-crud-page email-admin">
 <header class="account-crud-header email-page-header"><div><h1>Tài khoản email hệ thống</h1><p>Quản lý email gửi thông báo, kích hoạt, khôi phục mật khẩu và nhận phản hồi.</p></div><div class="d-flex flex-wrap gap-2"><a asp-page="EmailAccountForm" class="btn btn-sm btn-primary"><i class="fa-solid fa-plus"></i><span>Thêm tài khoản</span></a></div></header>
 @if(TempData["AdminMessageSuccess"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["AdminMessageError"] is string error){<div class="alert alert-danger">@error</div>}
 <section class="email-summary"><article><i class="fa-solid fa-at"></i><div><strong>@Model.Rows.Count</strong><span>Tổng tài khoản</span></div></article><article><i class="fa-solid fa-circle-check"></i><div><strong>@active</strong><span>Đang hoạt động</span></div></article><article><i class="fa-solid fa-paper-plane"></i><div><strong>@Model.Rows.Count(x=>x.IsDefaultSender)</strong><span>Mặc định gửi</span></div></article><article><i class="fa-solid fa-inbox"></i><div><strong>@Model.Rows.Count(x=>x.IsDefaultReceiver)</strong><span>Mặc định nhận</span></div></article></section>
 <section class="email-card"><div class="email-card-head"><div><h2>Danh sách tài khoản</h2><p>Mật khẩu SMTP/IMAP không được hiển thị trên danh sách.</p></div></div><div class="email-toolbar"><label><span>Tìm kiếm</span><div><i class="fa-solid fa-magnifying-glass"></i><input id="emailSearch" class="form-control" placeholder="Tên hoặc địa chỉ email"/></div></label><label><span>Trạng thái</span><select id="emailStatus" class="form-select"><option value="">Tất cả</option><option value="Đang hoạt động">Đang hoạt động</option><option value="Tạm tắt">Tạm tắt</option></select></label><label><span>Hiển thị</span><select id="emailLength" class="form-select"><option value="10">10 dòng</option><option value="20">20 dòng</option><option value="50">50 dòng</option></select></label><button id="emailFilter" class="btn btn-primary"><i class="fa-solid fa-filter"></i><span>Lọc</span></button></div>
 <div class="table-responsive"><table id="emailAccountTable" class="table email-table align-middle w-100" data-list-actions="false"><thead><tr><th>STT</th><th>Tài khoản</th><th>Kết nối gửi</th><th>Mặc định</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td></td><td><strong>@row.Name</strong><small>@row.EmailAddress</small></td><td><strong>@(string.IsNullOrWhiteSpace(row.SmtpHost)?"Chưa cấu hình":$"{row.SmtpHost}:{row.SmtpPort}")</strong><small>@(row.SmtpEnableSsl?"Bảo mật SSL":"Không dùng SSL")</small></td><td><div class="email-defaults">@if(row.IsDefaultSender){<span><i class="fa-solid fa-paper-plane"></i>Gửi</span>}@if(row.IsDefaultReceiver){<span><i class="fa-solid fa-inbox"></i>Nhận</span>}@if(!row.IsDefaultSender&&!row.IsDefaultReceiver){<em>—</em>}</div></td><td><span class="email-status @(row.IsActive?"is-active":"is-off")">@(row.IsActive?"Đang hoạt động":"Tạm tắt")</span></td><td><div class="email-actions"><a asp-page="EmailAccountForm" asp-route-id="@row.Id" title="Sửa"><i class="fa-solid fa-pen"></i></a><a asp-page="EmailAccountDelete" asp-route-id="@row.Id" class="is-delete" title="Xóa"><i class="fa-solid fa-trash"></i></a></div></td></tr>}</tbody></table></div></section>
 <form id="emailDiagnosticForm" method="post" class="d-none"><input id="emailDiagnosticId" type="hidden" name="id" /></form>
</main>
@section Scripts{<script src="~/lib/datatables/js/dataTables.min.js?v=2.3.8"></script><script src="~/lib/datatables/js/dataTables.bootstrap5.min.js?v=2.3.8"></script><script src="~/js/admin/email-accounts.js" asp-append-version="true"></script>}
