@page
@model Topstar.Web.Pages.Admin.Settings.MenuManagementModel
@{ViewData["Title"]="Quản lý menu hệ thống";ViewData["AdminHeaderTitle"]=ViewData["Title"];var pager=new Topstar.Web.Features.Common.Paging.PagerViewModel{PageName="/Admin/Settings/MenuManagement",PageIndex=Model.PageIndex,TotalPages=Model.TotalPages,TotalItems=Model.TotalItems,PageSize=Model.PageSize,PageSizeOptions=Model.PageSizeOptions,RouteValues=new Dictionary<string,string?>{{"keyword",Model.Keyword},{"scope",Model.Scope},{"visible",Model.Visible}}};}
@section Styles{<link rel="stylesheet" href="~/css/admin/menu-management.css" asp-append-version="true"/>}
<main class="account-crud-page menu-admin"><header class="account-crud-header"><div><h1>Quản lý menu hệ thống</h1><p>Tổ chức menu và quyền hiển thị riêng cho Admin, KOC và Brand.</p></div><div class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-primary" asp-page="MenuCreate" asp-route-keyword="@Model.Keyword" asp-route-scope="@Model.Scope" asp-route-visible="@Model.Visible" asp-route-pageIndex="@Model.PageIndex" asp-route-pageSize="@Model.PageSize"><i class="fa-solid fa-plus"></i> Thêm menu</a></div></header>
@if(TempData["AdminMessageSuccess"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["AdminMessageError"] is string error){<div class="alert alert-danger">@error</div>}
<section class="menu-summary"><article><span><i class="fa-solid fa-bars"></i></span><div><small>Tổng menu</small><strong>@Model.TotalItems</strong></div></article><article><span class="is-admin"><i class="fa-solid fa-shield-halved"></i></span><div><small>Menu Admin trên trang</small><strong>@Model.Rows.Count(x=>x.ScopeTag=="ADMIN")</strong></div></article><article><span class="is-koc"><i class="fa-solid fa-user-star"></i></span><div><small>Menu KOC trên trang</small><strong>@Model.Rows.Count(x=>x.ScopeTag=="KOC")</strong></div></article><article><span class="is-brand"><i class="fa-solid fa-building"></i></span><div><small>Menu Brand trên trang</small><strong>@Model.Rows.Count(x=>x.ScopeTag=="BRAND")</strong></div></article></section>
<section class="menu-card"><form method="get" class="menu-toolbar"><label><span>Tìm kiếm</span><div><i class="fa-solid fa-magnifying-glass"></i><input class="form-control" name="keyword" value="@Model.Keyword" placeholder="Tiêu đề, mã hoặc đường dẫn"/></div></label><label><span>Phạm vi</span><select class="form-select" name="scope">@foreach(var option in Model.ScopeOptions){<option value="@option.Value" selected="@(Model.Scope==option.Value)">@option.Label</option>}</select></label><label><span>Trạng thái</span><select class="form-select" name="visible"><option value="ALL" selected="@(Model.Visible=="ALL")">Tất cả</option><option value="YES" selected="@(Model.Visible=="YES")">Đang hiển thị</option><option value="NO" selected="@(Model.Visible=="NO")">Đang ẩn</option></select></label><label><span>Hiển thị</span><select class="form-select" name="pageSize">@foreach(var size in Model.PageSizeOptions){<option value="@size" selected="@(Model.PageSize==size)">@size dòng</option>}</select></label><input type="hidden" name="pageIndex" value="1"/><button class="btn btn-primary"><i class="fa-solid fa-filter"></i> Lọc</button></form>
<div class="table-responsive"><table class="table menu-table align-middle"><thead><tr><th>STT</th><th>Menu</th><th>Đường dẫn</th><th>Danh mục cha</th><th>Thứ tự</th><th>Trạng thái</th><th>Phạm vi</th><th>Thao tác</th></tr></thead><tbody>@if(Model.Rows.Count==0){<tr><td colspan="8" class="text-center text-muted py-4">Không có menu phù hợp.</td></tr>}else{@for(var i=0;i<Model.Rows.Count;i++){var m=Model.Rows[i];<tr><td>@((Model.PageIndex-1)*Model.PageSize+i+1)</td><td><strong>@m.Title</strong><small>@m.Code</small></td><td><code>@(string.IsNullOrWhiteSpace(m.Path)?"—":m.Path)</code></td><td><span class="menu-parent">@m.ParentTitle</span></td><td>@m.OrderNo</td><td><span class="menu-status @(m.IsVisible?"is-on":"is-off")">@(m.IsVisible?"Đang hiển thị":"Đang ẩn")</span></td><td><span class="menu-scope is-@m.ScopeTag.ToLowerInvariant()">@m.ScopeTag</span></td><td><div class="menu-row-actions"><a asp-page="MenuEdit" asp-route-id="@m.Id" asp-route-keyword="@Model.Keyword" asp-route-scope="@Model.Scope" asp-route-visible="@Model.Visible" asp-route-pageIndex="@Model.PageIndex" asp-route-pageSize="@Model.PageSize" title="Sửa"><i class="fa-solid fa-pen"></i></a><a asp-page="MenuDelete" asp-route-id="@m.Id" class="is-delete" title="Xóa"><i class="fa-solid fa-trash"></i></a></div></td></tr>}}</tbody></table></div><partial name="_Pager" model="pager"/></section></main>
