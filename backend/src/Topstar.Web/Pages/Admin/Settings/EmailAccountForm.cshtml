@page
@model Topstar.Web.Pages.Admin.Settings.EmailAccountFormModel
@{ViewData["Title"]=Model.Editing?"Sửa tài khoản email":"Thêm tài khoản email";ViewData["AdminHeaderTitle"]=ViewData["Title"];ViewData["AdminActivePath"]="/Admin/Settings/EmailAccounts";}
@section Styles{<link rel="stylesheet" href="~/css/admin/email-accounts.css" asp-append-version="true"/>}
<main class="email-form-page"><header><a asp-page="EmailAccounts"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</a><h1>@ViewData["Title"]</h1><p>Cấu hình máy chủ gửi và nhận email. Mật khẩu đang lưu không được hiển thị lại.</p></header><form method="post" class="email-form-card" novalidate><input asp-for="Input.Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="email-form-summary"></div><section><h2><i class="fa-solid fa-address-card"></i> Thông tin tài khoản</h2><div class="row g-3"><partial name="_EmailField" model='new EmailFieldViewModel("Input.Name","Tên tài khoản",Model.Input.Name,"text","Ví dụ: Email thông báo",true,"col-md-4")'/><partial name="_EmailField" model='new EmailFieldViewModel("Input.EmailAddress","Địa chỉ email",Model.Input.EmailAddress,"email","email@topstar.vn",true,"col-md-4")'/><partial name="_EmailField" model='new EmailFieldViewModel("Input.DisplayName","Tên hiển thị",Model.Input.DisplayName,"text","TopStar",true,"col-md-4")'/></div></section><section><h2><i class="fa-solid fa-paper-plane"></i> Máy chủ gửi SMTP</h2><div class="row g-3"><partial name="_EmailField" model='new EmailFieldViewModel("Input.SmtpHost","SMTP Host",Model.Input.SmtpHost,"text","smtp.gmail.com",true,"col-md-4")'/><partial name="_EmailField" model='new EmailFieldViewModel("Input.SmtpPort","SMTP Port",Model.Input.SmtpPort?.ToString(),"number","587",true,"col-md-2")'/><partial name="_EmailField" model='new EmailFieldViewModel("Input.SmtpUsername","SMTP User",Model.Input.SmtpUsername,"text","Tài khoản đăng nhập",false,"col-md-3")'/><partial name="_EmailField" model='new EmailFieldViewModel("Input.SmtpPassword","SMTP Password",null,"password",Model.Editing?"Để trống nếu không đổi":"Nhập mật khẩu",false,"col-md-3")'/></div></section><section><h2><i class="fa-solid fa-inbox"></i> Máy chủ nhận IMAP <small>Không bắt buộc</small></h2><div class="row g-3"><partial name="_EmailField" model='new EmailFieldViewModel("Input.ImapHost","IMAP Host",Model.Input.ImapHost,"text","imap.gmail.com",false,"col-md-4")'/><partial name="_EmailField" model='new EmailFieldViewModel("Input.ImapPort","IMAP Port",Model.Input.ImapPort?.ToString(),"number","993",false,"col-md-2")'/><partial name="_EmailField" model='new EmailFieldViewModel("Input.ImapUsername","IMAP User",Model.Input.ImapUsername,"text","Tài khoản đăng nhập",false,"col-md-3")'/><partial name="_EmailField" model='new EmailFieldViewModel("Input.ImapPassword","IMAP Password",null,"password",Model.Editing?"Để trống nếu không đổi":"Nhập mật khẩu",false,"col-md-3")'/></div></section><section class="email-options"><h2><i class="fa-solid fa-sliders"></i> Trạng thái và vai trò</h2><div><label><input asp-for="Input.SmtpEnableSsl"/><span></span><b>SMTP SSL</b></label><label><input asp-for="Input.ImapEnableSsl"/><span></span><b>IMAP SSL</b></label><label><input asp-for="Input.IsDefaultSender"/><span></span><b>Mặc định gửi</b></label><label><input asp-for="Input.IsDefaultReceiver"/><span></span><b>Mặc định nhận</b></label><label><input asp-for="Input.IsActive"/><span></span><b>Đang hoạt động</b></label><input asp-for="Input.IsVisible" type="hidden"/></div></section><footer><a asp-page="EmailAccounts" class="btn btn-light">Hủy</a><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Lưu tài khoản</button></footer></form></main>
