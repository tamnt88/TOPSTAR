@page
@model Topstar.Web.Pages.Admin.Settings.SeoSocialModel
@{ViewData["Title"]="SEO và chia sẻ mạng xã hội";ViewData["AdminHeaderTitle"]=ViewData["Title"];var active=Model.Rows.Count(x=>x.IsActive);}
@section Styles{<link rel="stylesheet" href="~/css/admin/seo-social.css" asp-append-version="true"/>}
<main class="account-crud-page seo-admin">
<header class="account-crud-header"><div><h1>SEO và chia sẻ mạng xã hội</h1><p>Quản lý thông tin tìm kiếm và nội dung chia sẻ cho từng trang public.</p></div><div class="d-flex flex-wrap gap-2"><a asp-page="SeoSocialForm" class="btn btn-sm btn-primary"><i class="fa-solid fa-plus"></i> Thêm cấu hình</a></div></header>
@if(TempData["AdminMessageSuccess"] is string success){<div class="alert alert-success">@success</div>}@if(TempData["AdminMessageError"] is string error){<div class="alert alert-danger">@error</div>}
<section class="seo-summary"><article><span><i class="fa-solid fa-globe"></i></span><div><small>Tổng cấu hình</small><strong>@Model.Rows.Count</strong></div></article><article><span class="is-active"><i class="fa-solid fa-circle-check"></i></span><div><small>Đang kích hoạt</small><strong>@active</strong></div></article><article><span class="is-visible"><i class="fa-solid fa-eye"></i></span><div><small>Đang hiển thị</small><strong>@Model.Rows.Count(x=>x.IsVisible)</strong></div></article></section>
<section class="seo-card"><div class="seo-toolbar"><label><span>Tìm kiếm</span><div><i class="fa-solid fa-magnifying-glass"></i><input id="seoSearch" class="form-control" placeholder="Tên cấu hình, đường dẫn hoặc tiêu đề SEO"/></div></label><label><span>Trạng thái</span><select id="seoStatus" class="form-select"><option value="">Tất cả</option><option value="Đang hoạt động">Đang hoạt động</option><option value="Tạm tắt">Tạm tắt</option></select></label><label><span>Hiển thị</span><select id="seoLength" class="form-select"><option value="10">10 dòng</option><option value="20">20 dòng</option><option value="50">50 dòng</option></select></label><button id="seoFilter" class="btn btn-primary"><i class="fa-solid fa-filter"></i> Lọc</button></div>
<div class="table-responsive"><table id="seoTable" data-list-actions="false" class="table seo-table align-middle w-100"><thead><tr><th>STT</th><th>Trang public</th><th>Đường dẫn</th><th>Tiêu đề SEO</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var row in Model.Rows){<tr><td></td><td><strong>@row.PageKey</strong></td><td><code>@row.PagePath</code></td><td>@(string.IsNullOrWhiteSpace(row.SeoTitle)?"Chưa cấu hình":row.SeoTitle)</td><td><span class="seo-status @(row.IsActive?"is-on":"is-off")">@(row.IsActive?"Đang hoạt động":"Tạm tắt")</span></td><td><div class="seo-actions"><a asp-page="SeoSocialForm" asp-route-id="@row.Id" title="Sửa"><i class="fa-solid fa-pen"></i></a><a asp-page="SeoSocialDelete" asp-route-id="@row.Id" class="is-delete" title="Xóa"><i class="fa-solid fa-trash"></i></a></div></td></tr>}</tbody></table></div></section>
</main>
@section Scripts{<script src="~/lib/datatables/js/dataTables.min.js?v=2.3.8"></script><script src="~/lib/datatables/js/dataTables.bootstrap5.min.js?v=2.3.8"></script><script src="~/js/admin/seo-social.js" asp-append-version="true"></script>}
