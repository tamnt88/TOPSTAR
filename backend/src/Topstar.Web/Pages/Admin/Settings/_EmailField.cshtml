@model Topstar.Web.Pages.Admin.Settings.EmailFieldViewModel
<div class="@Model.CssClass email-validation-field"><label for="@Model.Name.Replace(".","_")">@Model.Label @if(Model.Required){<span>*</span>}</label><div><input id="@Model.Name.Replace(".","_")" name="@Model.Name" value="@Model.Value" type="@Model.Type" class="form-control" placeholder="@Model.Placeholder" required="@(Model.Required?"required":null)" minlength="@(Model.Required&&Model.Type!="number"?"2":null)" min="@(Model.Type=="number"?"1":null)" max="@(Model.Type=="number"?"65535":null)" data-validation-message="Vui lòng nhập @Model.Label."/><i class="fa-solid fa-circle-exclamation"></i></div><span class="invalid-feedback" data-valmsg-for="@Model.Name" data-valmsg-replace="true"></span></div>
