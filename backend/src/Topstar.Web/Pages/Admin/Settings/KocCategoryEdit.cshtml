@page
@model Topstar.Web.Pages.Admin.Settings.KocCategoryEditModel
@{ ViewData["Title"] = "Sửa lĩnh vực nội dung"; ViewData["AdminHeaderTitle"] = "Sửa lĩnh vực nội dung"; ViewData["AdminActivePath"] = "/Admin/Settings/KocCategories"; }
@section Styles { <link rel="stylesheet" href="~/css/admin/koc-categories.css" asp-append-version="true" /> }
<div class="category-editor-page">
    <nav class="category-breadcrumb"><a asp-page="KocCategories">Lĩnh vực nội dung KOC</a><i class="fa-solid fa-chevron-right"></i><span>Chỉnh sửa</span></nav>
    <header><span class="category-eyebrow"><i class="fa-solid fa-pen"></i> CẬP NHẬT DANH MỤC</span><h1>Sửa lĩnh vực nội dung</h1><p>Thay đổi tên, mã và thứ tự hiển thị của danh mục.</p></header>
    <form method="post" novalidate class="category-editor-card">
        <input asp-for="Id" type="hidden" />
        <partial name="_KocCategoryForm" for="Input" />
        <footer><a asp-page="KocCategories" class="btn btn-light">Hủy</a><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button></footer>
    </form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
