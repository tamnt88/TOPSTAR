@page "{id:guid}"
@model Topstar.Web.Pages.Admin.Settings.EmailAccountDeleteModel
@{ViewData["Title"]="Xóa tài khoản email";ViewData["AdminHeaderTitle"]=ViewData["Title"];ViewData["AdminActivePath"]="/Admin/Settings/EmailAccounts";}
@section Styles{<link rel="stylesheet" href="~/css/admin/email-accounts.css" asp-append-version="true"/>}<main class="email-form-page"><header><a asp-page="EmailAccounts"><i class="fa-solid fa-arrow-left"></i> Quay lại danh sách</a><h1>Xóa tài khoản email</h1><p>Hành động này chỉ nên thực hiện khi tài khoản không còn được sử dụng.</p></header><form method="post" class="email-form-card email-delete-card"><div class="email-delete-warning"><i class="fa-solid fa-triangle-exclamation"></i><div><strong>Xác nhận xóa “@Model.Item.Name”?</strong><p>@Model.Item.EmailAddress · @(Model.Item.IsDefaultSender||Model.Item.IsDefaultReceiver?"Đang là tài khoản mặc định":"Không phải tài khoản mặc định")</p></div></div><footer><a asp-page="EmailAccounts" class="btn btn-light">Hủy</a><button class="btn btn-danger"><i class="fa-solid fa-trash"></i> Xóa tài khoản</button></footer></form></main>
