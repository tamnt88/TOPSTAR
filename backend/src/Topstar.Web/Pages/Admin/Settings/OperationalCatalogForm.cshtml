@page
@model Topstar.Web.Pages.Admin.Settings.OperationalCatalogFormModel
@using Topstar.Application.Settings
@{ViewData["Title"]=Model.Editing?"Sửa danh mục vận hành":"Thêm danh mục vận hành";ViewData["AdminHeaderTitle"]=ViewData["Title"];ViewData["AdminActivePath"]="/Admin/Settings/OperationalSetup";var returnTab=OperationalCatalogFormModel.TabKey(Model.Input.CatalogType);}
@section Styles { <link rel="stylesheet" href="~/css/admin/operational-setup.css" asp-append-version="true" /> }
<main class="ops-form">
 <header><a id="catalogBackLink" href="/Admin/Settings/OperationalSetup#@returnTab"><i class="fa-solid fa-arrow-left"></i> Quay lại cấu hình</a><h1>@ViewData["Title"]</h1><p>Mọi thay đổi đều được lưu vào lịch sử và nhật ký audit.</p></header>
 <form method="post" class="ops-card ops-catalog-form" novalidate>
  <input asp-for="Input.Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
  <div class="row g-3">
   <div class="col-md-6 admin-validation-field"><label asp-for="Input.CatalogType">Nhóm danh mục <span>*</span></label><div class="ops-validation-control"><select asp-for="Input.CatalogType" class="form-select" disabled="@Model.Editing"><option value="@OperationalCatalogTypes.Violation">Danh mục vi phạm</option><option value="@OperationalCatalogTypes.Deliverable">Loại deliverable</option><option value="@OperationalCatalogTypes.ShipmentCheckpoint">Checkpoint vận chuyển</option></select><i class="fa-solid fa-circle-exclamation"></i></div>@if(Model.Editing){<input asp-for="Input.CatalogType" type="hidden" />}<span asp-validation-for="Input.CatalogType" class="invalid-feedback"></span></div>
   <div class="col-md-6 admin-validation-field"><label asp-for="Input.Code">Mã <span>*</span></label><div class="ops-validation-control"><input asp-for="Input.Code" class="form-control" placeholder="Ví dụ: late-delivery" /><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.Code" class="invalid-feedback"></span></div>
   <div class="col-md-8 admin-validation-field"><label asp-for="Input.Name">Tên hiển thị <span>*</span></label><div class="ops-validation-control"><input asp-for="Input.Name" class="form-control" placeholder="Nhập tên tiếng Việt" /><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.Name" class="invalid-feedback"></span></div>
   <div class="col-md-4 admin-validation-field"><label asp-for="Input.SortOrder">Thứ tự</label><div class="ops-validation-control"><input asp-for="Input.SortOrder" class="form-control" /><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.SortOrder" class="invalid-feedback"></span></div>
   <div class="col-12 admin-validation-field"><label asp-for="Input.Description">Mô tả</label><div class="ops-validation-control"><textarea asp-for="Input.Description" rows="3" class="form-control" placeholder="Mô tả ngắn mục đích sử dụng"></textarea><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.Description" class="invalid-feedback"></span></div>
   <div class="col-12"><section class="ops-violation-defaults" data-violation-fields><div><i class="fa-solid fa-triangle-exclamation"></i><span><strong>Mặc định khi ghi nhận vi phạm</strong><small>Mức độ và điểm phạt sẽ tự động áp dụng theo danh mục.</small></span></div><div class="row g-3"><div class="col-md-6 admin-validation-field"><label asp-for="Input.DefaultSeverity">Mức độ mặc định <span>*</span></label><div class="ops-validation-control"><select asp-for="Input.DefaultSeverity" class="form-select"><option value="">Chọn mức độ</option><option value="Low">Thấp</option><option value="Medium">Trung bình</option><option value="High">Cao</option></select><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.DefaultSeverity" class="invalid-feedback"></span></div><div class="col-md-6 admin-validation-field"><label asp-for="Input.DefaultPenaltyPoints">Điểm phạt mặc định <span>*</span></label><div class="ops-validation-control"><input asp-for="Input.DefaultPenaltyPoints" type="number" min="0" max="100" class="form-control" /><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.DefaultPenaltyPoints" class="invalid-feedback"></span></div></div></section></div>
   <div class="col-12"><label class="ops-switch"><input asp-for="Input.IsActive" /><span></span><b>Đang sử dụng</b></label></div>
   <div class="col-12 admin-validation-field"><label asp-for="Input.Reason">Lý do thay đổi <span>*</span></label><div class="ops-validation-control"><textarea asp-for="Input.Reason" rows="3" class="form-control" placeholder="Nhập lý do từ 10 đến 500 ký tự"></textarea><i class="fa-solid fa-circle-exclamation"></i></div><span asp-validation-for="Input.Reason" class="invalid-feedback"></span></div>
   <div class="col-12 ops-form-actions"><a href="/Admin/Settings/OperationalSetup#@returnTab" class="btn btn-light">Hủy</a><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk"></i><span>Lưu danh mục</span></button></div>
  </div>
 </form>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /><script src="~/js/admin/operational-catalog-form.js" asp-append-version="true"></script> }
