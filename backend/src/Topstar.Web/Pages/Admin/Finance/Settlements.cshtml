@page
@model Topstar.Web.Pages.Admin.Finance.SettlementsModel
@using Topstar.Application.Finance
@{ ViewData["Title"] = "Đối soát thu nhập"; ViewData["AdminHeaderTitle"] = "Đối soát thu nhập"; }
<div >
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4"><div><h1 class="section-title mb-1">Đối soát thu nhập KOC</h1><p class="text-muted mb-0">Chỉ participation hoàn tất và có nội dung Approved mới xuất hiện. Số tiền do Admin xác nhận, không tự suy diễn từ ngân sách.</p></div><a asp-page="/Admin/Finance/TaxFees" asp-route-tab="Koc" class="btn btn-outline-primary align-self-lg-start">Chính sách rút tiền</a></div>
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.MessageSuccess ? "alert-success" : "alert-danger")">@Model.Message</div> }
    <div class="card-x mb-4"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 mb-0">Yêu cầu payout</h2><span class="badge bg-primary">@Model.Payouts.Count(x => x.Status == PayoutStatuses.WithdrawRequested) chờ xử lý</span></div>@if (Model.Payouts.Count == 0) { <div class="text-muted">Chưa có yêu cầu payout.</div> }<partial name="_ListWindow" model='new Topstar.Web.Features.Common.Paging.ListWindowViewModel("adminPayoutList", Model.PayoutWindow)' />
@foreach (var payout in Model.Payouts) { var payoutBadge = payout.Status switch { PayoutStatuses.PaidOut => "bg-success", PayoutStatuses.Failed => "bg-danger", _ => "bg-primary" }; <div class="border rounded-3 p-3 mb-2"><div class="d-flex flex-column flex-xl-row justify-content-between gap-3"><div><div class="d-flex flex-wrap gap-2 align-items-center"><strong>@payout.KocName</strong><span class="badge @payoutBadge">@payout.Status</span></div><div class="fs-5 fw-bold mt-2">Cần chuyển @payout.NetAmount.ToString("N0", PortalFormat.Vietnamese) ₫</div><div class="small text-muted">Yêu cầu @payout.Amount.ToString("N0", PortalFormat.Vietnamese) ₫ · phí @payout.FeeAmount.ToString("N0", PortalFormat.Vietnamese) ₫</div><div>@payout.BankCode · @payout.AccountNumber · @payout.AccountHolderName</div><div class="small text-muted">Yêu cầu @payout.RequestedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</div></div>@if (payout.Status == PayoutStatuses.WithdrawRequested) { <div class="w-100" style="max-width:520px"><form novalidate method="post" asp-page-handler="Payout" class="d-flex gap-2 mb-2"><input type="hidden" name="id" value="@payout.Id" /><input type="hidden" name="targetStatus" value="PaidOut" /><input name="referenceOrReason" maxlength="200" required class="form-control" placeholder="Mã tham chiếu chuyển khoản" /><button class="btn btn-success" data-confirm="Xác nhận đã chuyển đúng số thực nhận?">Đã chi trả</button></form><form novalidate method="post" asp-page-handler="Payout" class="d-flex gap-2"><input type="hidden" name="id" value="@payout.Id" /><input type="hidden" name="targetStatus" value="Failed" /><input name="referenceOrReason" maxlength="200" required class="form-control" placeholder="Lý do thất bại" /><button class="btn btn-outline-danger">Thất bại</button></form></div> } else { <div class="small">@(payout.Status == PayoutStatuses.PaidOut ? $"Mã tham chiếu: {payout.PayoutReference}" : $"Lý do: {payout.FailureReason}")</div> }</div></div> }</div>
    <div class="row g-3 mb-4"><div class="col-6 col-lg-3"><div class="card-x h-100"><div class="text-muted small">Chưa đối soát</div><div class="fs-3 fw-bold text-primary">@Model.Window.Counts.GetValueOrDefault("NotCreated")</div></div></div><div class="col-6 col-lg-3"><div class="card-x h-100"><div class="text-muted small">Chờ khả dụng</div><div class="fs-3 fw-bold text-warning">@Model.Window.Counts.GetValueOrDefault(WalletStatuses.Pending)</div></div></div><div class="col-6 col-lg-3"><div class="card-x h-100"><div class="text-muted small">Có thể rút</div><div class="fs-3 fw-bold text-success">@Model.Window.Counts.GetValueOrDefault(WalletStatuses.Available)</div></div></div><div class="col-6 col-lg-3"><div class="card-x h-100"><div class="text-muted small">Đang tạm giữ</div><div class="fs-3 fw-bold text-danger">@Model.Window.Counts.GetValueOrDefault(WalletStatuses.OnHold)</div></div></div></div>
    <partial name="_ListWindow" model='new Topstar.Web.Features.Common.Paging.ListWindowViewModel("adminSettlementList", Model.Window)' />
@if (Model.Items.Count == 0) { <div class="alert alert-light border">Chưa có participation đủ điều kiện đối soát.</div> }
    @foreach (var item in Model.Items)
    {
        var badge = item.Status switch { WalletStatuses.Available => "bg-success", WalletStatuses.OnHold => "bg-danger", WalletStatuses.Pending => "bg-warning text-dark", _ => "bg-secondary" };
        <div class="card-x mb-3"><div class="d-flex flex-column flex-xl-row justify-content-between gap-3"><div class="flex-grow-1"><div class="d-flex flex-wrap align-items-center gap-2"><h2 class="h5 mb-0">@item.KocName</h2>@if (item.Status is not null) { <span class="badge @badge">@item.Status</span> }</div><div class="text-muted mt-1">@item.CampaignTitle</div><div class="small mt-2">Ngân sách: <strong>@item.CampaignBudget.ToString("N0", PortalFormat.Vietnamese) ₫</strong> · Nội dung Approved: <strong>@item.ApprovedSubmissionCount</strong></div>@if (!string.IsNullOrWhiteSpace(item.HoldReason)) { <div class="alert alert-warning py-2 mt-2 mb-0">Lý do giữ: @item.HoldReason</div> }</div>
        @if (item.TransactionId is null) { <form novalidate method="post" asp-page-handler="Create" class="w-100" style="max-width:520px"><input type="hidden" name="id" value="@item.ParticipationId" /><label class="form-label fw-semibold">Thù lao trước thuế</label><div class="input-group mb-2"><input name="amount" type="number" min="1" step="1000" required class="form-control" placeholder="0" /><span class="input-group-text">₫</span></div><input name="description" maxlength="500" class="form-control" placeholder="Ghi chú đối soát (không bắt buộc)" /><button class="btn btn-primary mt-2" data-confirm="Tạo khoản thu nhập trước thuế cho KOC?">Tạo khoản thu nhập</button></form> }
        else { <div class="w-100" style="max-width:520px">@await Component.InvokeAsync("KocTaxSummary",new{participationId=item.ParticipationId})@if (item.Status == WalletStatuses.Pending) { <div class="d-flex flex-column gap-2"><form novalidate method="post" asp-page-handler="Status"><input type="hidden" name="id" value="@item.TransactionId" /><input type="hidden" name="targetStatus" value="Available" /><button class="btn btn-success" data-confirm="Xác nhận khoản thu nhập đã khả dụng?">Chuyển Available</button></form><form novalidate method="post" asp-page-handler="Status" class="d-flex gap-2"><input type="hidden" name="id" value="@item.TransactionId" /><input type="hidden" name="targetStatus" value="OnHold" /><input name="reason" maxlength="500" required class="form-control" placeholder="Lý do tạm giữ" /><button class="btn btn-outline-danger">Tạm giữ</button></form></div> } else if (item.Status == WalletStatuses.OnHold) { <form novalidate method="post" asp-page-handler="Status"><input type="hidden" name="id" value="@item.TransactionId" /><input type="hidden" name="targetStatus" value="Available" /><button class="btn btn-success">Gỡ giữ và chuyển Available</button></form> } else if (item.Status == WalletStatuses.Available) { <form novalidate method="post" asp-page-handler="Status" class="d-flex gap-2"><input type="hidden" name="id" value="@item.TransactionId" /><input type="hidden" name="targetStatus" value="OnHold" /><input name="reason" maxlength="500" required class="form-control" placeholder="Lý do dispute" /><button class="btn btn-outline-danger">Tạm giữ</button></form> }</div> }
        </div></div>
    }
</div>
