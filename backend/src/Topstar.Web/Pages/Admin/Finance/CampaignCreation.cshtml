@page
@model Topstar.Web.Pages.Admin.Finance.CampaignCreationModel
@{ViewData["Title"]="Cấu hình tạo chiến dịch";}
<div ><header class="mb-4"><span class="admin-page-eyebrow">TÀI CHÍNH</span><h1>Cấu hình tạo chiến dịch</h1><p class="text-muted">Áp dụng cho chiến dịch mới. Chiến dịch cũ giữ nguyên quyền và phí đã chốt.</p></header>
@if(Model.Message is not null){<div hidden data-ts-notification="success">@Model.Message</div>}
@if(!Model.Ready){<section class="card-x">Chạy SQL 169 trước.</section>}else{<form method="post" class="card-x" novalidate><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-4">
<div class="col-md-6"><label asp-for="Input.MinimumBudget" class="form-label">Ngân sách chiến dịch tối thiểu (đ)</label><input asp-for="Input.MinimumBudget" class="form-control" type="number" step="1" data-money-input/><span asp-validation-for="Input.MinimumBudget" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.SelfSelectionMinimumBudget" class="form-label">Ngân sách tối thiểu để Brand tự chọn KOC (đ)</label><input asp-for="Input.SelfSelectionMinimumBudget" class="form-control" type="number" step="1" data-money-input/><span asp-validation-for="Input.SelfSelectionMinimumBudget" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.MinimumBudgetPerKoc" class="form-label">Ngân sách tối thiểu bình quân/KOC (đ)</label><input asp-for="Input.MinimumBudgetPerKoc" class="form-control" type="number" step="1" data-money-input/><span asp-validation-for="Input.MinimumBudgetPerKoc" class="text-danger"></span></div>
<div class="col-md-6"><label asp-for="Input.MaximumKocCount" class="form-label">Số KOC tối đa mỗi chiến dịch</label><input asp-for="Input.MaximumKocCount" class="form-control" type="number" min="1" max="100" step="1"/><span asp-validation-for="Input.MaximumKocCount" class="text-danger"></span></div>
</div><div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top gap-3"><a asp-page="/Admin/Finance/TaxFees" class="btn btn-outline-primary"><i class="fa-solid fa-sliders me-2"></i>Cấu hình thuế và phí</a><button class="btn btn-primary"><i class="fa-solid fa-floppy-disk me-2"></i>Lưu</button></div></form>}
</div>
