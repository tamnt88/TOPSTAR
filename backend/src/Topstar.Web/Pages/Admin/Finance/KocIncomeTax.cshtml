@page
@model Topstar.Web.Pages.Admin.Finance.KocIncomeTaxModel
@{ViewData["Title"]="Thuế thu nhập KOC";}
<div ><header class="mb-4 koc-tax-heading"><div><span class="admin-page-eyebrow"><i class="fa-solid fa-file-invoice-dollar"></i> TÀI CHÍNH KOC</span><h1>Thuế thu nhập KOC</h1><p class="text-muted">TopStar chi trả · Thù lao trước thuế · Khấu trừ khi cộng ví</p></div><a asp-page="/Admin/Finance/TaxFees" asp-route-tab="Koc" class="btn btn-outline-primary"><i class="fa-solid fa-sliders"></i> Cấu hình thuế và phí KOC</a></header>
@if(Model.Message is not null){<div hidden data-ts-notification="@(Model.Success?"success":"error")">@Model.Message</div>}
@if(!Model.Ready){<div class="card-x">Cần triển khai SQL 167 trước khi sử dụng.</div>}else{
<section class="admin-funding-stats mb-4"><article><span><i class="fa-solid fa-coins"></i></span><div><small>Đã khấu trừ</small><strong>@PortalFormat.Money(Model.Withheld)</strong></div></article><article><span><i class="fa-solid fa-circle-check"></i></span><div><small>Đã ghi nhận nộp</small><strong>@PortalFormat.Money(Model.Remitted)</strong></div></article><article><span><i class="fa-solid fa-clock"></i></span><div><small>Còn phải nộp</small><strong>@PortalFormat.Money(Model.Withheld-Model.Remitted)</strong></div></article><article><span><i class="fa-solid fa-id-card"></i></span><div><small>Chờ xác minh thuế</small><strong>@Model.Waiting</strong></div></article></section>
<section class="card-x"><h2 class="h5"><i class="fa-solid fa-list-check"></i> Đối soát thuế</h2><partial name="_ListWindow" model='new Topstar.Web.Features.Common.Paging.ListWindowViewModel("kocTaxPayments",Model.Window,"Filters",false)'/>
<div class="table-responsive"><table class="table align-middle"><thead><tr><th>KOC</th><th>Trước thuế</th><th>Thuế khấu trừ</th><th>Phí nền tảng</th><th>Thực nhận</th><th>Ghi nhận</th><th>Thao tác</th></tr></thead><tbody>@foreach(var p in Model.Payments){<tr><td><a asp-page="/Koc/TaxProfile" asp-route-id="@p.KocId">@p.Name</a><small class="d-block text-muted">@p.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</small></td><td class="text-nowrap">@PortalFormat.Money(p.Gross)</td><td class="text-nowrap">@PortalFormat.Money(p.Tax)</td><td class="text-nowrap">@PortalFormat.Money(p.Fee)</td><td class="text-nowrap">@(p.State=="Awaiting"?"Chờ tính":PortalFormat.Money(p.Net))</td><td>@(p.State=="Awaiting"?"Chờ xác minh":p.RemittedAt.HasValue?"Đã nộp":p.Tax>0?"Chưa nộp":"Không khấu trừ")<small class="d-block">@p.Reference</small></td><td>@if(p.State=="Awaiting"){<form method="post" asp-page-handler="Release"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-outline-primary btn-sm"><i class="fa-solid fa-calculator"></i> Đối soát lại</button></form>}else if(p.Tax>0&&!p.RemittedAt.HasValue){<form method="post" asp-page-handler="Remit" class="d-flex gap-2" novalidate><input type="hidden" name="id" value="@p.Id"/><input name="reference" class="form-control form-control-sm" placeholder="Mã chứng từ nộp thuế"/><button class="btn btn-outline-success btn-sm text-nowrap"><i class="fa-solid fa-check"></i> Đã nộp</button></form>}</td></tr>}
@if(Model.Payments.Count==0){<tr><td colspan="7" class="text-center text-muted p-4">Chưa có khoản thuế cần đối soát.</td></tr>}</tbody></table></div><partial name="_ListWindow" model='new Topstar.Web.Features.Common.Paging.ListWindowViewModel("kocTaxPayments",Model.Window,"Pager")'/></section>}
</div>

@section Scripts{<script>
jQuery(function($){$('form[method="post"]').on('submit',function(e){var bad=null;$(this).find('[name="reference"]').each(function(){var valid=!!this.value.trim();$(this).toggleClass('is-invalid',!valid);if(!valid)bad=this;});if(bad){e.preventDefault();e.stopImmediatePropagation();bad.focus();window.TopstarNotify?.error('Vui lòng nhập mã chứng từ nộp thuế.');}});});
</script>}
