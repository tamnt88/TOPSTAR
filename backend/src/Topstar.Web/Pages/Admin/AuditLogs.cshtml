@page
@model Topstar.Web.Pages.Admin.AuditLogsModel
@{
 ViewData["Title"]="Nhật ký hệ thống";ViewData["AdminHeaderTitle"]="Nhật ký hệ thống";
 string ActionLabel(string value)=>value switch{"Create" or "CreateOperationalCatalog"=>"Thêm mới","Update" or "UpdateOperationalPolicy" or "UpdateOperationalCatalog"=>"Cập nhật","Delete" or "DeleteOperationalCatalog"=>"Xóa","Activate"=>"Hiển thị lại","Deactivate"=>"Tạm ẩn","Export" or "ExportAuditLogs"=>"Xuất dữ liệu",_=>value};
 string ActionClass(string value)=>value.Contains("Delete",StringComparison.OrdinalIgnoreCase)?"is-danger":value.Contains("Deactivate",StringComparison.OrdinalIgnoreCase)?"is-warning":value.Contains("Create",StringComparison.OrdinalIgnoreCase)||value.Contains("Activate",StringComparison.OrdinalIgnoreCase)?"is-success":"is-primary";
 var start=Model.Result.TotalCount==0?0:(Model.Result.CurrentPage-1)*50+1;var end=Math.Min(Model.Result.CurrentPage*50,Model.Result.TotalCount);
 var first=Math.Max(1,Model.Result.CurrentPage-2);var last=Math.Min(Model.Result.TotalPages,first+4);first=Math.Max(1,last-4);
}
@section Styles { <link rel="stylesheet" href="~/css/admin/audit-logs.css" asp-append-version="true" /> }
<main class="audit-page">
 <header class="audit-head"><div><span><i class="fa-solid fa-shield-halved"></i> KIỂM SOÁT HỆ THỐNG</span><h1>Nhật ký hệ thống</h1><p>Tra cứu thao tác quản trị quan trọng. Payload nghiệp vụ nhạy cảm không được hiển thị.</p></div><button form="auditFilter" type="submit" name="handler" value="Export" class="btn audit-export"><i class="fa-solid fa-file-csv"></i><span>Xuất CSV</span></button></header>
 <section class="audit-summary"><article><i class="fa-solid fa-list-check"></i><div><strong>@Model.Result.TotalCount</strong><span>Bản ghi phù hợp</span></div></article><article><i class="fa-solid fa-layer-group"></i><div><strong>@Model.Result.EntityNames.Count</strong><span>Nhóm đối tượng</span></div></article><article><i class="fa-solid fa-bolt"></i><div><strong>@Model.Result.ActionNames.Count</strong><span>Loại hành động</span></div></article><article><i class="fa-solid fa-file-lines"></i><div><strong>@Model.Result.CurrentPage/@Model.Result.TotalPages</strong><span>Trang hiện tại</span></div></article></section>
 <section class="audit-card">
  <form id="auditFilter" method="get" class="audit-toolbar" aria-label="Bộ lọc nhật ký">
   <label class="audit-search"><span>Tìm kiếm</span><div><i class="fa-solid fa-magnifying-glass"></i><input asp-for="Keyword" maxlength="120" class="form-control" placeholder="Email người thao tác hoặc mã đối tượng" /></div></label>
   <label><span>Đối tượng</span><select asp-for="EntityName" class="form-select"><option value="">Tất cả</option>@foreach(var name in Model.Result.EntityNames){<option value="@name">@name</option>}</select></label>
   <label><span>Hành động</span><select asp-for="ActionName" class="form-select"><option value="">Tất cả</option>@foreach(var name in Model.Result.ActionNames){<option value="@name">@ActionLabel(name)</option>}</select></label>
   <label><span>Từ ngày</span><input asp-for="FromDate" type="date" class="form-control" /></label><label><span>Đến ngày</span><input asp-for="ToDate" type="date" class="form-control" /></label>
   <button class="btn btn-primary audit-filter-button"><i class="fa-solid fa-filter"></i><span>Lọc</span></button>
   <a asp-page="/Admin/AuditLogs" class="btn audit-reset" title="Đặt lại bộ lọc" aria-label="Đặt lại bộ lọc"><i class="fa-solid fa-rotate-left"></i></a>
  </form>
  <div class="audit-table-head"><div><h2>Danh sách nhật ký</h2><p>Hiển thị @start–@end trong @Model.Result.TotalCount bản ghi</p></div><span>50 dòng/trang</span></div>
  @if(Model.Result.Items.Count==0){<div class="audit-empty"><i class="fa-solid fa-magnifying-glass"></i><strong>Không tìm thấy nhật ký</strong><span>Hãy thay đổi điều kiện lọc và thử lại.</span></div>}else{
   <div class="table-responsive"><table class="table audit-table align-middle"><thead><tr><th>Thời gian</th><th>Người thao tác</th><th>Hành động</th><th>Đối tượng</th><th>Mã đối tượng</th></tr></thead><tbody>@foreach(var item in Model.Result.Items){<tr><td data-order="@item.CreatedAtUtc.ToString("O")"><strong>@item.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy")</strong><small>@item.CreatedAtUtc.AddHours(7).ToString("HH:mm:ss") · UTC+7</small></td><td><strong>@item.Actor</strong><small><span class="audit-role">@item.ActorRole</span></small></td><td><span class="audit-action @ActionClass(item.ActionName)">@ActionLabel(item.ActionName)</span><small>@item.ActionName</small></td><td><strong>@item.EntityName</strong></td><td><code>@item.EntityId</code></td></tr>}</tbody></table></div>
   @if(Model.Result.TotalPages>1){<nav class="admin-pagination audit-pagination" aria-label="Phân trang nhật ký"><a class="page-link @(Model.Result.CurrentPage<=1?"disabled":"")" title="Trang đầu" aria-label="Trang đầu" asp-route-Keyword="@Model.Keyword" asp-route-EntityName="@Model.EntityName" asp-route-ActionName="@Model.ActionName" asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-PageNumber="1"><i class="fa-solid fa-angles-left"></i></a><a class="page-link @(Model.Result.CurrentPage<=1?"disabled":"")" title="Trang trước" aria-label="Trang trước" asp-route-Keyword="@Model.Keyword" asp-route-EntityName="@Model.EntityName" asp-route-ActionName="@Model.ActionName" asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-PageNumber="@(Model.Result.CurrentPage-1)"><i class="fa-solid fa-angle-left"></i></a>@for(var pageNo=first;pageNo<=last;pageNo++){<a class="page-link @(pageNo==Model.Result.CurrentPage?"active":"")" asp-route-Keyword="@Model.Keyword" asp-route-EntityName="@Model.EntityName" asp-route-ActionName="@Model.ActionName" asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-PageNumber="@pageNo">@pageNo</a>}<a class="page-link @(Model.Result.CurrentPage>=Model.Result.TotalPages?"disabled":"")" title="Trang sau" aria-label="Trang sau" asp-route-Keyword="@Model.Keyword" asp-route-EntityName="@Model.EntityName" asp-route-ActionName="@Model.ActionName" asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-PageNumber="@(Model.Result.CurrentPage+1)"><i class="fa-solid fa-angle-right"></i></a><a class="page-link @(Model.Result.CurrentPage>=Model.Result.TotalPages?"disabled":"")" title="Trang cuối" aria-label="Trang cuối" asp-route-Keyword="@Model.Keyword" asp-route-EntityName="@Model.EntityName" asp-route-ActionName="@Model.ActionName" asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")" asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")" asp-route-PageNumber="@Model.Result.TotalPages"><i class="fa-solid fa-angles-right"></i></a></nav>}
  }
 </section>
</main>
