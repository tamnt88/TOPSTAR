@page
@model Topstar.Web.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Description"] = "Dashboard quản trị hệ thống TopStar cho admin.";
}

<section class="admin-dashboard-page">
    <div class="container admin-dashboard-wrap">
        <div class="admin-kpi-grid">
            <article class="admin-kpi-card">
                <span class="kpi-icon kpi-blue"><i class="fa-regular fa-building"></i></span>
                <p>Brand hoạt động</p>
                <h3>@Model.Data.ActiveBrands</h3>
            </article>
            <article class="admin-kpi-card">
                <span class="kpi-icon kpi-green"><i class="fa-solid fa-user-group"></i></span>
                <p>KOC Active</p>
                <h3>@Model.Data.ActiveKocs</h3>
            </article>
            <article class="admin-kpi-card">
                <span class="kpi-icon kpi-purple"><i class="fa-regular fa-circle-dot"></i></span>
                <p>Chiến dịch đang chạy</p>
                <h3>@Model.Data.RunningCampaigns</h3>
            </article>
            <article class="admin-kpi-card">
                <span class="kpi-icon kpi-orange"><i class="fa-solid fa-dollar-sign"></i></span>
                <p>Tổng budget chiến dịch chạy</p>
                <h3>@Model.Data.TotalBudgetRunningCampaigns.ToString("N0")</h3>
            </article>
        </div>

        <div class="admin-block">
            <h2><i class="fa-regular fa-circle-exclamation text-danger"></i> Cảnh báo cần xử lý</h2>
            <div class="admin-alert-grid">
                <div class="admin-alert-card alert-yellow">
                    <b>@Model.Data.PendingCampaigns</b>
                    <span>Campaign chờ duyệt/chỉnh sửa</span>
                </div>
                <div class="admin-alert-card alert-red">
                    <b>@Model.Data.NeedReviewSubmissions</b>
                    <span>Submission chờ duyệt</span>
                </div>
                <div class="admin-alert-card alert-blue">
                    <b>@Model.Data.OpenShipmentIssues</b>
                    <span>Vấn đề giao nhận đang mở</span>
                </div>
            </div>
        </div>

        <div class="admin-block">
            <h2>Trạng thái chiến dịch</h2>
            <div class="admin-status-list">
                @foreach (var item in Model.Data.CampaignStatuses)
                {
                    <div class="admin-status-row">
                        <div class="status-main">
                            <span class="status-icon run"><i class="fa-regular fa-circle-dot"></i></span>
                            <div><b>@item.Label</b><p>@item.Count chiến dịch</p></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="admin-block">
            <h2>Hoạt động gần đây</h2>
            <ul class="admin-activity-list">
                @foreach (var row in Model.Data.RecentActivities)
                {
                    <li><b>@row.Title</b><span>@row.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></li>
                }
            </ul>
        </div>
    </div>
</section>

