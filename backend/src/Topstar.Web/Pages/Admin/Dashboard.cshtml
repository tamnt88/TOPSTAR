@page
@{ ViewData["Title"] = "Admin Dashboard"; }
<div class="page-wrap card-list">
  <div class="d-flex justify-content-between align-items-end">
    <div><h1 class="section-title mb-0">Admin Dashboard</h1><div class="kpi-title">Quan tri he thong</div></div>
    <div class="top-nav"><a class="active" asp-page="/Admin/Dashboard">Tong quan</a><a asp-page="/Admin/Brands">Brand</a><a asp-page="/Admin/Academy">Hoc vien</a></div>
  </div>
  <div class="kpi-grid">
    <div class="kpi-box"><div class="kpi-title">Brand hoat dong</div><div class="kpi-value">24</div></div>
    <div class="kpi-box"><div class="kpi-title">KOC Active</div><div class="kpi-value">156</div></div>
    <div class="kpi-box"><div class="kpi-title">Chien dich dang chay</div><div class="kpi-value">18</div></div>
    <div class="kpi-box"><div class="kpi-title">Doanh thu thang</div><div class="kpi-value">420tr</div></div>
  </div>
  <div class="card-x">
    <h2 class="h5">Canh bao can xu ly</h2>
    <div class="kpi-grid">
      <div class="kpi-box" style="border-color:#facc15;background:#fffdf2"><div class="kpi-value">3</div><div class="kpi-title">Chien dich sap tre deadline</div></div>
      <div class="kpi-box" style="border-color:#fda4af;background:#fff5f6"><div class="kpi-value">2</div><div class="kpi-title">KOC khong phan hoi</div></div>
      <div class="kpi-box" style="border-color:#93c5fd;background:#f4f8ff"><div class="kpi-value">5</div><div class="kpi-title">Brand can ho tro</div></div>
    </div>
  </div>
  <div class="card-x">
    <h2 class="h5">Trang thai chien dich</h2>
    <div class="list-row"><div><b>Cho trien khai</b><div class="kpi-title">5 chien dich</div></div><button class="btn-x btn-blue">Xem chi tiet</button></div>
    <div class="list-row"><div><b>Dang chay</b><div class="kpi-title">18 chien dich</div></div><button class="btn-x btn-blue">Xem chi tiet</button></div>
    <div class="list-row"><div><b>Da hoan thanh</b><div class="kpi-title">142 chien dich</div></div><button class="btn-x btn-blue">Xem chi tiet</button></div>
  </div>
</div>
