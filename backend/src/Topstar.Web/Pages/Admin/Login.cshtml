@page "/admin/dang-nhap"
@model Topstar.Web.Pages.Admin.LoginModel
@using Topstar.Application.Website
@inject IWebsiteContentService WebsiteContentService
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập quản trị TopStar";
    var website = await WebsiteContentService.GetWebsiteContentAsync(Model.HttpContext.RequestAborted);
    var websiteName = website?.WebsiteName ?? "TopStar";
    var logoPath = string.IsNullOrWhiteSpace(website?.LogoUrl) ? "/images/logo.png" : website.LogoUrl;
    var faviconPath = string.IsNullOrWhiteSpace(website?.FaviconUrl) ? "/favicon.ico" : website.FaviconUrl;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - @websiteName</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="@faviconPath" />
    <link rel="shortcut icon" href="@faviconPath" />
    <link rel="apple-touch-icon" href="@faviconPath" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/admin/admin-login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-login-brand.css" asp-append-version="true" />
</head>
<body>
    <main class="admin-login-page">
        <section class="admin-login-card">
            <aside>
                <a href="/" class="admin-brand" aria-label="Về trang chủ @websiteName"><img src="@logoPath" alt="@websiteName" /></a>
                <div class="admin-intro">
                    <p>ADMIN CONSOLE</p>
                    <h1>Trung tâm<br />quản trị hệ thống.</h1>
                    <span>Kiểm soát thành viên, chiến dịch, tài chính và cấu hình vận hành trên một nền tảng bảo mật.</span>
                </div>
                <div class="admin-secure"><i class="fa-solid fa-shield-halved"></i><span>Khu vực dành riêng cho quản trị viên</span></div>
            </aside>
            <div class="admin-login-form">
                <a href="/" class="admin-back"><i class="fa-solid fa-arrow-left"></i> Về trang chủ</a>
                <div class="admin-form-title"><h2>Đăng nhập Admin</h2><p>Sử dụng tài khoản quản trị được cấp để tiếp tục.</p></div>
                <form method="post" novalidate>
                    <input type="hidden" asp-for="ReturnUrl" />
                    <div asp-validation-summary="ModelOnly" class="admin-error"></div>
                    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage)) { <div class="admin-error"><i class="fa-solid fa-circle-exclamation"></i> @Model.ErrorMessage</div> }
                    <div class="admin-field">
                        <label asp-for="Input.Email"></label>
                        <div><i class="fa-regular fa-envelope"></i><input asp-for="Input.Email" type="email" autocomplete="username" placeholder="admin@topstar.local" autofocus /></div>
                        <span asp-validation-for="Input.Email"></span>
                    </div>
                    <div class="admin-field">
                        <label asp-for="Input.Password"></label>
                        <div><i class="fa-solid fa-key"></i><input asp-for="Input.Password" type="password" autocomplete="current-password" placeholder="Nhập mật khẩu" /></div>
                        <span asp-validation-for="Input.Password"></span>
                    </div>
                    <div class="admin-options"><label><input asp-for="Input.RememberMe" /> <span>Ghi nhớ đăng nhập</span></label><a href="/quen-mat-khau">Quên mật khẩu?</a></div>
                    <button type="submit"><span>Đăng nhập quản trị</span><i class="fa-solid fa-arrow-right"></i></button>
                </form>
                <p class="admin-help"><i class="fa-solid fa-circle-info"></i> Nếu không có quyền truy cập, vui lòng liên hệ quản trị viên hệ thống.</p>
            </div>
        </section>
    </main>
    <partial name="_ValidationScriptsPartial" />
</body>
</html>
