@page
@model Topstar.Web.Pages.Admin.DisputesModel
@using Topstar.Application.Disputes
@{ViewData["Title"]="Tranh chấp";ViewData["AdminHeaderTitle"]="Tranh chấp";}
<div ><div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><h1 class="section-title mb-1">Trung tâm tranh chấp</h1><p class="text-muted mb-0">Tiếp nhận, điều tra và ghi kết luận mà không sửa lịch sử cũ.</p></div><div class="btn-group"><a asp-page="/Admin/Disputes" class="btn @(string.IsNullOrWhiteSpace(Model.Status)?"btn-primary":"btn-outline-primary")">Tất cả</a><a asp-route-status="Open" class="btn @(Model.Status=="Open"?"btn-primary":"btn-outline-primary")">Mới mở</a><a asp-route-status="InReview" class="btn @(Model.Status=="InReview"?"btn-primary":"btn-outline-primary")">Đang xử lý</a><a asp-route-status="Resolved" class="btn @(Model.Status=="Resolved"?"btn-primary":"btn-outline-primary")">Đã giải quyết</a></div></div>
@if(!string.IsNullOrWhiteSpace(Model.Message)){<div class="alert @(Model.MessageSuccess?"alert-success":"alert-danger")">@Model.Message</div>}<partial name="_ListWindow" model='new Topstar.Web.Features.Common.Paging.ListWindowViewModel("adminDisputeList", Model.Window)' />
@if(Model.Cases.Count==0){<div class="card-x text-center py-5 text-muted">Không có tranh chấp theo bộ lọc.</div>}
<div class="row g-3">@foreach(var item in Model.Cases){var badge=item.Status==DisputeStatuses.Open?"bg-danger":item.Status==DisputeStatuses.InReview?"bg-warning text-dark":item.Status==DisputeStatuses.Resolved?"bg-success":"bg-secondary";<div class="col-12 col-xl-6"><article class="card-x h-100"><div class="d-flex justify-content-between gap-2"><div><div class="small text-muted">@item.CampaignTitle · @item.Category</div><h2 class="h5 mb-1">@item.Subject</h2><div class="small">@item.BrandName ↔ @item.KocName · mở bởi @item.OpenedBy</div></div><div class="text-end"><span class="badge @badge">@item.Status</span>@if(item.Priority=="High"){<div><span class="badge bg-danger mt-1">Ưu tiên cao</span></div>}</div></div><p class="mt-3">@item.Description</p>
<a asp-page="/Admin/DisputeDetail" asp-route-id="@item.Id" class="btn btn-outline-primary w-100 mb-2">Mở hồ sơ & bằng chứng</a>@if(item.Status==DisputeStatuses.Open){<form method="post" asp-page-handler="Take"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="@Model.Status"/><button class="btn btn-primary w-100">Tiếp nhận xử lý</button></form>}
@if(DisputeTransitions.CanResolve(item.Status)){<details class="mt-2"><summary class="small text-primary">Ghi kết luận</summary><form method="post" asp-page-handler="Decide" class="mt-2"><input type="hidden" name="id" value="@item.Id"/><input type="hidden" name="status" value="@Model.Status"/><textarea name="resolution" minlength="10" maxlength="2000" rows="3" class="form-control" placeholder="Căn cứ, kết luận và hướng xử lý" required></textarea><div class="d-flex flex-column flex-sm-row gap-2 mt-2"><button name="decision" value="@DisputeStatuses.Resolved" class="btn btn-success flex-fill">Chấp nhận & giải quyết</button><button name="decision" value="@DisputeStatuses.Rejected" class="btn btn-outline-danger flex-fill">Bác khiếu nại</button></div></form></details>}
@if(!string.IsNullOrWhiteSpace(item.ResolutionNote)){<div class="alert alert-success py-2 mt-3"><strong>Kết luận:</strong> @item.ResolutionNote</div>}@if(item.History.Count>0){<details class="mt-2"><summary class="small text-primary">Timeline xử lý</summary><div class="border-start ps-3 mt-2">@foreach(var h in item.History){<div class="small mb-2">@h.FromStatus → <strong>@h.ToStatus</strong> · @h.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")@if(!string.IsNullOrWhiteSpace(h.Note)){<div class="text-muted">@h.Note</div>}</div>}</div></details>}</article></div>}</div></div>
