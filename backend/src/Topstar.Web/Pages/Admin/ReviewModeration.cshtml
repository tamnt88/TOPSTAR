@page
@model Topstar.Web.Pages.Admin.ReviewModerationModel
@{ ViewData["Title"] = "Kiểm duyệt đánh giá"; ViewData["AdminHeaderTitle"] = "Kiểm duyệt đánh giá"; }
<div >
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-2 mb-4"><div><h1 class="section-title mb-1">Kiểm duyệt đánh giá</h1><p class="text-muted mb-0">Ẩn nội dung vi phạm mà không xóa dữ liệu hoặc sửa lịch sử.</p></div><div class="btn-group"><a asp-page="/Admin/ReviewModeration" class="btn @(string.IsNullOrWhiteSpace(Model.Status) ? "btn-primary" : "btn-outline-primary")">Tất cả</a><a asp-route-status="Completed" class="btn @(Model.Status == "Completed" ? "btn-primary" : "btn-outline-primary")">Đang hiển thị</a><a asp-route-status="Hidden" class="btn @(Model.Status == "Hidden" ? "btn-primary" : "btn-outline-primary")">Đã ẩn</a></div></div>
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.MessageSuccess ? "alert-success" : "alert-danger")">@Model.Message</div> }
    <partial name="_ReviewAppealsAdmin" model="Model.Appeals" />
    <div class="row g-3 mb-4"><div class="col-6"><div class="card-x h-100"><div class="text-muted small">Đang hiển thị</div><div class="fs-3 fw-bold text-success">@Model.Items.Count(x => x.Status == "Completed")</div></div></div><div class="col-6"><div class="card-x h-100"><div class="text-muted small">Đã ẩn</div><div class="fs-3 fw-bold text-danger">@Model.Items.Count(x => x.Status == "Hidden")</div></div></div></div>
    @if (Model.Items.Count == 0) { <div class="alert alert-light border">Không có review trong bộ lọc này.</div> }
    @foreach (var item in Model.Items) { var badge = item.Status == "Hidden" ? "bg-danger" : "bg-success"; <div class="card-x mb-3"><div class="d-flex flex-column flex-xl-row justify-content-between gap-3"><div class="flex-grow-1"><div class="d-flex flex-wrap gap-2 align-items-center"><h2 class="h5 mb-0">@item.CampaignTitle</h2><span class="badge @badge">@item.Status</span></div><div class="small text-muted mt-1">@item.ReviewerEmail → @item.RevieweeEmail · @item.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</div><div class="text-warning fs-5 mt-2" aria-label="@item.Rating trên 5 sao">@string.Concat(Enumerable.Repeat("★", item.Rating))@string.Concat(Enumerable.Repeat("☆", 5 - item.Rating))</div>@if (!string.IsNullOrWhiteSpace(item.Comment)) { <div class="mt-2">@item.Comment</div> }@if (item.History.Count > 0) { <details class="mt-2"><summary class="small text-primary">Lịch sử kiểm duyệt</summary><div class="border-start ps-3 mt-2">@foreach (var history in item.History) { <div class="small mb-2"><strong>@history.ToStatus</strong> · @history.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")@if (!string.IsNullOrWhiteSpace(history.Reason)) { <div class="text-muted">@history.Reason</div> }</div> }</div></details> }</div>@if (item.Status == "Completed") { <form method="post" asp-page-handler="Moderate" class="w-100" style="max-width:480px"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="targetStatus" value="Hidden" /><input type="hidden" name="Status" value="@Model.Status" /><label class="form-label fw-semibold">Lý do ẩn</label><textarea name="reason" maxlength="500" required rows="2" class="form-control" placeholder="Nội dung vi phạm hoặc lý do kiểm duyệt"></textarea><button class="btn btn-outline-danger mt-2" onclick="return confirm('Ẩn đánh giá này?')">Ẩn đánh giá</button></form> } else { <form method="post" asp-page-handler="Moderate"><input type="hidden" name="id" value="@item.Id" /><input type="hidden" name="targetStatus" value="Completed" /><input type="hidden" name="Status" value="@Model.Status" /><button class="btn btn-success">Khôi phục hiển thị</button></form> }</div></div> }
</div>
