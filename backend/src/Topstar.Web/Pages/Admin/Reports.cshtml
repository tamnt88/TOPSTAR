@page
@model Topstar.Web.Pages.Admin.ReportsModel
@{ViewData["Title"]="Báo cáo vận hành";ViewData["AdminHeaderTitle"]="Báo cáo vận hành";var r=Model.Report;}
<div ><div class="mb-4"><h1 class="section-title mb-1">Báo cáo vận hành</h1><p class="text-muted mb-0">Ảnh chụp trực tiếp từ dữ liệu hiện tại, không dùng KPI mẫu.</p></div><div class="row g-3"><div class="col-6 col-xl-3"><div class="card-x"><div class="small text-muted">Tỷ lệ hoàn tất</div><div class="fs-3 fw-bold">@r.CompletionRate.ToString("N2", PortalFormat.Vietnamese)%</div><div class="small">@r.CompletedCampaigns/@r.CampaignCount campaign</div></div></div><div class="col-6 col-xl-3"><div class="card-x"><div class="small text-muted">Đang hợp tác</div><div class="fs-3 fw-bold">@r.ActiveParticipations</div></div></div><div class="col-6 col-xl-3"><div class="card-x"><div class="small text-muted">Shipment sự cố</div><div class="fs-3 fw-bold text-danger">@r.ShipmentIssueCount</div></div></div><div class="col-6 col-xl-3"><div class="card-x"><div class="small text-muted">Hủy booking muộn</div><div class="fs-3 fw-bold text-warning">@r.LateCancellationCount</div></div></div><div class="col-6 col-xl-3"><div class="card-x"><div class="small text-muted">Dispute active</div><div class="fs-3 fw-bold text-danger">@r.ActiveDisputeCount</div></div></div><div class="col-6 col-xl-3"><div class="card-x"><div class="small text-muted">Phí đã thu</div><div class="fs-5 fw-bold text-success">@r.PaidPlatformFees.ToString("N0", PortalFormat.Vietnamese) ₫</div></div></div><div class="col-6 col-xl-3"><div class="card-x"><div class="small text-muted">Phí đang chờ</div><div class="fs-5 fw-bold text-warning">@r.PendingPlatformFees.ToString("N0", PortalFormat.Vietnamese) ₫</div></div></div><div class="col-6 col-xl-3"><div class="card-x"><div class="small text-muted">Payout chờ xử lý</div><div class="fs-5 fw-bold">@r.PendingPayoutCount · @r.PendingPayoutAmount.ToString("N0", PortalFormat.Vietnamese) ₫</div></div></div></div></div>
