@page
@model Topstar.Web.Pages.Admin.OperationsModel
@using Topstar.Application.Shipments
@{ViewData["Title"]="Vận hành ngoại lệ";ViewData["AdminHeaderTitle"]="Vận hành ngoại lệ";}
@section Styles { <link rel="stylesheet" href="~/css/admin/operations-tabs.css" asp-append-version="true" /> }
<main class="ops-exception-page">
<header class="ops-exception-hero"><div><span class="ops-exception-eyebrow"><i class="fa-solid fa-list-check"></i> Trung tâm điều hành</span><h1>Bàn xử lý ngoại lệ</h1><p>Tập trung các đầu việc quá hạn, tranh chấp và sự cố cần Admin can thiệp.</p></div><div class="ops-exception-summary"><article class="is-danger"><i class="fa-solid fa-truck-fast"></i><span><small>Sự cố vận chuyển</small><strong>@Model.Dashboard.ShipmentIssues.Count</strong></span></article><article class="is-warning"><i class="fa-solid fa-calendar-days"></i><span><small>Lịch cần chú ý</small><strong>@Model.Dashboard.ScheduleAttention.Count</strong></span></article></div></header>
<nav class="admin-module-shortcuts ops-exception-shortcuts" aria-label="Các hàng đợi công việc"><a asp-page="/Admin/Profiles"><i class="fa-solid fa-user-check"></i><span>Hồ sơ chờ duyệt</span></a><a asp-page="/Admin/ReviewModeration"><i class="fa-solid fa-star-half-stroke"></i><span>Duyệt đánh giá</span></a><a asp-page="/Admin/Disputes"><i class="fa-solid fa-scale-balanced"></i><span>Tranh chấp</span></a><a asp-page="/Admin/Violations"><i class="fa-solid fa-triangle-exclamation"></i><span>Vi phạm</span></a></nav>
<section class="ops-overview-stats" aria-label="Thống kê hàng đợi">
 <article><i class="fa-solid fa-clock"></i><span><small>Đầu việc quá hạn</small><strong>@Model.Dashboard.SubmissionEscalations.Count</strong></span></article>
 <article><i class="fa-solid fa-file-circle-check"></i><span><small>Brand chậm duyệt</small><strong>@Model.Dashboard.BrandReviewEscalations.Count</strong></span></article>
 <article><i class="fa-solid fa-scale-balanced"></i><span><small>Tranh chấp quá SLA</small><strong>@Model.Dashboard.DisputeEscalations.Count</strong></span></article>
 <article><i class="fa-solid fa-truck-fast"></i><span><small>Sự cố vận chuyển</small><strong>@Model.Dashboard.ShipmentIssues.Count</strong></span></article>
</section>
<nav class="ts-tabs ops-processing-tabs" aria-label="Nhóm xử lý">
 <button type="button" class="is-active" data-ops-tab="queue"><i class="fa-solid fa-table-list"></i> Tổng hợp</button>
 <button type="button" data-ops-tab="sla"><i class="fa-solid fa-gauge-high"></i> Chính sách SLA</button>
 <button type="button" data-ops-tab="submission"><i class="fa-solid fa-clock"></i> Quá hạn <b>@Model.Dashboard.SubmissionEscalations.Count</b></button>
 <button type="button" data-ops-tab="review"><i class="fa-solid fa-file-circle-check"></i> Duyệt Brand <b>@Model.Dashboard.BrandReviewEscalations.Count</b></button>
 <button type="button" data-ops-tab="dispute"><i class="fa-solid fa-scale-balanced"></i> Tranh chấp <b>@Model.Dashboard.DisputeEscalations.Count</b></button>
 <button type="button" data-ops-tab="shipment"><i class="fa-solid fa-truck-fast"></i> Vận chuyển <b>@Model.Dashboard.ShipmentIssues.Count</b></button>
 <button type="button" data-ops-tab="booking"><i class="fa-solid fa-calendar-days"></i> Booking <b>@Model.Dashboard.ScheduleAttention.Count</b></button>
</nav>
<section class="ops-queue-panel" data-ops-panel="queue">
 <div class="ops-panel-title"><div><h2>Danh sách cần xử lý</h2><p>Tổng hợp các ngoại lệ đang mở theo mức độ ưu tiên.</p></div><span>@(Model.Dashboard.SubmissionEscalations.Count+Model.Dashboard.BrandReviewEscalations.Count+Model.Dashboard.DisputeEscalations.Count+Model.Dashboard.ShipmentIssues.Count+Model.Dashboard.ScheduleAttention.Count) công việc</span></div>
 <div class="ops-queue-filters"><label><span>Từ khóa</span><div><i class="fa-solid fa-magnifying-glass"></i><input id="opsQueueSearch" type="search" placeholder="Tìm chiến dịch, KOC hoặc nội dung"/></div></label><label><span>Nhóm xử lý</span><select id="opsQueueType"><option value="">Tất cả nhóm</option><option>Quá hạn</option><option>Duyệt Brand</option><option>Tranh chấp</option><option>Vận chuyển</option><option>Booking</option></select></label><label><span>Hiển thị</span><select id="opsQueueLength"><option value="10">10 dòng</option><option value="20">20 dòng</option><option value="50">50 dòng</option></select></label><button id="opsQueueFilter" type="button" class="btn btn-primary"><i class="fa-solid fa-filter"></i> Lọc</button></div>
 <div class="table-responsive ops-queue-table"><table id="operationsQueueTable" class="table align-middle mb-0" data-list-actions="false"><thead><tr><th>STT</th><th>Công việc</th><th>Nhóm xử lý</th><th>Mức độ</th><th>Phát hiện</th><th>Thao tác</th></tr></thead><tbody>
 @foreach(var item in Model.Dashboard.SubmissionEscalations){<tr><td></td><td><strong>@item.KocName</strong><small>@item.CampaignTitle · @item.BrandName</small></td><td>Quá hạn</td><td><span class="ops-severity @(item.Severity=="Critical"?"is-critical":"is-high")">@item.Severity</span></td><td data-order="@item.FirstDetectedAtUtc.Ticks">@item.FirstDetectedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</td><td><button type="button" class="ops-open-tab" data-open-ops-tab="submission">Xử lý</button></td></tr>}
 @foreach(var item in Model.Dashboard.BrandReviewEscalations){<tr><td></td><td><strong>@item.KocName</strong><small>@item.CampaignTitle · @item.BrandName</small></td><td>Duyệt Brand</td><td><span class="ops-severity @(item.Severity=="Critical"?"is-critical":"is-high")">@item.Severity</span></td><td data-order="@item.FirstDetectedAtUtc.Ticks">@item.FirstDetectedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</td><td><button type="button" class="ops-open-tab" data-open-ops-tab="review">Xử lý</button></td></tr>}
 @foreach(var item in Model.Dashboard.DisputeEscalations){<tr><td></td><td><strong>@item.Subject</strong><small>@item.Category · @item.DisputeStatus</small></td><td>Tranh chấp</td><td><span class="ops-severity @(item.Severity=="Critical"?"is-critical":"is-high")">@item.Severity</span></td><td data-order="@item.FirstDetectedAtUtc.Ticks">@item.FirstDetectedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</td><td><a asp-page="/Admin/DisputeDetail" asp-route-id="@item.DisputeCaseId" class="ops-open-tab">Xử lý</a></td></tr>}
 @foreach(var item in Model.Dashboard.ShipmentIssues){<tr><td></td><td><strong>@item.KocName</strong><small>@item.CampaignTitle · @item.BrandName</small></td><td>Vận chuyển</td><td><span class="ops-severity is-critical">Sự cố</span></td><td data-order="0">Đang mở</td><td><button type="button" class="ops-open-tab" data-open-ops-tab="shipment">Xử lý</button></td></tr>}
 @foreach(var item in Model.Dashboard.ScheduleAttention){<tr><td></td><td><strong>@item.KocName</strong><small>@item.CampaignTitle · @item.BrandName</small></td><td>Booking</td><td><span class="ops-severity is-high">Chú ý</span></td><td data-order="@(item.StartsAtUtc?.Ticks??0)">@(item.StartsAtUtc?.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")??"Chưa xác định")</td><td><button type="button" class="ops-open-tab" data-open-ops-tab="booking">Xử lý</button></td></tr>}
 </tbody></table></div>
</section>
@if(!string.IsNullOrWhiteSpace(Model.Message)){<div class="alert @(Model.MessageSuccess?"alert-success":"alert-danger")">@Model.Message</div>}
<partial name="_SlaPolicies" model="Model.Dashboard" />
<partial name="_SubmissionEscalations" model="Model.Dashboard" />
<partial name="_BrandReviewEscalations" model="Model.Dashboard" />
<partial name="_DisputeEscalations" model="Model.Dashboard" />
<section class="mb-5"><h2 class="h4 mb-3">Sự cố vận chuyển</h2>@if(Model.Dashboard.ShipmentIssues.Count==0){<div class="card-x text-center py-4 text-muted">Không có sự cố đang mở.</div>}<div class="row g-3">@foreach(var item in Model.Dashboard.ShipmentIssues){<div class="col-12"><article class="card-x border-danger"><div class="d-flex justify-content-between"><div><div class="small text-muted">@item.CampaignTitle</div><h3 class="h5">@item.KocName</h3><div class="small">Brand: @item.BrandName</div></div><span class="badge bg-danger align-self-start">Issue</span></div><div class="alert alert-danger py-2 mt-3">@item.IssueNote</div>@if(!string.IsNullOrWhiteSpace(item.TrackingCode)){<div class="small mb-3"><strong>@item.Carrier:</strong> @item.TrackingCode</div>}<div class="row g-3"><div class="col-lg-7">@if(item.Evidence.Count>0){<h4 class="h6">Ảnh bằng chứng</h4><div class="row g-2">@foreach(var e in item.Evidence){<div class="col-4 col-md-3"><a href="@e.FileUrl" target="_blank" rel="noopener noreferrer"><img src="@e.FileUrl" alt="Bằng chứng vận chuyển" class="img-fluid rounded border" style="aspect-ratio:1;object-fit:cover"/></a><div class="small text-muted">@e.ActorRole · @e.CreatedAtUtc.ToVietnamTime().ToString("dd/MM HH:mm")</div>@if(!string.IsNullOrWhiteSpace(e.Caption)){<div class="small">@e.Caption</div>}</div>}</div>}else{<div class="alert alert-light border py-2">Hai bên chưa tải ảnh bằng chứng.</div>}@if(item.Tracking.Count>0){<details class="mt-3" open><summary class="small text-primary">Checkpoint carrier (@item.Tracking.Count)</summary><div class="border-start ps-3 mt-2">@foreach(var t in item.Tracking){<div class="small mb-2"><strong>@t.EventCode</strong> · @t.OccurredAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")@if(!string.IsNullOrWhiteSpace(t.Location)){<div class="text-muted">@t.Location</div>}<div>@t.Description</div></div>}</div></details>}else{<div class="small text-muted mt-2">Chưa có checkpoint carrier.</div>}</div><div class="col-lg-5"><div class="border rounded-3 p-3"><h4 class="h6">Quyết định Admin</h4><form method="post" asp-page-handler="Shipment"><input type="hidden" name="id" value="@item.ShipmentId"/><textarea name="note" maxlength="1000" rows="3" class="form-control" placeholder="Kết quả xác minh dựa trên timeline và bằng chứng" required></textarea><div class="d-flex flex-column gap-2 mt-2"><button name="decision" value="@ShipmentStatuses.InTransit" class="btn btn-primary">Tiếp tục giao</button><button name="decision" value="@ShipmentStatuses.Returned" class="btn btn-outline-danger">Hoàn hàng</button></div></form></div></div></div>@if(item.History.Count>0){<details class="mt-3"><summary class="small text-primary">Status timeline đầy đủ</summary><div class="border-start ps-3 mt-2">@foreach(var h in item.History){<div class="small mb-2">@h.FromStatus → <strong>@h.ToStatus</strong> · @h.CreatedAtUtc.ToVietnamTime().ToString("dd/MM HH:mm")<div class="text-muted">@h.Note</div></div>}</div></details>}</article></div>}</div></section>
<section><h2 class="h4 mb-3">Booking cần chú ý</h2>@if(Model.Dashboard.ScheduleAttention.Count==0){<div class="card-x text-center py-4 text-muted">Không có lịch cần Admin can thiệp.</div>}<div class="row g-3">@foreach(var item in Model.Dashboard.ScheduleAttention){<div class="col-12 col-xl-6"><article class="card-x h-100"><div class="d-flex justify-content-between"><div><div class="small text-muted">@item.CampaignTitle</div><h3 class="h5">@item.KocName</h3><div class="small">Brand: @item.BrandName</div></div><span class="badge bg-warning text-dark align-self-start">@item.AttentionReason</span></div><div class="p-3 bg-light rounded mt-3"><strong>@item.StartsAtUtc?.ToVietnamTime().ToString("dd/MM/yyyy HH:mm") – @item.EndsAtUtc?.ToVietnamTime().ToString("HH:mm")</strong><div class="small text-muted">@item.Status · đổi @item.RescheduleCount lần</div></div><details class="mt-3"><summary class="small text-danger">Buộc hủy lịch</summary><form method="post" asp-page-handler="Schedule" class="input-group mt-2"><input type="hidden" name="id" value="@item.ScheduleId"/><input name="reason" maxlength="1000" class="form-control" placeholder="Lý do can thiệp bắt buộc" required/><button class="btn btn-outline-danger">Hủy và thông báo</button></form></details>@if(item.History.Count>0){<details class="mt-2"><summary class="small text-primary">Timeline đầy đủ</summary><div class="border-start ps-3 mt-2">@foreach(var h in item.History){<div class="small mb-2">@h.FromStatus → <strong>@h.ToStatus</strong> · @h.CreatedAtUtc.ToVietnamTime().ToString("dd/MM HH:mm")<div class="text-muted">@h.Note</div></div>}</div></details>}</article></div>}</div></section></main>
@section Scripts { <script src="~/lib/datatables/js/dataTables.min.js?v=2.3.8"></script><script src="~/lib/datatables/js/dataTables.bootstrap5.min.js?v=2.3.8"></script><script src="~/js/admin/operations-tabs.js" asp-append-version="true"></script> }
