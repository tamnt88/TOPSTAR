@page "/Admin/Accounts/Center/{Type}/{UserId:guid}"
@model Topstar.Web.Pages.Admin.AccountCenterModel
@{
    var isKoc = Model.Type == "KOC";
    ViewData["Title"] = $"Trung tâm {(isKoc ? "KOC" : "Brand")}";
    ViewData["AdminHeaderTitle"] = $"Trung tâm {(isKoc ? "KOC" : "Brand")}";
    ViewData["AdminHeaderSubtitle"] = "Toàn bộ thông tin và nghiệp vụ tài khoản trên một trang";
    ViewData["AdminActivePath"] = isKoc ? "/Admin/Accounts/KOC" : "/Admin/Accounts/Brand";
    var detail = Model.Detail;
    var activeSessions = detail.Sessions.Count(x => x.RevokedAtUtc is null);
    var loginEvents = detail.AuthEvents.Where(x => x.EventType.Contains("Login", StringComparison.OrdinalIgnoreCase)).OrderByDescending(x => x.OccurredAtUtc).ToList();
    var successfulLoginCount = loginEvents.Count(x => x.EventStatus == "Success");
    string StatusText(string value) => value switch { "Active" => "Đang hoạt động", "Locked" => "Đã khóa", "Approved" => "Đã duyệt", "PendingReview" => "Chờ duyệt", "NeedUpdate" => "Cần bổ sung", "Rejected" => "Từ chối", "Completed" => "Hoàn thành", "Confirmed" => "Đang thực hiện", _ => value };
    string GenderText(string? value) => value?.ToLowerInvariant() switch { "female" => "Nữ", "male" => "Nam", "other" => "Khác", _ => value ?? "Chưa cập nhật" };
    string MaritalText(string? value) => value?.ToLowerInvariant() switch { "single" => "Độc thân", "married" => "Đã kết hôn", "divorced" => "Đã ly hôn", _ => value ?? "Chưa cập nhật" };
    var completionChecks = isKoc
        ? new[] { !string.IsNullOrWhiteSpace(detail.Phone), !string.IsNullOrWhiteSpace(Model.Location), !string.IsNullOrWhiteSpace(Model.Address), !string.IsNullOrWhiteSpace(Model.Gender), Model.Categories.Count > 0, Model.SocialAccounts.Count > 0, Model.Experience is not null, Model.Capability is not null, Model.Preference is not null, Model.Portfolio.Count > 0 }
        : new[] { !string.IsNullOrWhiteSpace(Model.Brand?.CompanyName), !string.IsNullOrWhiteSpace(Model.Brand?.ContactName), !string.IsNullOrWhiteSpace(Model.Brand?.ContactPhone), !string.IsNullOrWhiteSpace(Model.Brand?.Industry), !string.IsNullOrWhiteSpace(Model.Brand?.Website), !string.IsNullOrWhiteSpace(Model.Address), !string.IsNullOrWhiteSpace(Model.Brand?.TaxCompanyName), !string.IsNullOrWhiteSpace(Model.Brand?.TaxCode), !string.IsNullOrWhiteSpace(Model.Brand?.TaxInvoiceAddress), !string.IsNullOrWhiteSpace(Model.Brand?.BusinessLicenseUrl) };
    var profileCompletion = completionChecks.Count(x => x) * 10;
    var completedProfileGroups = completionChecks.Count(x => x);
    var isProfileApproved = detail.ProfileStatus == "Approved";
    var isProfileNeedUpdate = detail.ProfileStatus == "NeedUpdate";
    var isProfileRejected = detail.ProfileStatus == "Rejected";
    var reviewActionLabel = isProfileApproved ? "Hủy duyệt" : "Xét duyệt";
    var reviewActionHint = isProfileApproved
        ? $"Hủy duyệt sẽ chuyển hồ sơ sang trạng thái cần bổ sung. {(isKoc ? "KOC" : "Brand")} phải cập nhật trước khi được duyệt lại."
        : isProfileNeedUpdate
            ? $"{(isKoc ? "KOC" : "Brand")} đang bổ sung hồ sơ. Admin có thể duyệt hoặc từ chối sau khi kiểm tra."
            : isProfileRejected
                ? "Hồ sơ đã bị từ chối. Admin có thể mở lại yêu cầu bổ sung hoặc duyệt khi đã đủ điều kiện."
                : "Chọn kết quả phù hợp sau khi kiểm tra toàn bộ file hồ sơ.";
    var profileDocumentExtension = string.IsNullOrWhiteSpace(Model.ProfileDocumentUrl) ? null : System.IO.Path.GetExtension(Model.ProfileDocumentUrl).TrimStart('.').ToUpperInvariant();
}
<link rel="stylesheet" href="~/css/admin/account-management.css" asp-append-version="true" />

<div class="account-center-page">
    <header class="account-center-page-header">
        <a class="btn btn-light" href="/Admin/Accounts/@Model.Type"><i class="fa-solid fa-arrow-left"></i> Danh sách @Model.Type</a>
        <div class="account-command-title account-profile-hero"><div class="account-profile-avatar">@if (!string.IsNullOrWhiteSpace(Model.AvatarUrl)) { <a href="@Model.AvatarUrl" target="_blank" rel="noopener" title="Xem ảnh đại diện gốc"><img src="@Model.AvatarUrl" alt="Ảnh đại diện @detail.DisplayName" /></a> } else { <span><i class="fa-solid @(isKoc ? "fa-user" : "fa-building")"></i></span> }<i class="account-profile-avatar-state @(detail.UserStatus == "Locked" ? "is-locked" : "")" title="@StatusText(detail.UserStatus)"></i></div><div><div class="account-profile-eyebrow">HỒ SƠ @Model.Type</div><h1>@detail.DisplayName</h1><small>@detail.Email · Tham gia @detail.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</small><div class="account-center-badges"><b class="@(detail.UserStatus == "Locked" ? "is-danger" : "is-success")"><i class="fa-solid @(detail.UserStatus == "Locked" ? "fa-lock" : "fa-circle-check")"></i> @StatusText(detail.UserStatus)</b><b class="is-purple"><i class="fa-regular fa-id-card"></i> @StatusText(detail.ProfileStatus)</b><b class="@(detail.EmailConfirmed ? "is-success" : "is-warning")"><i class="fa-solid fa-envelope"></i> @(detail.EmailConfirmed ? "Email đã xác minh" : "Email chưa xác minh")</b></div></div></div>
        <div class="account-center-header-actions">@if (isKoc) { <a asp-page="/Koc/TaxProfile" asp-route-id="@Model.ProfileId" class="btn btn-outline-primary"><i class="fa-solid fa-file-invoice"></i> Thuế & CCCD</a><a asp-page="/Admin/KocProfilePreview" asp-route-Id="@Model.ProfileId" class="btn btn-outline-primary"><i class="fa-regular fa-eye"></i> Xem profile KOC</a> } else if (!string.IsNullOrWhiteSpace(Model.Brand?.Website)) { <a href="@Model.Brand.Website" target="_blank" rel="noopener" class="btn btn-outline-primary"><i class="fa-solid fa-arrow-up-right-from-square"></i> Website Brand</a> }<button type="button" class="btn btn-outline-primary" data-select-account-tab="profile"><i class="fa-regular fa-folder-open"></i> Hồ sơ</button><button type="button" class="btn btn-admin-primary" data-select-account-tab="security"><i class="fa-solid fa-headset"></i> Hỗ trợ tài khoản</button></div>
    </header>

    <section class="account-quick-command" aria-label="Hành động nhanh">
        <div class="account-quick-command-title"><span><i class="fa-solid fa-bolt"></i></span><div><strong>Hành động nhanh</strong><small>Đi tới đúng nghiệp vụ mà không cần tìm trong menu.</small></div></div>
        <div class="account-quick-command-list">
            <button type="button" data-bs-toggle="modal" data-bs-target="#profileReviewModal" class="@(isProfileApproved ? "" : "is-priority")"><i class="fa-solid fa-user-check"></i><span>@reviewActionLabel</span></button>
            <button type="button" data-open-account-action="accountLockAction" class="@(detail.UserStatus == "Locked" ? "is-success" : "is-danger")"><i class="fa-solid @(detail.UserStatus == "Locked" ? "fa-lock-open" : "fa-lock")"></i><span>@(detail.UserStatus == "Locked" ? "Mở khóa" : "Khóa tài khoản")</span></button>
            <button type="button" data-select-account-tab="violations" class="@(Model.Violations.Any(x => x.Status == "Active") ? "is-danger" : "")"><i class="fa-solid fa-triangle-exclamation"></i><span>Vi phạm</span>@if (Model.Violations.Any(x => x.Status == "Active")) { <b>@Model.Violations.Count(x => x.Status == "Active")</b> }</button>
            <button type="button" data-select-account-tab="history"><i class="fa-solid fa-clock-rotate-left"></i><span>Lịch sử</span></button>
            <button type="button" class="js-copy-koc-email" data-email="@detail.Email"><i class="fa-regular fa-copy"></i><span>Sao chép email</span></button>
        </div>
    </section>

    <nav class="ts-tabs account-detail-tabs account-center-tabs" role="tablist">
        <button type="button" class="is-active" data-account-tab="overview"><i class="fa-solid fa-chart-pie"></i> Tổng quan</button>
        <button type="button" data-account-tab="profile"><i class="fa-regular fa-id-card"></i> Hồ sơ</button>
        <button type="button" data-account-tab="security"><i class="fa-solid fa-headset"></i> Bảo mật & hỗ trợ</button>
        <button type="button" data-account-tab="violations"><i class="fa-solid fa-triangle-exclamation"></i> Vi phạm</button>
        <button type="button" data-account-tab="history"><i class="fa-solid fa-clock-rotate-left"></i> Lịch sử</button>
    </nav>

    <main class="account-center-page-content">
        <section data-account-panel="overview" class="account-detail-panel is-active">
            <div class="account-center-kpis">@if (isKoc) { <article><span><i class="fa-solid fa-users"></i></span><div><small>Người theo dõi</small><strong>@Model.Followers.ToString("N0")</strong></div></article><article><span><i class="fa-solid fa-handshake"></i></span><div><small>Hợp tác hoàn thành</small><strong>@Model.PerformanceCount</strong></div></article><article><span><i class="fa-solid fa-star"></i></span><div><small>Điểm hồ sơ</small><strong>@Model.EffectiveScore.ToString("0.##")</strong></div></article> } else { <article><span><i class="fa-solid fa-bullhorn"></i></span><div><small>Tổng chiến dịch</small><strong>@Model.BrandCampaigns.Count</strong></div></article><article><span><i class="fa-solid fa-circle-play"></i></span><div><small>Đang vận hành</small><strong>@Model.BrandCampaigns.Count(x => x.Status is "Published" or "InProgress")</strong></div></article><article><span><i class="fa-solid fa-wallet"></i></span><div><small>Tổng ngân sách</small><strong>@Model.EffectiveScore.ToString("N0") đ</strong></div></article> }<article><span><i class="fa-solid fa-shield-halved"></i></span><div><small>Vi phạm hiệu lực</small><strong>@Model.Violations.Count(x => x.Status == "Active")</strong></div></article></div>
            <div class="account-center-grid">
                <section class="account-center-section"><header><div><h2>Thông tin vận hành</h2><p>Dữ liệu Admin cần kiểm tra nhanh khi hỗ trợ @(isKoc ? "KOC" : "Brand").</p></div></header><dl class="account-center-info"><div><dt>@(isKoc ? "Khu vực" : "Ngành hàng")</dt><dd>@(Model.Location ?? "Chưa cập nhật")</dd></div><div><dt>Địa chỉ</dt><dd>@(Model.Address ?? "Chưa cập nhật")</dd></div><div><dt>Số điện thoại</dt><dd>@(detail.Phone ?? "Chưa cập nhật")</dd></div><div><dt>Đăng nhập gần nhất</dt><dd>@(detail.LastLoginAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</dd></div><div><dt>Phiên đang hoạt động</dt><dd>@activeSessions</dd></div><div><dt>@(isKoc ? "Kênh mạng xã hội" : "Chiến dịch")</dt><dd>@(isKoc ? Model.SocialAccounts.Count : Model.BrandCampaigns.Count)</dd></div></dl></section>
                <section class="account-center-section"><header><div><h2>Việc cần chú ý</h2><p>Ưu tiên xử lý trước khi tài khoản tham gia vận hành.</p></div></header><div class="account-center-checklist"><div class="@(detail.EmailConfirmed ? "is-done" : "is-alert")"><i class="fa-solid @(detail.EmailConfirmed ? "fa-circle-check" : "fa-circle-exclamation")"></i><span><strong>Xác minh email</strong><small>@(detail.EmailConfirmed ? "Đã hoàn tất" : $"Cần hỗ trợ {(isKoc ? "KOC" : "Brand")} xác minh")</small></span></div><div class="@(detail.ProfileStatus == "Approved" ? "is-done" : "is-alert")"><i class="fa-solid @(detail.ProfileStatus == "Approved" ? "fa-circle-check" : "fa-circle-exclamation")"></i><span><strong>Duyệt hồ sơ</strong><small>@StatusText(detail.ProfileStatus)</small></span></div><div class="@(completedProfileGroups == 10 ? "is-done" : "is-alert")"><i class="fa-solid @(completedProfileGroups == 10 ? "fa-circle-check" : "fa-circle-exclamation")"></i><span><strong>Độ đầy đủ hồ sơ</strong><small>@completedProfileGroups/10 nhóm dữ liệu</small></span></div><div class="@(Model.Violations.Any(x => x.Status == "Active") ? "is-alert" : "is-done")"><i class="fa-solid @(Model.Violations.Any(x => x.Status == "Active") ? "fa-triangle-exclamation" : "fa-shield-halved")"></i><span><strong>Tuân thủ</strong><small>@(Model.Violations.Any(x => x.Status == "Active") ? "Có vi phạm cần xử lý" : "Không có vi phạm hiệu lực")</small></span></div></div></section>
            </div>
        </section>
        <section data-account-panel="profile" class="account-detail-panel">
            @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="account-operation-message @(Model.MessageSuccess ? "is-success" : "is-error")" role="alert"><i class="fa-solid @(Model.MessageSuccess ? "fa-circle-check" : "fa-circle-exclamation")"></i><div><strong>@(Model.MessageSuccess ? "Đã xử lý hồ sơ" : "Chưa thể duyệt hồ sơ")</strong><span>@Model.Message</span></div></div> }
            @if (isKoc) {
            <section class="account-profile-health"><div class="account-profile-health-main"><div class="account-profile-score @(detail.ProfileStatus == "Approved" ? "is-approved" : "")"><i class="fa-solid @(detail.ProfileStatus == "Approved" ? "fa-circle-check" : "fa-clock")"></i><span>@StatusText(detail.ProfileStatus)</span></div><div><h2>File hồ sơ KOC</h2><p>Đã khai báo @completedProfileGroups/10 nhóm dữ liệu quan trọng. @(detail.ProfileStatus == "Approved" ? "Hồ sơ đã được Admin duyệt và sẵn sàng ghép chiến dịch." : "Hồ sơ đang cần Admin kiểm tra trước khi ghép chiến dịch.")</p><div class="account-profile-progress" title="Độ phủ dữ liệu @profileCompletion%"><i style="width:@profileCompletion%"></i></div></div></div><div class="account-profile-health-stats"><div class="is-cyan"><small>Độ phủ dữ liệu</small><strong>@completedProfileGroups/10 nhóm</strong></div><div class="is-amber"><small>Điểm hồ sơ</small><strong>@Model.EffectiveScore.ToString("0.##")</strong></div><div class="is-green"><small>Kênh xã hội</small><strong>@Model.SocialAccounts.Count</strong></div><div class="is-pink"><small>Portfolio</small><strong>@Model.Portfolio.Count</strong></div></div></section>
            <section class="account-profile-document @(string.IsNullOrWhiteSpace(Model.ProfileDocumentUrl) ? "is-empty" : "")"><span><i class="fa-solid @(profileDocumentExtension == "PDF" ? "fa-file-pdf" : profileDocumentExtension is "DOC" or "DOCX" ? "fa-file-word" : "fa-file-image")"></i></span><div><small>HỒ SƠ NĂNG LỰC KOC TẢI LÊN</small><strong>@(string.IsNullOrWhiteSpace(Model.ProfileDocumentUrl) ? "KOC chưa tải lên tài liệu" : $"Tài liệu {profileDocumentExtension}")</strong><p>@(string.IsNullOrWhiteSpace(Model.ProfileDocumentUrl) ? "Admin có thể yêu cầu KOC bổ sung file PDF, Word hoặc hình ảnh." : "Mở tài liệu gốc để đối chiếu trước khi xét duyệt hồ sơ.")</p></div>@if (!string.IsNullOrWhiteSpace(Model.ProfileDocumentUrl)) { <div class="account-profile-document-actions"><a href="@Model.ProfileDocumentUrl" target="_blank" rel="noopener" class="is-view"><i class="fa-solid fa-eye"></i> Xem file</a><a href="@Model.ProfileDocumentUrl" download><i class="fa-solid fa-download"></i> Tải xuống</a></div> }</section>
            <div class="account-center-grid account-center-section-spaced">
                <section class="account-center-section"><header><div><span class="account-section-kicker"><i class="fa-solid fa-address-card"></i> THÔNG TIN CƠ BẢN</span><h2>Thông tin cá nhân & liên hệ</h2><p>Dữ liệu định danh và giao nhận KOC đã khai báo.</p></div></header><dl class="account-center-info"><div><dt>Họ tên hiển thị</dt><dd>@detail.DisplayName</dd></div><div><dt>Giới tính</dt><dd>@GenderText(Model.Gender)</dd></div><div><dt>Email</dt><dd>@detail.Email</dd></div><div><dt>Số điện thoại</dt><dd>@(detail.Phone ?? "Chưa cập nhật")</dd></div><div><dt>Khu vực</dt><dd>@(Model.Location ?? "Chưa cập nhật")</dd></div><div><dt>Địa chỉ giao nhận</dt><dd>@(Model.Address ?? "Chưa cập nhật")</dd></div></dl></section>
                <section class="account-center-section"><header><div><h2>Danh mục nội dung</h2><p>Lĩnh vực KOC nhận sản xuất và hợp tác.</p></div></header>@if (Model.Categories.Count == 0) { <div class="account-detail-empty compact">Chưa chọn danh mục.</div> } else { <div class="account-profile-tags">@foreach (var category in Model.Categories) { <span><i class="fa-solid fa-tag"></i> @category</span> }</div> } @if (!string.IsNullOrWhiteSpace(Model.ReviewNote)) { <div class="account-review-note"><strong><i class="fa-solid fa-note-sticky"></i> Ghi chú xét duyệt</strong><p>@Model.ReviewNote</p></div> }</section>
            </div>
            <div class="account-profile-detail-grid account-center-section-spaced">
                <section class="account-center-section"><header><div><span class="account-section-kicker"><i class="fa-solid fa-ruler-combined"></i> TARGETING</span><h2>Thông tin hình thể</h2><p>Phục vụ chiến dịch thời trang, làm đẹp và gia đình.</p></div></header>@if (Model.Body is null) { <div class="account-detail-empty compact">Chưa cập nhật thông tin hình thể.</div> } else { <dl class="account-center-info"><div><dt>Chiều cao</dt><dd>@(Model.Body.HeightCm?.ToString("0.#") ?? "—") cm</dd></div><div><dt>Cân nặng</dt><dd>@(Model.Body.WeightKg?.ToString("0.#") ?? "—") kg</dd></div><div><dt>Hôn nhân</dt><dd>@MaritalText(Model.Body.MaritalStatus)</dd></div><div><dt>Con nhỏ</dt><dd>@(Model.Body.HasChildren ? $"Có · {Model.Body.ChildrenCount} bé" : "Không")</dd></div></dl> }</section>
                <section class="account-center-section"><header><div><h2>Kinh nghiệm</h2><p>Nền tảng làm việc và thương hiệu từng hợp tác.</p></div></header>@if (Model.Experience is null) { <div class="account-detail-empty compact">Chưa cập nhật kinh nghiệm.</div> } else { <dl class="account-center-info single"><div><dt>Số năm kinh nghiệm</dt><dd>@(Model.Experience.Years?.ToString("0.#") ?? "Chưa cập nhật")</dd></div><div><dt>Brand từng hợp tác</dt><dd>@(Model.Experience.WorkedBrands ?? "Chưa cập nhật")</dd></div><div><dt>Case study</dt><dd>@if (!string.IsNullOrWhiteSpace(Model.Experience.CaseStudyUrl)) { <a href="@Model.Experience.CaseStudyUrl" target="_blank" rel="noopener">Mở liên kết <i class="fa-solid fa-arrow-up-right-from-square"></i></a> } else { <span>Chưa cập nhật</span> }</dd></div></dl> }</section>
                <section class="account-center-section"><header><div><h2>Năng lực sản xuất</h2><p>Khả năng tự triển khai nội dung của KOC.</p></div></header>@if (Model.Capability is null) { <div class="account-detail-empty compact">Chưa cập nhật năng lực.</div> } else { <div class="account-capability-list"><span class="@(Model.Capability.CanScript ? "is-ready" : "")"><i class="fa-solid fa-pen-nib"></i> Viết kịch bản</span><span class="@(Model.Capability.CanShoot ? "is-ready" : "")"><i class="fa-solid fa-camera"></i> Quay nội dung</span><span class="@(Model.Capability.CanEdit ? "is-ready" : "")"><i class="fa-solid fa-scissors"></i> Dựng video</span><span class="@(Model.Capability.CanLivestream ? "is-ready" : "")"><i class="fa-solid fa-video"></i> Livestream</span></div><div class="account-inline-note"><small>Thiết bị</small><strong>@(Model.Capability.Devices ?? "Chưa cập nhật")</strong></div> }</section>
                <section class="account-center-section"><header><div><h2>Mong muốn công việc</h2><p>Ngân sách, khu vực và thời gian có thể nhận việc.</p></div></header>@if (Model.Preference is null) { <div class="account-detail-empty compact">Chưa cập nhật mong muốn công việc.</div> } else { <dl class="account-center-info single"><div><dt>Ngân sách tối thiểu</dt><dd>@(Model.Preference.MinBudget.HasValue ? Model.Preference.MinBudget.Value.ToString("N0") + " đ" : "Chưa cập nhật")</dd></div><div><dt>Khu vực ưu tiên</dt><dd>@(Model.Preference.Regions ?? "Chưa cập nhật")</dd></div><div><dt>Khả dụng</dt><dd>@(Model.Preference.Availability ?? "Chưa cập nhật")</dd></div></dl> }</section>
            </div>
            <section class="account-center-section account-center-section-spaced"><header><div><h2>Kênh mạng xã hội</h2><p>Kiểm tra quy mô và trạng thái xác minh của từng kênh.</p></div></header>@if (Model.SocialAccounts.Count == 0) { <div class="account-detail-empty">KOC chưa cập nhật kênh mạng xã hội.</div> } else { <div class="account-social-grid">@foreach (var social in Model.SocialAccounts) { <article><span><i class="fa-solid fa-share-nodes"></i></span><div><strong>@social.Platform @(social.IsPrimary ? "· Kênh chính" : "")</strong><small>@(social.Handle ?? social.ChannelUrl)</small><p>@social.Followers.ToString("N0") followers · @((social.EngagementRate ?? 0).ToString("0.##"))% tương tác</p></div><b class="@(social.IsVerified ? "is-verified" : "")"><i class="fa-solid @(social.IsVerified ? "fa-circle-check" : "fa-clock")"></i></b></article> }</div> }</section>
            <section class="account-center-section account-center-section-spaced"><header><div><h2>Portfolio & nội dung tiêu biểu</h2><p>Sản phẩm KOC đã khai báo để Brand đánh giá.</p></div></header>@if (Model.Portfolio.Count == 0) { <div class="account-detail-empty">Chưa có portfolio.</div> } else { <div class="account-portfolio-grid">@foreach (var item in Model.Portfolio) { <article><div><strong>@item.Title</strong><small>@(item.Platform ?? "Nền tảng chưa rõ") · @(item.Brand ?? item.Campaign ?? "Nội dung cá nhân")</small></div><p><span><i class="fa-solid fa-eye"></i> @item.Views.ToString("N0")</span><span><i class="fa-solid fa-heart"></i> @item.Likes.ToString("N0")</span><span><i class="fa-solid fa-comment"></i> @item.Comments.ToString("N0")</span></p>@if (!string.IsNullOrWhiteSpace(item.Url)) { <a href="@item.Url" target="_blank" rel="noopener">Xem nội dung <i class="fa-solid fa-arrow-up-right-from-square"></i></a> }</article> }</div> }</section>
            @if (Model.MediaAssets.Count > 0) { <section class="account-center-section account-center-section-spaced"><header><div><h2>Thư viện hình ảnh</h2><p>Tài sản media trong hồ sơ KOC.</p></div></header><div class="account-media-grid">@foreach (var media in Model.MediaAssets) { <a href="@media.Url" target="_blank" rel="noopener"><img src="@media.Url" alt="@media.Type" loading="lazy" /><span>@media.Type</span></a> }</div></section> }
            <section class="account-center-section account-center-section-spaced"><header><div><h2>Lịch sử hợp tác</h2><p>Các chiến dịch KOC đã hoặc đang tham gia.</p></div></header>@if (Model.Collaborations.Count == 0) { <div class="account-detail-empty">Chưa phát sinh hợp tác.</div> } else { <div class="table-responsive"><table class="table account-detail-table"><thead><tr><th>Chiến dịch</th><th>Brand</th><th>Trạng thái</th><th>Tham gia</th></tr></thead><tbody>@foreach (var item in Model.Collaborations) { <tr><td><strong>@item.CampaignName</strong></td><td>@item.BrandName</td><td>@StatusText(item.Status)</td><td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy")</td></tr> }</tbody></table></div> }</section>
            } else {
                var brand = Model.Brand!;
                <section class="account-profile-health"><div class="account-profile-health-main"><div class="account-profile-score @(detail.ProfileStatus == "Approved" ? "is-approved" : "")"><i class="fa-solid @(detail.ProfileStatus == "Approved" ? "fa-circle-check" : "fa-clock")"></i><span>@StatusText(detail.ProfileStatus)</span></div><div><h2>Hồ sơ doanh nghiệp</h2><p>Đã khai báo @completedProfileGroups/10 nhóm dữ liệu pháp lý và vận hành. Hồ sơ đầy đủ giúp Brand mở chiến dịch và làm việc với KOC.</p><div class="account-profile-progress" title="Độ phủ dữ liệu @profileCompletion%"><i style="width:@profileCompletion%"></i></div></div></div><div class="account-profile-health-stats"><div class="is-cyan"><small>Độ phủ dữ liệu</small><strong>@completedProfileGroups/10 nhóm</strong></div><div class="is-amber"><small>Chiến dịch</small><strong>@Model.BrandCampaigns.Count</strong></div><div class="is-green"><small>Hoàn thành</small><strong>@Model.PerformanceCount</strong></div><div class="is-pink"><small>Tổng ngân sách</small><strong>@Model.EffectiveScore.ToString("N0") đ</strong></div></div></section>
                <section class="account-profile-document @(string.IsNullOrWhiteSpace(brand.BusinessLicenseUrl) ? "is-empty" : "")"><span><i class="fa-solid fa-file-shield"></i></span><div><small>HỒ SƠ PHÁP LÝ</small><strong>@(string.IsNullOrWhiteSpace(brand.BusinessLicenseUrl) ? "Chưa tải giấy phép kinh doanh" : "Giấy phép kinh doanh")</strong><p>@(string.IsNullOrWhiteSpace(brand.BusinessLicenseUrl) ? "Yêu cầu Brand bổ sung tài liệu trước khi duyệt." : "Mở tài liệu để đối chiếu tên pháp nhân và mã số thuế.")</p></div>@if (!string.IsNullOrWhiteSpace(brand.BusinessLicenseUrl)) { <div class="account-profile-document-actions"><a href="@brand.BusinessLicenseUrl" target="_blank" rel="noopener" class="is-view"><i class="fa-solid fa-eye"></i> Xem giấy phép</a><a href="@brand.BusinessLicenseUrl" download><i class="fa-solid fa-download"></i> Tải xuống</a></div> }</section>
                <div class="account-center-grid account-center-section-spaced"><section class="account-center-section"><header><div><span class="account-section-kicker"><i class="fa-solid fa-building"></i> DOANH NGHIỆP</span><h2>Thông tin Brand</h2><p>Thông tin nhận diện và đầu mối vận hành.</p></div></header><dl class="account-center-info"><div><dt>Tên Brand</dt><dd>@brand.CompanyName</dd></div><div><dt>Ngành hàng</dt><dd>@(brand.Industry ?? "Chưa cập nhật")</dd></div><div><dt>Người liên hệ</dt><dd>@(brand.ContactName ?? "Chưa cập nhật")</dd></div><div><dt>Điện thoại liên hệ</dt><dd>@(brand.ContactPhone ?? "Chưa cập nhật")</dd></div><div><dt>Website</dt><dd>@if (!string.IsNullOrWhiteSpace(brand.Website)) { <a href="@brand.Website" target="_blank" rel="noopener">@brand.Website <i class="fa-solid fa-arrow-up-right-from-square"></i></a> } else { <span>Chưa cập nhật</span> }</dd></div><div><dt>Địa chỉ</dt><dd>@(Model.Address ?? "Chưa cập nhật")</dd></div></dl></section><section class="account-center-section"><header><div><span class="account-section-kicker"><i class="fa-solid fa-scale-balanced"></i> PHÁP LÝ & THUẾ</span><h2>Thông tin pháp nhân</h2><p>Dữ liệu phục vụ hợp đồng và xuất hóa đơn.</p></div></header><dl class="account-center-info single"><div><dt>Tên công ty xuất hóa đơn</dt><dd>@(brand.TaxCompanyName ?? "Chưa cập nhật")</dd></div><div><dt>Mã số thuế</dt><dd>@(brand.TaxCode ?? "Chưa cập nhật")</dd></div><div><dt>Địa chỉ hóa đơn</dt><dd>@(brand.TaxInvoiceAddress ?? "Chưa cập nhật")</dd></div></dl>@if (!string.IsNullOrWhiteSpace(Model.ReviewNote)) { <div class="account-review-note"><strong><i class="fa-solid fa-note-sticky"></i> Ghi chú xét duyệt</strong><p>@Model.ReviewNote</p></div> }</section></div>
                <section class="account-center-section account-center-section-spaced"><header><div><h2>Danh sách chiến dịch</h2><p>Hoạt động Brand đã tạo trên hệ thống.</p></div></header>@if (Model.BrandCampaigns.Count == 0) { <div class="account-detail-empty">Brand chưa tạo chiến dịch.</div> } else { <div class="table-responsive"><table class="table account-detail-table"><thead><tr><th>Chiến dịch</th><th>Ngân sách</th><th>KOC cần</th><th>Trạng thái</th><th>Thời gian</th></tr></thead><tbody>@foreach (var item in Model.BrandCampaigns) { <tr><td><strong>@item.Title</strong></td><td>@item.Budget.ToString("N0") đ</td><td>@item.DesiredKocCount</td><td>@StatusText(item.Status)</td><td>@(item.StartDate?.ToString("dd/MM/yyyy") ?? "—") → @(item.EndDate?.ToString("dd/MM/yyyy") ?? "—")</td></tr> }</tbody></table></div> }</section>
            }
        </section>
        <section data-account-panel="security" class="account-detail-panel">
            @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="account-operation-message @(Model.MessageSuccess ? "is-success" : "is-error")"><i class="fa-solid @(Model.MessageSuccess ? "fa-circle-check" : "fa-circle-exclamation")"></i> @Model.Message</div> }
            <header class="account-panel-intro"><div><span>BẢO MẬT & HỖ TRỢ</span><h2>Kiểm soát quyền truy cập @(isKoc ? "KOC" : "Brand")</h2><p>Admin xử lý xác minh, khóa tài khoản, phiên đăng nhập và ghi chú hỗ trợ ngay tại đây.</p></div><i class="fa-solid fa-user-shield"></i></header>
            <div class="account-security-overview"><article class="is-green"><span><i class="fa-solid fa-envelope-circle-check"></i></span><div><small>Xác minh email</small><strong>@(detail.EmailConfirmed ? "Đã hoàn tất" : "Cần xử lý")</strong><p>@detail.Email</p></div></article><article class="is-blue"><span><i class="fa-solid fa-mobile-screen"></i></span><div><small>Xác minh điện thoại</small><strong>@(detail.PhoneConfirmed ? "Đã hoàn tất" : "Chưa xác minh")</strong><p>@(detail.Phone ?? "Chưa có số điện thoại")</p></div></article><article class="is-orange"><span><i class="fa-solid fa-clock"></i></span><div><small>Đăng nhập gần nhất</small><strong>@(detail.LastLoginAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa đăng nhập")</strong><p>@successfulLoginCount lượt thành công gần đây</p></div></article><article class="@(detail.UserStatus == "Locked" || !detail.EmailConfirmed ? "is-red" : "is-purple")"><span><i class="fa-solid @(detail.UserStatus == "Locked" || !detail.EmailConfirmed ? "fa-lock" : "fa-lock-open")"></i></span><div><small>Quyền truy cập</small><strong>@(detail.UserStatus == "Locked" ? "Đã khóa" : detail.EmailConfirmed ? "Có thể đăng nhập" : "Chờ xác minh email")</strong><p>@(detail.UserStatus == "Locked" ? $"{(isKoc ? "KOC" : "Brand")} không thể đăng nhập" : !detail.EmailConfirmed ? "Phải xác minh email trước khi đăng nhập" : $"{(isKoc ? "KOC" : "Brand")} có thể sử dụng tài khoản")</p></div></article></div>
            <section class="account-security-actions"><header><h2>Thao tác quản trị</h2><p>Mỗi thay đổi đều yêu cầu căn cứ và được lưu vào nhật ký kiểm toán.</p></header><div class="account-security-action-grid">
                <details class="is-green" @(!detail.EmailConfirmed ? "open" : null)><summary><span><i class="fa-solid fa-envelope-circle-check"></i></span><div><strong>Xác minh email thay @(isKoc ? "KOC" : "Brand")</strong><small>@(detail.EmailConfirmed ? "Email đã được xác minh" : "Dùng khi Admin đã đối chiếu đúng chủ tài khoản")</small></div><i class="fa-solid fa-chevron-down"></i></summary>@if (!detail.EmailConfirmed) { <form method="post" asp-page-handler="VerifyEmail" class="js-secure-action-form" novalidate><label>Căn cứ xác minh <em>*</em></label><textarea name="reason" data-min-length="10" maxlength="1000" rows="3" placeholder="Ví dụ: Đã đối chiếu qua cuộc gọi hỗ trợ ngày..."></textarea><small class="account-field-hint"><span>0</span>/1000 · tối thiểu 10 ký tự</small><button type="submit" disabled><i class="fa-solid fa-check"></i> Xác nhận email</button></form> }</details>
                <details id="accountLockAction" class="is-red"><summary><span><i class="fa-solid @(detail.UserStatus == "Locked" ? "fa-lock-open" : "fa-lock")"></i></span><div><strong>@(detail.UserStatus == "Locked" ? "Khôi phục tài khoản" : "Khóa quyền truy cập")</strong><small>@(detail.UserStatus == "Locked" ? $"Mở lại quyền sử dụng cho {(isKoc ? "KOC" : "Brand")}" : "Ngăn đăng nhập nhưng giữ toàn bộ dữ liệu")</small></div><i class="fa-solid fa-chevron-down"></i></summary><form method="post" asp-page-handler="ToggleLock" class="js-secure-action-form" novalidate><input type="hidden" name="locked" value="@(detail.UserStatus != "Locked" ? "true" : "false")" /><label>Lý do xử lý <em>*</em></label><textarea name="reason" data-min-length="10" maxlength="1000" rows="3" placeholder="Nhập lý do và căn cứ xử lý..."></textarea><small class="account-field-hint"><span>0</span>/1000 · tối thiểu 10 ký tự</small><button type="submit" disabled><i class="fa-solid @(detail.UserStatus == "Locked" ? "fa-lock-open" : "fa-lock")"></i> @(detail.UserStatus == "Locked" ? "Xác nhận khôi phục" : "Xác nhận khóa")</button></form></details>
                <details class="is-orange"><summary><span><i class="fa-solid fa-right-from-bracket"></i></span><div><strong>Thu hồi phiên token</strong><small>@activeSessions phiên token có thể thu hồi · Không tính phiên cookie trên website</small></div><i class="fa-solid fa-chevron-down"></i></summary><form method="post" asp-page-handler="RevokeSessions" class="js-secure-action-form" data-disabled="@(activeSessions == 0 ? "true" : "false")" novalidate><label>Lý do thu hồi <em>*</em></label><textarea name="reason" data-min-length="10" maxlength="1000" rows="3" placeholder="Ví dụ: KOC báo mất thiết bị..."></textarea><small class="account-field-hint"><span>0</span>/1000 · tối thiểu 10 ký tự</small><button type="submit" disabled><i class="fa-solid fa-right-from-bracket"></i> Thu hồi tất cả phiên token</button></form></details>
                <details class="is-blue"><summary><span><i class="fa-solid fa-note-sticky"></i></span><div><strong>Ghi chú hỗ trợ nội bộ</strong><small>Lưu nội dung trao đổi để Admin khác tiếp tục xử lý</small></div><i class="fa-solid fa-chevron-down"></i></summary><form method="post" asp-page-handler="AddNote" class="js-secure-action-form" novalidate><label>Nội dung ghi chú <em>*</em></label><textarea name="body" data-min-length="3" maxlength="2000" rows="3" placeholder="Nội dung đã trao đổi, vấn đề và bước tiếp theo..."></textarea><small class="account-field-hint"><span>0</span>/2000 · tối thiểu 3 ký tự</small><button type="submit" disabled><i class="fa-solid fa-floppy-disk"></i> Lưu ghi chú</button></form></details>
            </div></section>
            <div class="account-security-columns"><section class="account-center-section js-client-list" data-list-name="đăng nhập"><header><div><h2>Lịch sử đăng nhập</h2><p>Lấy từ nhật ký xác thực thực tế của website.</p></div></header><div class="account-list-filter"><label><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-list-search placeholder="Tìm IP hoặc trình duyệt" /></label><select data-list-status aria-label="Lọc kết quả đăng nhập"><option value="">Tất cả trạng thái</option><option value="Success">Thành công</option><option value="Failed">Thất bại</option><option value="Blocked">Bị chặn</option></select><select data-list-size aria-label="Số dòng đăng nhập"><option value="5">5 dòng</option><option value="10">10 dòng</option><option value="20">20 dòng</option></select></div><div data-list-items>@foreach (var login in loginEvents) { var loginLabel = login.EventStatus == "Success" ? "Thành công" : login.EventStatus == "Blocked" ? "Bị chặn" : "Thất bại"; <article class="account-detail-event" data-list-item data-status="@login.EventStatus" data-search="@login.IpAddress @login.UserAgent @loginLabel"><span class="@(login.EventStatus == "Success" ? "is-success" : "is-danger")"><i class="fa-solid @(login.EventStatus == "Success" ? "fa-right-to-bracket" : "fa-circle-exclamation")"></i></span><div><strong>Đăng nhập @loginLabel.ToLowerInvariant()</strong><small>@(login.IpAddress ?? "Không rõ IP") · @login.OccurredAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>@if (!string.IsNullOrWhiteSpace(login.UserAgent)) { <small class="account-login-agent">@login.UserAgent</small> }@if (!string.IsNullOrWhiteSpace(login.FailureReason)) { <small>@login.FailureReason</small> }</div><b>@loginLabel</b></article> }</div><div class="account-list-empty" data-list-empty hidden>Không có dữ liệu phù hợp bộ lọc.</div><footer class="account-list-footer"><span data-list-summary></span><nav data-list-pager aria-label="Phân trang lịch sử đăng nhập"></nav></footer></section><section class="account-center-section js-client-list" data-list-name="ghi chú"><header><div><h2>Ghi chú hỗ trợ</h2><p>Lịch sử phối hợp nội bộ giữa các Admin.</p></div></header><div class="account-list-filter is-notes"><label><i class="fa-solid fa-magnifying-glass"></i><input type="search" data-list-search placeholder="Tìm nội dung hoặc Admin" /></label><select data-list-size aria-label="Số dòng ghi chú"><option value="5">5 dòng</option><option value="10">10 dòng</option><option value="20">20 dòng</option></select></div><div data-list-items>@foreach (var note in detail.Notes) { <article class="account-support-note" data-list-item data-search="@note.Body @note.ActorEmail"><p>@note.Body</p><small>@(note.ActorEmail ?? "Admin") · @note.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></article> }</div><div class="account-list-empty" data-list-empty hidden>Không có ghi chú phù hợp bộ lọc.</div><footer class="account-list-footer"><span data-list-summary></span><nav data-list-pager aria-label="Phân trang ghi chú hỗ trợ"></nav></footer></section></div>
        </section>
        <section data-account-panel="violations" class="account-detail-panel">
            @if (Model.Violations.Count == 0) { <div class="account-detail-empty"><i class="fa-solid fa-circle-check"></i> Tài khoản chưa có vi phạm.</div> }
            @foreach (var item in Model.Violations) { <article class="account-detail-event"><span class="is-danger"><i class="fa-solid fa-triangle-exclamation"></i></span><div><strong>@item.Category</strong><small>@item.Severity · @item.PenaltyPoints điểm · @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div><b>@item.Status</b></article> }
            <div class="account-detail-actions"><a class="btn btn-outline-danger" href="/Admin/Violations?accountUserId=@Model.UserId&returnType=@Model.Type"><i class="fa-solid fa-triangle-exclamation"></i> Quản lý vi phạm</a></div>
        </section>
        <section data-account-panel="history" class="account-detail-panel">
            @if (detail.AuditLogs.Count == 0) { <div class="account-detail-empty">Chưa có lịch sử kiểm toán.</div> }
            @foreach (var item in detail.AuditLogs) { <article class="account-detail-event"><span><i class="fa-solid fa-clock-rotate-left"></i></span><div><strong>@item.ActionName</strong><small>@(item.ActorEmail ?? "Hệ thống") · @item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></div></article> }
        </section>
    </main>
</div>

<div class="modal fade account-review-modal" id="profileReviewModal" tabindex="-1" aria-labelledby="profileReviewModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form method="post" asp-page-handler="ReviewProfile" class="js-secure-action-form" novalidate>
                <input type="hidden" name="ReviewProfileId" value="@Model.ProfileId" />
                <div class="modal-header">
                    <div class="account-review-modal-title"><span><i class="fa-solid @(isProfileApproved ? "fa-user-xmark" : "fa-user-check")"></i></span><div><small>@(isProfileApproved ? "HỦY DUYỆT HỒ SƠ" : "XÉT DUYỆT FILE HỒ SƠ")</small><h2 id="profileReviewModalTitle">@detail.DisplayName</h2><p>Trạng thái hiện tại: <b>@StatusText(detail.ProfileStatus)</b></p></div></div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="account-review-modal-summary"><span><i class="fa-solid fa-layer-group"></i><b>@completedProfileGroups/10</b><small>nhóm dữ liệu</small></span><span><i class="fa-solid @(isKoc ? "fa-star" : "fa-bullhorn")"></i><b>@(isKoc ? Model.EffectiveScore.ToString("0.##") : Model.BrandCampaigns.Count)</b><small>@(isKoc ? "điểm hồ sơ" : "chiến dịch")</small></span><span><i class="fa-solid @(isKoc ? "fa-share-nodes" : "fa-file-shield")"></i><b>@(isKoc ? Model.SocialAccounts.Count : (string.IsNullOrWhiteSpace(Model.Brand?.BusinessLicenseUrl) ? 0 : 1))</b><small>@(isKoc ? "kênh xã hội" : "giấy phép")</small></span></div>
                    <div class="account-review-modal-context @(isProfileApproved ? "is-approved" : isProfileRejected ? "is-rejected" : "is-pending")"><i class="fa-solid @(isProfileApproved ? "fa-circle-check" : isProfileRejected ? "fa-circle-xmark" : "fa-circle-info")"></i><span>@reviewActionHint</span></div>
                    @if (isKoc && !isProfileApproved && completedProfileGroups < 10) { <div class="account-review-incomplete-warning" role="alert"><i class="fa-solid fa-triangle-exclamation"></i><div><strong>Hồ sơ KOC chưa đầy đủ (@completedProfileGroups/10 nhóm dữ liệu)</strong><span>Admin vẫn có thể duyệt nếu đã xác minh đủ căn cứ. Các mục còn thiếu sẽ được ghi vào nhật ký kiểm toán để tiếp tục theo dõi.</span></div></div> }
                    <label for="profileReviewNote">@(isProfileApproved ? "Lý do hủy duyệt" : "Căn cứ xử lý") <em>*</em></label>
                    <textarea id="profileReviewNote" name="reviewNote" data-min-length="10" maxlength="1000" rows="4" placeholder="@(isProfileApproved ? $"Nhập lý do {(isKoc ? "KOC" : "Brand")} cần bổ sung lại hồ sơ..." : "Nhập nhận xét và căn cứ duyệt hồ sơ...")"></textarea>
                    <small class="account-field-hint"><span>0</span>/1000 · tối thiểu 10 ký tự</small>
                    <p class="account-review-modal-help"><i class="fa-solid fa-circle-info"></i> Quyết định và căn cứ sẽ được lưu vào nhật ký kiểm toán.</p>
                </div>
                <div class="modal-footer account-review-buttons">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i> Hủy</button>
                    @if (!isProfileApproved && !isProfileRejected) { <button type="submit" name="decision" value="Rejected" disabled class="is-reject"><i class="fa-solid fa-circle-xmark"></i> Từ chối</button> }
                    @if (!isProfileNeedUpdate) { <button type="submit" name="decision" value="NeedUpdate" disabled class="is-update"><i class="fa-solid @(isProfileApproved ? "fa-user-xmark" : "fa-pen-to-square")"></i> @(isProfileApproved ? "Xác nhận hủy duyệt" : "Yêu cầu bổ sung")</button> }
                    @if (!isProfileApproved) { <button type="submit" name="decision" value="Approved" disabled class="is-approve"><i class="fa-solid fa-circle-check"></i> Duyệt hồ sơ</button> }
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('click', function (event) {
    const actionShortcut = event.target.closest('[data-open-account-action]');
    if (actionShortcut) {
        const tab = 'security';
        document.querySelectorAll('[data-account-tab]').forEach(x => x.classList.toggle('is-active', x.dataset.accountTab === tab));
        document.querySelectorAll('[data-account-panel]').forEach(x => x.classList.toggle('is-active', x.dataset.accountPanel === tab));
        const action = document.getElementById(actionShortcut.dataset.openAccountAction);
        if (action) {
            action.open = true;
            action.scrollIntoView({ behavior: 'smooth', block: 'center' });
            window.setTimeout(() => action.querySelector('textarea')?.focus(), 450);
        }
        return;
    }
    const button = event.target.closest('[data-account-tab]');
    const shortcut = event.target.closest('[data-select-account-tab]');
    if (button || shortcut) {
        const tab = button ? button.dataset.accountTab : shortcut.dataset.selectAccountTab;
        document.querySelectorAll('[data-account-tab]').forEach(x => x.classList.toggle('is-active', x.dataset.accountTab === tab));
        document.querySelectorAll('[data-account-panel]').forEach(x => x.classList.toggle('is-active', x.dataset.accountPanel === tab));
        if (shortcut) document.querySelector('.account-center-tabs').scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
    }
    const copy = event.target.closest('.js-copy-koc-email');
    if (copy) navigator.clipboard.writeText(copy.dataset.email).then(function () { copy.classList.add('is-copied'); copy.querySelector('span').textContent = 'Đã sao chép'; window.setTimeout(function () { copy.classList.remove('is-copied'); copy.querySelector('span').textContent = 'Sao chép email'; }, 1600); });
});
if (window.location.hash === '#security' || window.location.hash === '#profile') {
    document.querySelector('[data-account-tab="' + window.location.hash.slice(1) + '"]')?.click();
}
document.querySelectorAll('.js-secure-action-form').forEach(function (form) {
    const field = form.querySelector('textarea');
    const submits = Array.from(form.querySelectorAll('button[type="submit"]'));
    const count = form.querySelector('.account-field-hint span');
    const min = Number(field.dataset.minLength || 1);
    const locked = form.dataset.disabled === 'true';
    function updateState() {
        const length = field.value.trim().length;
        count.textContent = field.value.length;
        submits.forEach(function (submit) { submit.disabled = locked || length < min; });
        form.classList.toggle('is-ready', submits.some(function (submit) { return !submit.disabled; }));
    }
    field.addEventListener('input', updateState);
    updateState();
});
document.querySelectorAll('.js-client-list').forEach(function (list) {
    const items = Array.from(list.querySelectorAll('[data-list-item]'));
    const search = list.querySelector('[data-list-search]');
    const status = list.querySelector('[data-list-status]');
    const size = list.querySelector('[data-list-size]');
    const pager = list.querySelector('[data-list-pager]');
    const summary = list.querySelector('[data-list-summary]');
    const empty = list.querySelector('[data-list-empty]');
    let page = 1;
    function normalize(value) { return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase(); }
    function render() {
        const query = normalize(search?.value);
        const state = status?.value || '';
        const pageSize = Number(size?.value || 5);
        const filtered = items.filter(function (item) { return (!query || normalize(item.dataset.search).includes(query)) && (!state || item.dataset.status === state); });
        const pages = Math.max(1, Math.ceil(filtered.length / pageSize));
        page = Math.min(page, pages);
        items.forEach(function (item) { item.hidden = true; });
        filtered.slice((page - 1) * pageSize, page * pageSize).forEach(function (item) { item.hidden = false; });
        empty.hidden = filtered.length !== 0;
        const start = filtered.length ? (page - 1) * pageSize + 1 : 0;
        const end = Math.min(page * pageSize, filtered.length);
        summary.textContent = 'Hiển thị ' + start + '–' + end + ' / ' + filtered.length + ' kết quả';
        pager.innerHTML = '';
        const add = function (label, target, disabled, active) { const button = document.createElement('button'); button.type = 'button'; button.innerHTML = label; button.disabled = disabled; button.classList.toggle('is-active', active); button.addEventListener('click', function () { page = target; render(); }); pager.appendChild(button); };
        add('<i class="fa-solid fa-chevron-left"></i>', page - 1, page === 1, false);
        for (let value = Math.max(1, page - 1); value <= Math.min(pages, page + 1); value++) add(String(value), value, false, value === page);
        add('<i class="fa-solid fa-chevron-right"></i>', page + 1, page === pages, false);
    }
    [search, status, size].filter(Boolean).forEach(function (control) { control.addEventListener(control === search ? 'input' : 'change', function () { page = 1; render(); }); });
    render();
});
</script>
}
