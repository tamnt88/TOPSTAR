@page
@model Topstar.Web.Pages.Koc.EditProfileModel
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ KOC";
}

<div class="page-wrap card-list">
    <h1 class="section-title mb-0">Chỉnh sửa hồ sơ KOC</h1>

    <div class="card-x">
        <form method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
            @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
            {
                <div class="alert alert-danger py-2">@Model.ErrorMessage</div>
            }

            <ul class="nav nav-tabs mb-4" id="kocEditTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-basic" data-bs-toggle="tab" data-bs-target="#pane-basic" type="button" role="tab" aria-controls="pane-basic" aria-selected="true">Thông tin cơ bản</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-social" data-bs-toggle="tab" data-bs-target="#pane-social" type="button" role="tab" aria-controls="pane-social" aria-selected="false">Mạng xã hội</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-personal" data-bs-toggle="tab" data-bs-target="#pane-personal" type="button" role="tab" aria-controls="pane-personal" aria-selected="false">Thông tin cá nhân</button>
                </li>
            </ul>

            <div class="tab-content" id="kocEditTabsContent">
                <div class="tab-pane fade show active" id="pane-basic" role="tabpanel" aria-labelledby="tab-basic" tabindex="0">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Input.FullName" class="form-label">Họ và tên</label>
                            <input asp-for="Input.FullName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.Email" class="form-label">Email</label>
                            <input asp-for="Input.Email" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Phone" class="form-label">Số điện thoại</label>
                            <input asp-for="Input.Phone" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Gender" class="form-label">Giới tính</label>
                            <select asp-for="Input.Gender" class="form-select">
                                <option value="">Chọn giới tính</option>
                                <option value="Male">Nam</option>
                                <option value="Female">Nữ</option>
                                <option value="Other">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Ngày sinh</label>
                            <input type="date" class="form-control" disabled />
                            <small class="text-muted">Ngày sinh sẽ được bổ sung ở phiên bản tiếp theo.</small>
                        </div>
                        <div class="col-12">
                            <label asp-for="Input.StreetAddress" class="form-label">Số nhà + tên đường</label>
                            <input asp-for="Input.StreetAddress" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.ProvinceId" class="form-label">Tỉnh/Thành phố</label>
                            <select asp-for="Input.ProvinceId" asp-items="Model.ProvinceOptions" class="form-select" id="koc-edit-province">
                                <option value="">Chọn Tỉnh/Thành phố</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Input.WardId" class="form-label">Phường/Xã</label>
                            <select asp-for="Input.WardId" asp-items="Model.WardOptions" class="form-select" id="koc-edit-ward">
                                <option value="">Chọn Phường/Xã</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="pane-social" role="tabpanel" aria-labelledby="tab-social" tabindex="0">
                    @for (var i = 0; i < Model.Platforms.Count; i++)
                    {
                        var platform = Model.Platforms[i];
                        <div class="card-x mb-3">
                            <input type="hidden" asp-for="Input.Platforms[i].Platform" value="@platform" />
                            <h3 class="h6 mb-3">@platform</h3>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Link kênh</label>
                                    <input asp-for="Input.Platforms[i].ChannelUrl" class="form-control" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Followers</label>
                                    <input asp-for="Input.Platforms[i].Followers" type="number" min="0" class="form-control" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label">Ngành hàng</label>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var category in Model.CategoryOptions)
                                        {
                                            var selected = Model.Input.Platforms.Count > i && Model.Input.Platforms[i].SelectedCategoryCodes.Contains(category.Value, StringComparer.OrdinalIgnoreCase);
                                            <label class="btn btn-sm @(selected ? "btn-warning" : "btn-outline-secondary")">
                                                <input type="checkbox"
                                                       name="Input.Platforms[@i].SelectedCategoryCodes"
                                                       value="@category.Value"
                                                       checked="@selected"
                                                       class="d-none" /> @category.Text
                                            </label>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <div class="tab-pane fade" id="pane-personal" role="tabpanel" aria-labelledby="tab-personal" tabindex="0">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label asp-for="Input.WeightKg" class="form-label">Cân nặng (kg)</label>
                            <input asp-for="Input.WeightKg" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.HeightCm" class="form-label">Chiều cao (cm)</label>
                            <input asp-for="Input.HeightCm" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.MaritalStatus" class="form-label">Tình trạng hôn nhân</label>
                            <select asp-for="Input.MaritalStatus" class="form-select">
                                <option value="">Chọn tình trạng</option>
                                <option value="Single">Độc thân</option>
                                <option value="Married">Đã kết hôn</option>
                                <option value="Other">Khác</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.BustCm" class="form-label">Vòng 1 (cm)</label>
                            <input asp-for="Input.BustCm" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.WaistCm" class="form-label">Vòng 2 (cm)</label>
                            <input asp-for="Input.WaistCm" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.HipCm" class="form-label">Vòng 3 (cm)</label>
                            <input asp-for="Input.HipCm" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.HasChildren" class="form-label">Có con chưa?</label>
                            <select asp-for="Input.HasChildren" class="form-select" id="koc-has-children">
                                <option value="false">Chưa</option>
                                <option value="true">Có</option>
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="Input.ServicePriceVnd" class="form-label">Bảng giá dịch vụ (VNĐ/post)</label>
                            <input asp-for="Input.ServicePriceVnd" class="form-control" />
                        </div>
                    </div>

                    <div class="mt-3" id="koc-children-box">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label mb-0">Thông tin con cái</label>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="add-child">Thêm con</button>
                        </div>
                        <div id="children-list">
                            @for (var i = 0; i < Model.Input.Children.Count; i++)
                            {
                                <div class="row g-2 mb-2 child-row">
                                    <div class="col-md-5"><input asp-for="Input.Children[i].Age" class="form-control child-age" placeholder="Tuổi" /></div>
                                    <div class="col-md-5">
                                        <select asp-for="Input.Children[i].Gender" class="form-select child-gender">
                                            <option value="">Giới tính</option>
                                            <option value="Male">Nam</option>
                                            <option value="Female">Nữ</option>
                                            <option value="Other">Khác</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100 remove-child">Xóa</button></div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <a asp-page="/Koc/Profile" class="btn btn-outline-secondary">Hủy</a>
                <button type="submit" class="btn btn-warning">Lưu hồ sơ</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var $province = $("#koc-edit-province");
            var $ward = $("#koc-edit-ward");
            var $hasChildren = $("#koc-has-children");
            var $childrenBox = $("#koc-children-box");
            var $childrenList = $("#children-list");

            function toggleChildren() {
                var show = ($hasChildren.val() || "").toLowerCase() === "true";
                $childrenBox.toggle(show);
            }

            function childTemplate(index) {
                return '' +
                    '<div class="row g-2 mb-2 child-row">' +
                    '<div class="col-md-5"><input type="number" class="form-control child-age" name="Input.Children[' + index + '].Age" placeholder="Tuổi" /></div>' +
                    '<div class="col-md-5"><select class="form-select child-gender" name="Input.Children[' + index + '].Gender">' +
                    '<option value="">Giới tính</option><option value="Male">Nam</option><option value="Female">Nữ</option><option value="Other">Khác</option>' +
                    '</select></div>' +
                    '<div class="col-md-2"><button type="button" class="btn btn-outline-danger w-100 remove-child">Xóa</button></div>' +
                    '</div>';
            }

            function reindexChildren() {
                $childrenList.find('.child-row').each(function (i) {
                    $(this).find('.child-age').attr('name', 'Input.Children[' + i + '].Age');
                    $(this).find('.child-gender').attr('name', 'Input.Children[' + i + '].Gender');
                });
            }

            $hasChildren.on('change', toggleChildren);
            toggleChildren();

            $('#add-child').on('click', function () {
                var index = $childrenList.find('.child-row').length;
                $childrenList.append(childTemplate(index));
            });

            $childrenList.on('click', '.remove-child', function () {
                $(this).closest('.child-row').remove();
                reindexChildren();
            });

            $province.on('change', function () {
                var provinceId = ($province.val() || "").trim();
                $ward.empty().append($('<option/>', { value: '', text: 'Chọn Phường/Xã' }));
                if (!provinceId) return;

                $.get('/Koc/EditProfile?handler=WardsByProvince', { provinceId: provinceId })
                    .done(function (res) {
                        $.each((res && res.data) ? res.data : [], function (_, ward) {
                            $ward.append($('<option/>', { value: ward.id, text: ward.name }));
                        });
                    });
            });
        })();
    </script>
}
