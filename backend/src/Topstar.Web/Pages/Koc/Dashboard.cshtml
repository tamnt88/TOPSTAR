@page
@model Topstar.Web.Pages.Koc.DashboardModel
@{
  ViewData["Title"] = "KOC Overview";
}
<div class="page-wrap card-list">
  <div class="d-flex justify-content-between align-items-end"><div><h1 class="section-title mb-0">KOC Dashboard</h1><div class="kpi-title">@Model.Data.DisplayName</div></div><div class="top-nav"><a class="active" asp-page="/Koc/Dashboard">Tong quan</a><a asp-page="/Koc/Academy">Hoc vien</a><a asp-page="/Koc/Jobs">Jobs</a><a asp-page="/Koc/Wallet">Thu nhap</a><a asp-page="/Koc/Profile">Ho so</a></div></div>
  <div class="kpi-grid">
    <div class="kpi-box"><div class="kpi-title">Job cho xac nhan</div><div class="kpi-value">@Model.Data.PendingConfirmJobs</div></div>
    <div class="kpi-box"><div class="kpi-title">Job dang thuc hien</div><div class="kpi-value">@Model.Data.ActiveJobs</div></div>
    <div class="kpi-box"><div class="kpi-title">Thu nhap uoc tinh</div><div class="kpi-value">@Model.Data.EstimatedIncome.ToString("N0")</div></div>
    <div class="kpi-box"><div class="kpi-title">Rating</div><div class="kpi-value">@Model.Data.AverageRating.ToString("0.0")</div></div>
  </div>
  <div class="card-x">
    <h2 class="h5">Viec can lam</h2>
    @if (Model.Data.TodoJobs.Count == 0)
    {
      <div class="list-row"><div><b>Chua co cong viec</b></div></div>
    }
    else
    {
      foreach (var row in Model.Data.TodoJobs)
      {
        <div class="list-row"><div><b>@row.CampaignTitle</b><div class="kpi-title">@row.Budget.ToString("N0") VND • @row.Status</div></div></div>
      }
    }
  </div>
</div>
