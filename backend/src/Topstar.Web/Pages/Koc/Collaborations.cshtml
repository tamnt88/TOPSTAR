@page
@model Topstar.Web.Pages.Koc.CollaborationsModel
@{
    ViewData["Title"] = "Lịch sử hợp tác";
}

<div class="koc-collaboration-page">
    <header class="koc-collaboration-header">
        <div>
            <span class="koc-page-eyebrow"><i class="fa-solid fa-clock-rotate-left"></i> Hồ sơ hợp tác</span>
            <h1><i class="fa-solid fa-handshake"></i> Lịch sử hợp tác</h1>
            <p>Theo dõi toàn bộ chiến dịch, Brand và các mốc xử lý trong một nơi.</p>
        </div>
    </header>

    <section class="koc-collaboration-card">
        <form class="koc-collaboration-filters" id="collaborationFilters">
            <div class="koc-filter-field is-keyword">
                <label for="collaborationSearch">Từ khóa</label>
                <div class="koc-filter-input">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    <input id="collaborationSearch" class="form-control" type="search"
                           placeholder="Tên chiến dịch hoặc Brand" autocomplete="off" />
                </div>
            </div>
            <div class="koc-filter-field">
                <label for="collaborationStatus">Trạng thái</label>
                <select id="collaborationStatus" class="form-select">
                    <option value="">Tất cả trạng thái</option>
                    <option value="Confirmed">Đang hợp tác</option>
                    <option value="Completed">Hoàn tất</option>
                    <option value="Cancelled">Đã hủy</option>
                    <option value="Rejected">Đã từ chối</option>
                </select>
            </div>
            <div class="koc-filter-field">
                <label for="collaborationPageSize">Hiển thị</label>
                <select id="collaborationPageSize" class="form-select">
                    <option value="10">10 dòng</option>
                    <option value="20">20 dòng</option>
                    <option value="50">50 dòng</option>
                </select>
            </div>
            <div class="koc-filter-action">
                <span class="koc-filter-action-label">Thao tác</span>
                <button class="btn btn-primary" type="submit">
                    <i class="fa-solid fa-filter"></i> Lọc
                </button>
            </div>
        </form>

        <div class="koc-collaboration-list-heading">
            <div>
                <h2><i class="fa-solid fa-table-list"></i> Danh sách hợp tác</h2>
                <p>Mở từng dòng để xem timeline và căn cứ xử lý.</p>
            </div>
            <span class="koc-collaboration-count" data-collaboration-count>
                <i class="fa-solid fa-handshake-angle"></i> 0 lần hợp tác
            </span>
        </div>

        <div class="koc-collaboration-table-wrap">
            <table id="kocCollaborationTable"
                   data-list-actions="false"
                   class="table koc-collaboration-table"
                   data-ajax-url="@Url.Page("/Koc/Collaborations", "Data")">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Chiến dịch</th>
                        <th>Brand</th>
                        <th>Xác nhận</th>
                        <th>Trạng thái</th>
                        <th>Sự kiện</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="/lib/datatables/js/dataTables.min.js"></script>
    <script src="/lib/datatables/js/dataTables.bootstrap5.min.js"></script>
    <script src="/js/koc/collaborations.js"></script>
}
