@page
@model Topstar.Web.Pages.Koc.AcademyModel
@{ViewData["Title"]="Học viện KOC";}
<div class="koc-academy-page">
 <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><h1 class="section-title mb-1">Học viện KOC</h1><p class="text-muted mb-0">Học theo từng bài, tiến độ được ghi nhận từ hoạt động thật của bạn.</p></div><a asp-page="/Public/Academy" target="_blank" class="btn btn-outline-primary">Xem lộ trình tổng quan</a></div>
 @if(!string.IsNullOrWhiteSpace(Model.Message)){<div class="alert @(Model.MessageSuccess?"alert-success":"alert-danger")">@Model.Message</div>}
 @if(Model.ContinueCourse is not null){var active=Model.ContinueCourse;var next=Model.NextLesson;<section class="koc-academy-continue"><div><span class="koc-page-eyebrow"><i class="fa-solid fa-bolt"></i> Tiếp tục lộ trình</span><h2>@active.Title</h2><p>Đã hoàn thành @active.Enrollment!.CompletedLessons/@active.Enrollment.TotalLessons bài · @active.Enrollment.ProgressPercent%</p><div class="progress" role="progressbar" aria-label="Tiến độ khóa học" aria-valuenow="@active.Enrollment.ProgressPercent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@active.Enrollment.ProgressPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div></div>@if(next is not null){<a class="btn btn-primary" href="#lesson-@next.Id"><i class="fa-solid fa-circle-play"></i> Học tiếp: @next.Title</a>}</section>}
 @if(Model.Courses.Count==0){<div class="card-x text-center py-5"><i class="fa-solid fa-graduation-cap fs-2 text-muted"></i><h2 class="h5 mt-3">Catalog đang được cập nhật</h2><p class="text-muted mb-0">Khóa học sẽ xuất hiện sau khi Admin xuất bản.</p></div>}
 <div class="row g-3">@foreach(var course in Model.Courses){<div class="col-12 col-xl-6"><article class="card-x h-100">
  <div class="d-flex justify-content-between gap-3"><div><h2 class="h5 mb-1">@course.Title</h2><div class="text-muted">@course.Level · @course.DurationWeeks tuần · @course.Lessons.Count bài</div></div>@if(course.Enrollment?.CompletedAtUtc is not null){<span class="badge bg-success align-self-start">Hoàn tất</span>}else if(course.Enrollment is not null){<span class="badge bg-primary align-self-start">Đang học</span>}else{<span class="badge bg-secondary align-self-start">Chưa đăng ký</span>}</div>
  <p class="mt-3">@course.Summary</p>
  @if(course.Enrollment is null){<form method="post" asp-page-handler="Enroll"><input type="hidden" name="courseId" value="@course.Id"/><button class="btn btn-primary w-100" disabled="@(course.Lessons.Count==0)">@(course.Lessons.Count==0?"Khóa học chưa có bài":"Đăng ký học")</button></form>}
  else{
   <div class="d-flex justify-content-between small mb-1"><span>Tiến độ</span><strong>@course.Enrollment.CompletedLessons/@course.Enrollment.TotalLessons bài · @course.Enrollment.ProgressPercent%</strong></div><div class="progress mb-3" role="progressbar" aria-valuenow="@course.Enrollment.ProgressPercent" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:@course.Enrollment.ProgressPercent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div></div>
   @if(course.Enrollment.CertificateCode is not null){<div class="koc-academy-certificate"><span><i class="fa-solid fa-certificate"></i></span><div><small>Chứng nhận TopStar</small><strong>@course.Enrollment.CertificateCode</strong><a asp-page="/Public/VerifyCertificate" asp-route-code="@course.Enrollment.CertificateCode" target="_blank">Xem và xác minh chứng nhận <i class="fa-solid fa-arrow-up-right-from-square"></i></a></div></div>}
   <div class="vstack gap-2">@foreach(var lesson in course.Lessons){<div id="lesson-@lesson.Id" class="border rounded p-3 d-flex flex-column flex-sm-row justify-content-between gap-2"><div><strong><i class="fa-solid @(lesson.IsCompleted?"fa-circle-check text-success":"fa-circle-play text-primary") me-1"></i>@lesson.Title</strong>@if(lesson.ContentUrl is not null){<div><a href="@lesson.ContentUrl" target="_blank" rel="noopener noreferrer" class="small">Mở nội dung bài học</a></div>}</div>@if(lesson.IsCompleted){<span class="badge bg-success align-self-start">Đã hoàn thành</span>}else{<form method="post" asp-page-handler="Complete"><input type="hidden" name="lessonId" value="@lesson.Id"/><button class="btn btn-sm btn-outline-success">Đánh dấu hoàn thành</button></form>}</div>}</div>
  }
 </article></div>}</div>
</div>
