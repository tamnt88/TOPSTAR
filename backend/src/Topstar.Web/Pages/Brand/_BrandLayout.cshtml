@using System.Security.Claims
@using Topstar.Application.Dashboard
@using Microsoft.EntityFrameworkCore
@inject Topstar.Infrastructure.Persistence.TopstarDbContext HeaderDbContext
@using Topstar.Application.Profiles
@using Topstar.Application.Website
@using Topstar.Application.Notifications
@inject IDashboardDataService DashboardDataService
@inject IProfileAccessService ProfileAccessService
@inject IWebsiteContentService WebsiteContentService
@inject INotificationInboxService NotificationInboxService
@if (Context.Request.Headers["X-Topstar-Workspace"] == "native")
{
    <div data-workspace-assets>@await RenderSectionAsync("Styles", required: false)</div>
    @RenderBody()
    <div data-workspace-scripts>@await RenderSectionAsync("Scripts", required: false)</div>
}
else
{
<!DOCTYPE html>
<html lang="vi">
<head>
    @{
        var website = await WebsiteContentService.GetWebsiteContentAsync(Context?.RequestAborted ?? default);
        var websiteName = website?.WebsiteName ?? "TopStar";
        var logoPath = string.IsNullOrWhiteSpace(website?.LogoUrl) ? "/images/logo.png" : website!.LogoUrl!;
        var faviconPath = string.IsNullOrWhiteSpace(website?.FaviconUrl) ? logoPath : website!.FaviconUrl!;
        var title = (ViewData["Title"] as string) ?? "Brand Dashboard";
    }
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - @websiteName</title>
    <link rel="icon" type="image/png" href="@faviconPath" />
    <link rel="apple-touch-icon" href="@faviconPath" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/brand/brand.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/portal-footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/impersonation.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/file-picker.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/notifications.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/select2/select2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/jquery-ui/jquery-ui.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/form-controls.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/statistics.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/shared/lists.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/ui-standard.css" asp-append-version="true" />
</head>
<body class="dashboard-body dashboard-body-brand">
    <partial name="/Pages/Shared/_ImpersonationBanner.cshtml" />
    @{
        var websiteBody = await WebsiteContentService.GetWebsiteContentAsync(Context?.RequestAborted ?? default);
        var websiteNameBody = websiteBody?.WebsiteName ?? "TopStar";
        var logoPathBody = string.IsNullOrWhiteSpace(websiteBody?.LogoUrl) ? "/images/logo.png" : websiteBody!.LogoUrl!;
        var path = (Context?.Request?.Path.Value ?? string.Empty).ToLowerInvariant();
        var roleCode = User?.Claims?.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value?.ToUpperInvariant() ?? "BRAND";
        var displayName = User?.Identity?.Name
            ?? User?.Claims?.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value
            ?? "Brand";

        var headerUserIdRaw = User?.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        var headerBrand = Guid.TryParse(headerUserIdRaw, out var headerUserId)
            ? await HeaderDbContext.BrandProfiles.AsNoTracking()
                .Where(x => x.UserId == headerUserId)
                .Select(x => new { x.CompanyName, x.LogoUrl })
                .FirstOrDefaultAsync(Context?.RequestAborted ?? default)
            : null;
        var headerAvatarUrl = headerBrand?.LogoUrl;
        if (!string.IsNullOrWhiteSpace(headerBrand?.CompanyName)) displayName = headerBrand.CompanyName;
        var parts = displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var initials = parts.Length switch
        {
            0 => "BR",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant()
        };

        var isProfileLocked = false;
        var missingProfileFieldCount = 0;
        var isProfileComplete = false;
        var isProfileApproved = false;
        var unreadBrandNotifications = 0;
        var brandUserIdRaw = User?.Claims?.FirstOrDefault(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(brandUserIdRaw, out var brandUserId))
        {
            var access = await ProfileAccessService.CheckBrandAsync(brandUserId, Context?.RequestAborted ?? default);
            isProfileLocked = !access.CanUseFeatures;
            missingProfileFieldCount = access.MissingFields.Count;
            isProfileComplete = access.IsComplete;
            isProfileApproved = access.IsApproved;
            unreadBrandNotifications = await NotificationInboxService.GetUnreadCountAsync(brandUserId, "BRAND", Context?.RequestAborted ?? default);
        }
    }

    <header class="brand-header">
        <div class="brand-header-inner container">
            <a class="brand-logo" asp-page="/Brand/Dashboard" aria-label="Về tổng quan Brand">
                <img src="@logoPathBody" alt="@websiteNameBody" />
            </a>
            <button class="brand-nav-mobile" type="button" aria-label="Mở menu" aria-expanded="false">
                <i class="fa-solid fa-bars"></i>
            </button>
            <nav class="brand-nav" aria-label="Điều hướng Brand">
                <a class="brand-nav-link @(path.StartsWith("/brand/dashboard") ? "active" : "")" asp-page="/Brand/Dashboard"><i class="fa-solid fa-chart-pie"></i><span>Tổng quan</span></a>
                <a class="brand-nav-link @(path.StartsWith("/brand/profile") || path.StartsWith("/brand/editprofile") ? "active" : "")" asp-page="/Brand/Profile"><i class="fa-solid fa-building-user"></i><span>Hồ sơ Brand</span></a>
                <a class="brand-nav-link @(((path.StartsWith("/brand/campaign") && !path.StartsWith("/brand/campaignfunding")) || path.StartsWith("/brand/shortlist") || path.StartsWith("/brand/booking") || path.StartsWith("/brand/shipment") || path.StartsWith("/brand/deliverable") || path.StartsWith("/brand/report") || path.StartsWith("/brand/review") || path.StartsWith("/brand/collaboration")) ? "active" : "")" asp-page="/Brand/Campaigns"><i class="fa-solid fa-bullhorn"></i><span>Chiến dịch</span></a>
                <a class="brand-nav-link @(path.StartsWith("/brand/campaignfunding") ? "active" : "")" asp-page="/Brand/CampaignFunding"><i class="fa-solid fa-shield-halved"></i><span>Thanh toán</span></a>
                <div class="brand-nav-group @(path.StartsWith("/brand/billing") || path.StartsWith("/brand/balance") ? "active" : "")">
                    <button class="brand-nav-link brand-nav-toggle" type="button" aria-expanded="false" aria-controls="brandFinanceMenu"><i class="fa-solid fa-wallet"></i><span>Tài chính <small aria-hidden="true">▾</small></span></button>
                    <div class="brand-nav-menu" id="brandFinanceMenu">
                        <a asp-page="/Brand/Billing" class="@(path.StartsWith("/brand/billing") ? "active" : null)" aria-current="@(path.StartsWith("/brand/billing") ? "page" : null)"><i class="fa-solid fa-file-invoice-dollar"></i><span><strong>Tài chính và hóa đơn</strong><small>Gói đã mua, phí dịch vụ và chứng từ</small></span></a>
                        <a asp-page="/Brand/Balance" class="@(path.StartsWith("/brand/balance") ? "active" : null)" aria-current="@(path.StartsWith("/brand/balance") ? "page" : null)"><i class="fa-solid fa-money-bill-transfer"></i><span><strong>Số dư</strong><small>Số dư khả dụng và yêu cầu rút tiền</small></span></a>
                    </div>
                </div>
                <a class="brand-nav-link @(path.StartsWith("/brand/dispute") ? "active" : "")" asp-page="/Brand/Disputes"><i class="fa-solid fa-headset"></i><span>Hỗ trợ</span></a>
            </nav>
            <a asp-page="/Brand/Notifications" class="brand-notification-bell" aria-label="Thông báo, @unreadBrandNotifications chưa đọc"><i class="fa-regular fa-bell"></i>@if(unreadBrandNotifications>0){<b>@(unreadBrandNotifications>99?"99+":unreadBrandNotifications)</b>}</a>
            <div class="dropdown brand-account-dropdown">
                <button class="brand-account-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="brand-avatar brand-header-avatar">@if (!string.IsNullOrWhiteSpace(headerAvatarUrl)) { <img src="@headerAvatarUrl" alt="Ảnh đại diện @displayName" /> } else { @initials }</span>
                    <strong>@displayName</strong>
                    <i class="fa-solid fa-chevron-down"></i>
                </button>
                <div class="dropdown-menu dropdown-menu-end brand-account-menu">
                    <div class="brand-account-summary">
                        <span class="brand-header-avatar">@if (!string.IsNullOrWhiteSpace(headerAvatarUrl)) { <img src="@headerAvatarUrl" alt="Ảnh đại diện @displayName" /> } else { @initials }</span>
                        <div><strong>@displayName</strong><small>Tài khoản Brand</small></div>
                    </div>
                    <div class="dropdown-divider"></div>
                    <button class="dropdown-item" type="button" data-bs-toggle="modal" data-bs-target="#brandChangePasswordModal">
                        <i class="fa-solid fa-key"></i>Đổi mật khẩu
                    </button>
                    <div class="dropdown-divider"></div>
                    <a asp-page="/Public/Logout" class="dropdown-item brand-account-logout"><i class="fa-solid fa-right-from-bracket"></i>Đăng xuất</a>
                </div>
            </div>
        </div>
    </header>

    @if (isProfileLocked && !path.StartsWith("/brand/editprofile"))
    {
        <div class="container brand-profile-alert-wrap">
            <div class="brand-profile-alert">
                <i class="fa-solid fa-circle-exclamation"></i>
                @if (!isProfileComplete)
                {
                    <div>
                        <strong>Hồ sơ Brand còn thiếu @missingProfileFieldCount mục</strong>
                        <span>Mở checklist để biết chính xác thông tin nào cần bổ sung và cập nhật đúng ô.</span>
                    </div>
                    <a asp-page="/Brand/EditProfile">Xem checklist <i class="fa-solid fa-arrow-right"></i></a>
                }
                else if (!isProfileApproved)
                {
                    <div>
                        <strong>Hồ sơ Brand đang chờ duyệt</strong>
                        <span>Thông tin bắt buộc đã đầy đủ. Bạn có thể xem lại hồ sơ và theo dõi trạng thái duyệt.</span>
                    </div>
                    <a asp-page="/Brand/EditProfile">Xem trạng thái <i class="fa-solid fa-arrow-right"></i></a>
                }
            </div>
        </div>
    }

    <main class="dashboard-main">
        <div class="container py-4">
            @RenderBody()
        </div>
    </main>

    <partial name="_PortalFooter" model='"Brand"' />

    <nav class="brand-mobile-bottom-nav" aria-label="Truy cập nhanh Brand trên điện thoại">
        <a asp-page="/Brand/Dashboard" asp-fragment="brand-action-inbox" class="@(path.StartsWith("/brand/dashboard") ? "active" : null)"><i class="fa-solid fa-list-check"></i><span>Việc cần làm</span></a>
        <a asp-page="/Brand/Campaigns" class="@(((path.StartsWith("/brand/campaign") && !path.StartsWith("/brand/campaignfunding")) || path.StartsWith("/brand/shortlist") || path.StartsWith("/brand/booking") || path.StartsWith("/brand/shipment") || path.StartsWith("/brand/deliverable")) ? "active" : null)"><i class="fa-solid fa-bullhorn"></i><span>Chiến dịch</span></a>
        <a asp-page="/Brand/Billing" class="@(path.StartsWith("/brand/billing") || path.StartsWith("/brand/balance") || path.StartsWith("/brand/package") || path.StartsWith("/brand/campaignfunding") ? "active" : null)"><i class="fa-solid fa-wallet"></i><span>Tài chính</span></a>
        <a asp-page="/Brand/Profile" class="@(path.StartsWith("/brand/profile") || path.StartsWith("/brand/editprofile") ? "active" : null)"><i class="fa-solid fa-building-user"></i><span>Hồ sơ</span></a>
    </nav>

    <div class="modal fade brand-security-modal" id="brandChangePasswordModal" tabindex="-1"
         data-bs-backdrop="static" data-bs-keyboard="false" aria-labelledby="brandChangePasswordModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form id="brandChangePasswordForm" method="post" action="/Brand/AccountSecurity?handler=ChangePassword" novalidate>
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <div class="brand-modal-heading">
                            <span><i class="fa-solid fa-shield-halved"></i></span>
                            <div><h2 class="modal-title" id="brandChangePasswordModalTitle">Đổi mật khẩu</h2><p>Cập nhật mật khẩu bảo vệ tài khoản Brand.</p></div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="brand-password-field">
                            <label for="brandCurrentPassword">Mật khẩu hiện tại <span>*</span></label>
                            <div class="brand-password-input"><i class="fa-solid fa-lock"></i><input id="brandCurrentPassword" name="currentPassword" type="password" autocomplete="current-password" /><button type="button" data-password-toggle aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button></div>
                            <div class="brand-field-error" data-error-for="currentPassword"></div>
                        </div>
                        <div class="brand-password-field">
                            <label for="brandNewPassword">Mật khẩu mới <span>*</span></label>
                            <div class="brand-password-input"><i class="fa-solid fa-key"></i><input id="brandNewPassword" name="newPassword" type="password" autocomplete="new-password" /><button type="button" data-password-toggle aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button></div>
                            <small>Tối thiểu 8 ký tự, gồm chữ hoa, chữ thường và chữ số.</small>
                            <div class="brand-field-error" data-error-for="newPassword"></div>
                        </div>
                        <div class="brand-password-field">
                            <label for="brandConfirmPassword">Xác nhận mật khẩu mới <span>*</span></label>
                            <div class="brand-password-input"><i class="fa-solid fa-check"></i><input id="brandConfirmPassword" name="confirmPassword" type="password" autocomplete="new-password" /><button type="button" data-password-toggle aria-label="Hiện mật khẩu"><i class="fa-regular fa-eye"></i></button></div>
                            <div class="brand-field-error" data-error-for="confirmPassword"></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i> Hủy</button>
                        <button type="submit" class="btn brand-btn-primary"><i class="fa-solid fa-shield-halved"></i> Cập nhật mật khẩu</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/select2/select2.min.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-ui/jquery-ui.min.js" asp-append-version="true"></script>
    <script src="~/js/shared/form-controls.js" asp-append-version="true"></script>
    <script src="~/js/shared/notifications.js" asp-append-version="true"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/dashboard.js"></script>
    <script src="~/js/brand/brand.js" asp-append-version="true"></script>
    <script src="~/js/shared/file-picker.js" asp-append-version="true"></script>
    <script src="~/js/shared/lists.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
}
