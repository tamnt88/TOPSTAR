@page
@model Topstar.Web.Pages.Brand.CampaignPreparationModel
@{ViewData["Title"]="Thông tin triển khai";}
<header class="brand-page-heading mb-4"><div><h1>Thông tin triển khai</h1><p>@Model.CampaignTitle</p></div><a asp-page="/Brand/CampaignWorkspace" asp-route-id="@Model.Id" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-1"></i>Trung tâm chiến dịch</a></header>
@if(Model.Message is not null){<div hidden data-ts-notification="success">@Model.Message</div>}
@if(!Model.CanEdit){<p>Chiến dịch đã triển khai hoặc đã kết thúc. Vui lòng liên hệ hỗ trợ nếu cần thay đổi.</p>}
<form method="post" class="card-x" novalidate><input asp-for="Id" type="hidden"/><div asp-validation-summary="All" class="text-danger"></div><fieldset disabled="@(!Model.CanEdit)"><div class="row g-3">
@if(Model.IsOnsite){
<div class="col-md-6"><label asp-for="Input.VenueName" class="form-label">Tên địa điểm</label><input asp-for="Input.VenueName" class="form-control"/></div>
<div class="col-md-6"><label asp-for="Input.VenueAddress" class="form-label">Địa chỉ</label><input asp-for="Input.VenueAddress" class="form-control"/></div>
<div class="col-md-6"><label asp-for="Input.ContactName" class="form-label">Người liên hệ</label><input asp-for="Input.ContactName" class="form-control"/></div>
<div class="col-md-6"><label asp-for="Input.ContactPhone" class="form-label">Số điện thoại liên hệ</label><input asp-for="Input.ContactPhone" class="form-control"/></div>
<div class="col-12"><label asp-for="Input.BookingInstructions" class="form-label">Hướng dẫn đặt lịch</label><textarea asp-for="Input.BookingInstructions" class="form-control" rows="2"></textarea></div>
}
<div class="col-12"><label asp-for="Input.Schedule" class="form-label">Lịch thực hiện</label><textarea asp-for="Input.Schedule" class="form-control" rows="2" placeholder="Ngày, giờ hoặc khung thời gian thực hiện"></textarea></div>
@if(!Model.IsOnsite && Model.Input.Mode=="RemoteProductReview"){
<div class="col-12"><label asp-for="Input.ShippingInstructions" class="form-label">Sản phẩm dự kiến gửi</label><textarea asp-for="Input.ShippingInstructions" class="form-control" rows="2"></textarea></div>
}
<div class="col-md-6"><label asp-for="Input.SupportDetails" class="form-label"><i class="fa-solid fa-gift me-1"></i>Quyền lợi hỗ trợ</label><textarea asp-for="Input.SupportDetails" class="form-control" rows="3"></textarea></div>
<div class="col-md-6"><label asp-for="Input.Requirements" class="form-label"><i class="fa-solid fa-video me-1"></i>Yêu cầu thực hiện</label><textarea asp-for="Input.Requirements" class="form-control" rows="3"></textarea></div>
</div>@if(Model.CanEdit){<div class="d-flex justify-content-end mt-3"><button class="btn brand-btn-primary"><i class="fa-solid fa-floppy-disk me-1"></i>Lưu</button></div>}</fieldset></form>
<partial name="_ValidationScriptsPartial"/>
