@page
@model Topstar.Web.Pages.Brand.BillingReceiptModel
@{ Layout = null; var i = Model.Invoice!; }
<!doctype html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><title>@i.InvoiceNumber</title>
<style>body{font-family:Arial,sans-serif;color:#222;margin:40px}.sheet{max-width:800px;margin:auto}.row{display:flex;justify-content:space-between;gap:24px}.line{border-top:1px solid #ddd;padding:12px 0}.amount{font-size:28px;font-weight:700}.muted{color:#666}.actions{margin-bottom:24px}@@media print{.actions{display:none}body{margin:0}}</style></head>
<body><div class="sheet"><div class="actions"><button onclick="window.print()">In / Lưu PDF</button> <a href="/Brand/Billing">Quay lại</a></div><div class="row"><div><h1>BIÊN NHẬN PHÍ DỊCH VỤ</h1><div class="muted">TopStar Platform</div></div><div><strong>@i.InvoiceNumber</strong><div>Trạng thái: @i.Status</div></div></div><hr/><h2>@i.CampaignTitle</h2><div>Brand: @i.BrandName</div><div class="line row"><span>Ngân sách campaign</span><strong>@i.CampaignBudget.ToString("N0", PortalFormat.Vietnamese) ₫</strong></div><div class="line row"><span>Phí dịch vụ (@((i.FeeRate*100).ToString("N0", PortalFormat.Vietnamese))%)</span><span class="amount">@i.FeeAmount.ToString("N0", PortalFormat.Vietnamese) ₫</span></div><div class="line"><div>Phát hành: @i.IssuedAtUtc?.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</div><div>Hạn thanh toán: @i.DueAtUtc?.ToVietnamTime().ToString("dd/MM/yyyy")</div>@if(i.PaidAtUtc.HasValue){<div>Thanh toán: @i.PaidAtUtc.Value.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</div><div>Tham chiếu: @i.PaymentReference</div>}</div><p class="muted">Biên nhận được tạo từ snapshot invoice bất biến trong hệ thống TopStar.</p></div></body></html>
