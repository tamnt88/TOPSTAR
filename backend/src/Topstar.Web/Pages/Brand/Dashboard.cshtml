@page
@model Topstar.Web.Pages.Brand.DashboardModel
@{
  ViewData["Title"] = "Brand Overview";
}
<div class="page-wrap card-list">
  <div class="d-flex justify-content-between align-items-end"><div><h1 class="section-title mb-0">Brand Dashboard</h1><div class="kpi-title">@Model.Data.BrandName</div></div><div class="top-nav"><a class="active" asp-page="/Brand/Dashboard">Tong quan</a><a asp-page="/Brand/Campaigns">Chien dich</a><a asp-page="/Brand/Reports">Bao cao & Danh gia</a></div></div>
  <div class="kpi-grid">
    <div class="kpi-box"><div class="kpi-title">Tong chien dich</div><div class="kpi-value">@Model.Data.TotalCampaigns</div></div>
    <div class="kpi-box"><div class="kpi-title">KOCs dang hop tac</div><div class="kpi-value">@Model.Data.TotalKocsInCampaigns</div></div>
    <div class="kpi-box"><div class="kpi-title">Tong Impressions</div><div class="kpi-value">@Model.Data.TotalImpressions.ToString("N0")</div></div>
    <div class="kpi-box"><div class="kpi-title">Tong budget</div><div class="kpi-value">@Model.Data.TotalBudget.ToString("N0")</div></div>
  </div>
  <div class="card-x">
    <h2 class="h5">Chien dich gan day</h2>
    @if (Model.Data.RecentCampaigns.Count == 0)
    {
      <div class="list-row"><div><b>Chua co du lieu campaign</b></div></div>
    }
    else
    {
      foreach (var row in Model.Data.RecentCampaigns)
      {
        <div class="list-row"><div><b>@row.Title</b><div class="kpi-title">KOCs @row.KocCount • Impressions @row.Impressions.ToString("N0") • Budget @row.Budget.ToString("N0")</div></div><span class="badge-x badge-blue">@row.Status</span></div>
      }
    }
  </div>
</div>
