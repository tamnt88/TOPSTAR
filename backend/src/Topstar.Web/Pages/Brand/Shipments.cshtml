@page
@model Topstar.Web.Pages.Brand.ShipmentsModel
@using Topstar.Application.Shipments
@{
    Layout = "_BrandLayout"; ViewData["Title"] = "Vận chuyển";
    string StatusLabel(string value) => value switch { ShipmentStatuses.NotCreated => "Chưa tạo vận đơn", ShipmentStatuses.Created => "Chờ xuất kho", ShipmentStatuses.InTransit => "Đang vận chuyển", ShipmentStatuses.Delivered => "Đã giao hàng", ShipmentStatuses.Issue => "Có sự cố", ShipmentStatuses.Returned => "Đã hoàn hàng", _ => "Chưa xác định" };
    string TrackingLabel(string value) => value switch { "PickedUp" => "Đã lấy hàng", "AtHub" => "Đang tại kho", "OutForDelivery" => "Đang giao hàng", "DeliveryAttempt" => "Đã thử giao", "Exception" => "Có sự cố", _ => "Cập nhật khác" };
    var isWorkspace = ViewContext.HttpContext.Request.Headers["X-Topstar-Workspace"] == "native";
}
<div class="brand-shipment-page">
    @if (!isWorkspace) { <header class="brand-page-heading"><div><span class="brand-page-eyebrow"><i class="fa-solid fa-truck-fast"></i> GIAO NHẬN SẢN PHẨM</span><h1>Vận chuyển sản phẩm</h1><p>Tạo vận đơn, theo dõi giao hàng và xử lý sự cố theo từng KOC.</p></div><span class="brand-count-pill">@Model.Window.Total lượt cần giao</span></header> }
    @if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert @(Model.MessageSuccess ? "alert-success" : "alert-danger")"><i class="fa-solid @(Model.MessageSuccess ? "fa-circle-check" : "fa-circle-exclamation")"></i> @Model.Message</div> }
    <section class="brand-shipment-stats" aria-label="Thống kê vận chuyển">
        <button type="button" class="is-active" data-shipment-filter=""><span class="is-all"><i class="fa-solid fa-boxes-stacked"></i></span><div><small>Tất cả lượt giao</small><strong>@Model.Window.Total</strong></div></button>
        <button type="button" data-shipment-filter="preparation"><span class="is-waiting"><i class="fa-solid fa-box"></i></span><div><small>Cần tạo / xuất kho</small><strong>@(Model.Window.Counts.GetValueOrDefault(ShipmentStatuses.NotCreated) + Model.Window.Counts.GetValueOrDefault(ShipmentStatuses.Created))</strong></div></button>
        <button type="button" data-shipment-filter="Đang vận chuyển"><span class="is-transit"><i class="fa-solid fa-truck-fast"></i></span><div><small>Đang vận chuyển</small><strong>@Model.Window.Counts.GetValueOrDefault(ShipmentStatuses.InTransit)</strong></div></button>
        <button type="button" data-shipment-filter="Đã giao hàng"><span class="is-delivered"><i class="fa-solid fa-circle-check"></i></span><div><small>Đã giao hàng</small><strong>@Model.Window.Counts.GetValueOrDefault(ShipmentStatuses.Delivered)</strong></div></button>
        <button type="button" data-shipment-filter="exception"><span class="is-issue"><i class="fa-solid fa-triangle-exclamation"></i></span><div><small>Sự cố / hoàn hàng</small><strong>@(Model.Window.Counts.GetValueOrDefault(ShipmentStatuses.Issue) + Model.Window.Counts.GetValueOrDefault(ShipmentStatuses.Returned))</strong></div></button>
    </section>
    @if (Model.Window.Total > 0) { <partial name="_ListWindow" model='new Topstar.Web.Features.Common.Paging.ListWindowViewModel("brandShipmentTable", Model.Window)' /> }
    @if (Model.Items.Count == 0) { <div class="brand-empty-state"><span><i class="fa-solid fa-box-open"></i></span><h2>@(Model.Window.Total == 0 ? "Chưa phát sinh lượt giao sản phẩm" : "Không tìm thấy lượt giao phù hợp")</h2><p>@(Model.Window.Total == 0 ? (isWorkspace ? "Lượt giao sẽ được tạo sau khi danh sách KOC được xác nhận nếu chiến dịch có yêu cầu gửi sản phẩm." : "Lượt giao sẽ được tạo sau khi chiến dịch có KOC chính thức và yêu cầu gửi sản phẩm.") : "Hãy thay đổi từ khóa hoặc bộ lọc trạng thái để xem kết quả khác.")</p></div> }
    else
    {
        <div class="brand-shipment-dt-shell table-responsive"><table id="brandShipmentTable" class="table brand-data-table align-middle w-100"><thead><tr><th>STT</th><th>KOC và chiến dịch</th><th>Người nhận</th><th>Vận đơn</th><th>Trạng thái</th><th>Xử lý</th></tr></thead><tbody>
        @{ var rowNumber = 0; }
        @foreach (var item in Model.Items)
        {
            rowNumber++;
            var statusClass = item.Status switch { ShipmentStatuses.Delivered => "is-completed", ShipmentStatuses.Issue => "is-danger", ShipmentStatuses.InTransit => "is-published", ShipmentStatuses.Returned => "is-muted", _ => "is-warning" };
            <tr>
                <td class="text-center">@rowNumber</td>
                <td><div class="brand-shipment-person"><span><i class="fa-solid fa-user"></i></span><div><strong>@item.KocName</strong><small>@item.CampaignTitle</small></div></div></td>
                <td><strong>@item.ReceiverName</strong><small>@item.ReceiverPhone</small><small title="@item.Address"><i class="fa-solid fa-location-dot"></i> @item.Address</small></td>
                <td>@if (!string.IsNullOrWhiteSpace(item.TrackingCode)) { <strong>@item.TrackingCode</strong><small>@item.Carrier</small> } else { <span class="text-muted">Chưa có mã vận đơn</span> }</td>
                <td><span class="brand-status-pill @statusClass">@StatusLabel(item.Status)</span></td>
                <td class="text-center"><button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#shipmentDetail-@item.ParticipationId" title="Xem và xử lý vận chuyển"><i class="fa-regular fa-eye"></i></button></td>
            </tr>
        }
        </tbody></table></div>
        @foreach (var item in Model.Items)
        {
            var modalId = $"shipmentDetail-{item.ParticipationId}";
            <div class="modal fade brand-shipment-detail-modal" id="@modalId" tabindex="-1" data-bs-backdrop="static" aria-hidden="true"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content brand-action-modal"><div class="modal-header"><div class="brand-modal-title"><span><i class="fa-solid fa-truck-fast"></i></span><div><h2>@item.KocName</h2><p>@item.CampaignTitle · @StatusLabel(item.Status)</p></div></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div><div class="modal-body"><ul class="ts-tabs nav nav-tabs brand-shipment-tabs" role="tablist"><li><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#overview-@item.ParticipationId" type="button"><i class="fa-solid fa-circle-info"></i> Tổng quan</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#process-@item.ParticipationId" type="button"><i class="fa-solid fa-gears"></i> Xử lý</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#evidence-@item.ParticipationId" type="button"><i class="fa-solid fa-images"></i> Bằng chứng</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tracking-@item.ParticipationId" type="button"><i class="fa-solid fa-route"></i> Hành trình</button></li><li><button class="nav-link" data-bs-toggle="tab" data-bs-target="#history-@item.ParticipationId" type="button"><i class="fa-solid fa-clock-rotate-left"></i> Lịch sử</button></li></ul><div class="tab-content brand-shipment-tab-content"><section class="tab-pane fade show active" id="overview-@item.ParticipationId"><dl class="brand-support-facts"><div><dt>Người nhận</dt><dd>@item.ReceiverName · @item.ReceiverPhone</dd></div><div><dt>Địa chỉ nhận hàng</dt><dd>@item.Address</dd></div><div><dt>Vận đơn</dt><dd>@(item.TrackingCode ?? "Chưa có mã vận đơn")</dd></div><div><dt>Nhà vận chuyển</dt><dd>@(item.Carrier ?? "Chưa xác định")</dd></div></dl></section><section class="tab-pane fade" id="process-@item.ParticipationId">
            @if (item.ShipmentId is null) { <form method="post" asp-page-handler="Create"><input type="hidden" name="participationId" value="@item.ParticipationId"><div class="brand-shipment-modal-guide"><i class="fa-solid fa-circle-info"></i> Tạo hồ sơ vận chuyển trước khi xuất kho.</div><button class="btn btn-brand-primary"><i class="fa-solid fa-box"></i> Tạo vận đơn</button></form> }
            else if (item.Status is ShipmentStatuses.Created or ShipmentStatuses.Returned) { <form method="post" asp-page-handler="Dispatch" class="js-shipment-dispatch-form" novalidate><input type="hidden" name="id" value="@item.ShipmentId"><div class="brand-shipment-modal-field"><label>Nhà vận chuyển <em>*</em></label><div><input name="carrier" maxlength="100" placeholder="Ví dụ: GHN, GHTK, Viettel Post"><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="carrier"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><div class="brand-shipment-modal-field"><label>Mã vận đơn <em>*</em></label><div><input name="trackingCode" maxlength="100" placeholder="Nhập mã do đơn vị vận chuyển cung cấp"><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="trackingCode"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><button class="btn btn-brand-primary"><i class="fa-solid fa-check"></i> @(item.Status == ShipmentStatuses.Returned ? "Gửi lại sản phẩm" : "Xác nhận xuất kho")</button></form> }
            else if (item.Status == ShipmentStatuses.Issue) { <form method="post" asp-page-handler="Resolve" class="js-shipment-resolve-form" novalidate><input type="hidden" name="id" value="@item.ShipmentId"><div class="brand-shipment-modal-guide"><i class="fa-solid fa-triangle-exclamation"></i> @(item.IssueNote ?? "Vận đơn đang có sự cố cần xử lý.")</div><div class="brand-shipment-modal-field"><label>Hướng xử lý <em>*</em></label><div><select name="decision"><option value="">Chọn hướng xử lý</option><option value="@ShipmentStatuses.InTransit">Tiếp tục vận chuyển</option><option value="@ShipmentStatuses.Returned">Hoàn hàng</option></select><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="decision"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><div class="brand-shipment-modal-field"><label>Ghi chú xử lý <em>*</em></label><div><textarea name="note" maxlength="1000" rows="4" placeholder="Mô tả phương án xử lý sự cố (10–1.000 ký tự)"></textarea><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="note"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><button class="btn btn-brand-primary"><i class="fa-solid fa-check"></i> Xác nhận xử lý</button></form> }
            else if (item.Status == ShipmentStatuses.InTransit) { <form method="post" asp-page-handler="Tracking" class="js-shipment-tracking-form" novalidate><input type="hidden" name="id" value="@item.ShipmentId"><div class="brand-shipment-modal-guide"><i class="fa-solid fa-route"></i> Cập nhật checkpoint mới nhất để Brand và KOC cùng theo dõi.</div><div class="brand-shipment-modal-field"><label>Trạng thái hành trình <em>*</em></label><div><select name="eventCode"><option value="">Chọn trạng thái</option><option value="PickedUp">Đã lấy hàng</option><option value="AtHub">Đang tại kho</option><option value="OutForDelivery">Đang giao hàng</option><option value="DeliveryAttempt">Đã thử giao</option><option value="Exception">Có sự cố</option><option value="Other">Cập nhật khác</option></select><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="eventCode"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><div class="brand-shipment-modal-field"><label>Mô tả cập nhật <em>*</em></label><div><textarea name="description" maxlength="1000" rows="3" placeholder="Mô tả trạng thái vận chuyển"></textarea><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="description"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><div class="brand-shipment-modal-field"><label>Địa điểm</label><div><input name="location" maxlength="300" placeholder="Ví dụ: Kho trung chuyển TP.HCM"><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="location"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><div class="brand-shipment-modal-field"><label>Thời điểm <em>*</em></label><div><input type="datetime-local" name="occurredAtLocal" value="@DateTime.UtcNow.AddHours(7).ToString("yyyy-MM-ddTHH:mm")"><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="occurredAtLocal"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><button class="btn btn-brand-primary"><i class="fa-solid fa-location-arrow"></i> Cập nhật hành trình</button></form> }
            else { <div class="brand-shipment-modal-guide"><i class="fa-solid fa-circle-check"></i> Vận đơn đang ở trạng thái “@StatusLabel(item.Status)”.</div> }
            </section><section class="tab-pane fade" id="evidence-@item.ParticipationId"><div class="brand-evidence-heading"><div><h3><i class="fa-solid fa-clock-rotate-left"></i> Lịch sử bằng chứng</h3><p>Ảnh được lưu theo thời gian và không thể chỉnh sửa trực tiếp.</p></div><span>@item.Evidence.Count ảnh</span></div>@if (item.Evidence.Count == 0) { <div class="brand-evidence-empty"><i class="fa-regular fa-images"></i><strong>Chưa có ảnh bằng chứng</strong><span>Ảnh đóng gói và giao nhận sẽ xuất hiện tại đây.</span></div> } else { <div class="brand-evidence-gallery">@foreach (var evidence in item.Evidence.OrderByDescending(x => x.CreatedAtUtc)) { <article><a href="@evidence.FileUrl" target="_blank" rel="noopener"><img src="@evidence.FileUrl" alt="Bằng chứng giao nhận"><span><i class="fa-solid fa-magnifying-glass-plus"></i></span></a><div><strong>@(string.IsNullOrWhiteSpace(evidence.Caption) ? "Ảnh bằng chứng giao nhận" : evidence.Caption)</strong><p><span><i class="fa-solid fa-user"></i> @(evidence.ActorRole == "BRAND" ? "Brand" : "KOC")</span><time><i class="fa-regular fa-clock"></i> @evidence.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</time></p></div></article> }</div> }@if (item.ShipmentId.HasValue) { <div class="brand-evidence-upload-heading"><i class="fa-solid fa-cloud-arrow-up"></i><div><h3>Thêm bằng chứng mới</h3><p>Tải ảnh thể hiện rõ tình trạng đóng gói hoặc bàn giao.</p></div></div><form method="post" asp-page-handler="Evidence" enctype="multipart/form-data" class="js-shipment-evidence-form" novalidate><input type="hidden" name="id" value="@item.ShipmentId"><div class="brand-shipment-modal-field"><label>Ảnh bằng chứng <em>*</em></label><div class="brand-file-picker"><input class="brand-file-picker-input" type="file" name="evidenceFile" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"><label class="brand-file-picker-drop"><span><i class="fa-solid fa-cloud-arrow-up"></i></span><strong>Kéo thả ảnh vào đây</strong><small>hoặc <b>chọn ảnh từ thiết bị</b></small></label><div class="brand-file-picker-preview"><img alt="Ảnh đã chọn"><div><strong></strong><small></small></div><button type="button" aria-label="Bỏ ảnh"><i class="fa-solid fa-xmark"></i></button></div><i class="fa-solid fa-circle-exclamation"></i></div><small>Chấp nhận JPG, PNG hoặc WEBP; dung lượng tối đa 5 MB.</small><span data-error-for="evidenceFile"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><div class="brand-shipment-modal-field"><label>Mô tả ảnh <em>*</em></label><div><textarea name="caption" maxlength="500" rows="3" placeholder="Mô tả tình trạng đóng gói, bàn giao hoặc sự cố"></textarea><i class="fa-solid fa-circle-exclamation"></i></div><span data-error-for="caption"><i class="fa-solid fa-circle-exclamation"></i><b></b></span></div><button class="btn btn-brand-primary"><i class="fa-solid fa-upload"></i> Tải ảnh lên</button></form> }</section><section class="tab-pane fade" id="tracking-@item.ParticipationId"><div class="brand-shipment-timeline">@foreach (var tracking in item.Tracking) { <p><strong>@TrackingLabel(tracking.EventCode)</strong><time>@tracking.OccurredAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm")</time><span>@tracking.Description</span></p> }</div></section><section class="tab-pane fade" id="history-@item.ParticipationId"><div class="brand-shipment-timeline">@foreach (var history in item.History) { <p><strong>@StatusLabel(history.ToStatus)</strong><time>@history.CreatedAtUtc.ToVietnamTime().ToString("dd/MM/yyyy HH:mm")</time>@if (!string.IsNullOrWhiteSpace(history.Note)) { <span>@history.Note</span> }</p> }</div></section></div></div><div class="modal-footer"><button class="btn btn-light" data-bs-dismiss="modal"><i class="fa-solid fa-xmark"></i> Đóng</button></div></div></div></div>
        }
    }
</div>

@section Styles { <link rel="stylesheet" href="~/lib/datatables/css/dataTables.bootstrap5.min.css?v=2.3.8"> }
<script id="shipmentCheckpointData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Checkpoints.Select(x=>new{x.Code,x.Name})))</script>
@section Scripts { <script src="~/lib/datatables/js/dataTables.min.js?v=2.3.8"></script><script src="~/lib/datatables/js/dataTables.bootstrap5.min.js?v=2.3.8"></script><script src="~/js/brand/shipment-checkpoints.js" asp-append-version="true"></script><script src="~/js/brand/brand-shipments.js" asp-append-version="true"></script> }
