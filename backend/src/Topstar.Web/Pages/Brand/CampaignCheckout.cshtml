@page
@model Topstar.Web.Pages.Brand.CampaignCheckoutModel
@{ViewData["Title"]="Thanh toán chiến dịch";}
@section Styles {
<link rel="stylesheet" href="~/css/brand/campaign-needs.css" asp-append-version="true" />
}
<div><header class="mb-4"><span class="brand-page-eyebrow"><i class="fa-solid fa-shield-halved me-2"></i>THANH TOÁN</span><h1>Kiểm tra và thanh toán</h1><p class="text-muted">@Model.Campaign.Title</p></header>
@{
    ViewData["CreationInfoUrl"] = Url.Page("/Brand/CampaignEdit", new { id = Model.CampaignId });
    ViewData["CreationNeedsUrl"] = ViewData["CreationInfoUrl"] + "#campaignBudgetDisplay";
}
<partial name="_CampaignCreationSteps" model="3" />
<form method="post" novalidate><input asp-for="CampaignId" type="hidden"/><input asp-for="ExpectedTotal" type="hidden"/><input asp-for="Operation" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="row g-4"><div class="col-lg-7"><section class="card-x mb-4"><h2 class="h5 mb-3"><i class="fa-solid fa-bullseye me-2"></i>Nhu cầu chiến dịch</h2><dl class="row mb-0"><dt class="col-6">Ngân sách chiến dịch</dt><dd class="col-6 text-end text-nowrap">@PortalFormat.Money(Model.Campaign.BudgetAmount)</dd><dt class="col-6">Số KOC</dt><dd class="col-6 text-end">@Model.Campaign.DesiredKocCount</dd><dt class="col-6">Cách tuyển</dt><dd class="col-6 text-end">@(Model.Campaign.BrandSelectionSnapshot?"Brand tự chọn":"TopStar phân bổ")</dd></dl></section>
<section class="card-x"><h2 class="h5 mb-3"><i class="fa-solid fa-credit-card me-2"></i>Phương thức thanh toán</h2><label asp-for="PaymentMethod" class="form-label">Chọn phương thức</label><select asp-for="PaymentMethod" class="form-select" disabled="@(Model.HasPaymentSnapshot?"disabled":null)">@if(Model.Config.BankTransferEnabled){<option value="BankTransfer">Chuyển khoản ngân hàng</option>}@if(Model.Config.VnPayEnabled){<option value="VnPay">Thanh toán online</option>}else if(Model.Config.OnePayEnabled){<option value="OnePay">Thanh toán online</option>}<option value="BrandBalance">Thanh toán bằng số dư</option></select>@if(Model.HasPaymentSnapshot){<input type="hidden" name="PaymentMethod" value="@Model.Funding!.PaymentMethod"/>}<span asp-validation-for="PaymentMethod" class="text-danger"></span><div class="border rounded-3 p-3 mt-3"><div class="d-flex justify-content-between gap-3 mb-2"><strong>Số dư khả dụng</strong><strong class="text-nowrap">@PortalFormat.Money(Model.Available)</strong></div><label class="d-flex gap-2 align-items-center"><input asp-for="UseBalance"/>Dùng số dư trước, thanh toán phần còn thiếu</label></div></section></div>
<div class="col-lg-5"><section class="card-x"><h2 class="h5 mb-3">Chi tiết thanh toán</h2><dl><div class="d-flex justify-content-between gap-3 mb-3"><dt>Thù lao KOC (trước khấu trừ)</dt><dd class="text-nowrap">@PortalFormat.Money(Model.Campaign.BudgetAmount)</dd></div><div class="d-flex justify-content-between gap-3 mb-3"><dt>Phí nền tảng Brand</dt><dd class="text-nowrap">@PortalFormat.Money(Model.HasPaymentSnapshot?Model.Funding!.PlatformFeeSnapshot:Model.Fee)</dd></div><div class="d-flex justify-content-between gap-3 mb-3"><dt>Thuế GTGT @((Model.HasPaymentSnapshot?Model.Funding!.VatMode:Model.Tax?.Mode)=="Included"?"(đã gồm trong giá)":"")</dt><dd class="text-nowrap">@PortalFormat.Money(Model.HasPaymentSnapshot?Model.Funding!.VatAmount:Model.Tax?.Vat??0)</dd></div><div class="d-flex justify-content-between gap-3 mb-3"><dt>Phí thanh toán</dt><dd class="text-nowrap">@PortalFormat.Money(Model.HasPaymentSnapshot?Model.Funding!.GatewayFeeSnapshot:Model.Gateway)</dd></div><div class="d-flex justify-content-between gap-3 border-top pt-3"><dt>Tổng thanh toán</dt><dd class="fw-bold text-nowrap"><span id="checkout-total">@PortalFormat.Money(Model.Total)</span></dd></div></dl>@if(Model.Funding?.BalanceAppliedAmount>0){<div class="d-flex justify-content-between gap-3 border-top py-3"><span>Đã dùng số dư</span><strong class="text-nowrap">@PortalFormat.Money(Model.Funding.BalanceAppliedAmount)</strong></div><div class="d-flex justify-content-between gap-3 mb-3"><span>Còn cần thanh toán</span><strong class="text-nowrap">@PortalFormat.Money(Model.Funding.RemainingPayment)</strong></div>}<label class="d-flex gap-2 align-items-start"><input asp-for="Agree" class="mt-1"/>Tôi xác nhận thông tin, chi phí và điều khoản dịch vụ.</label><span asp-validation-for="Agree" class="text-danger d-block"></span><button data-checkout-submit class="btn brand-btn-primary w-100 mt-3"><i class="fa-solid fa-lock me-2"></i>Xác nhận và thanh toán</button><a asp-page="/Brand/CampaignEdit" asp-route-id="@Model.CampaignId" class="btn btn-outline-secondary w-100 mt-2">Quay lại thông tin</a></section></div></div></form></div>

@section Scripts{
<script>
jQuery(function($){$('#PaymentMethod').on('change',function(){var select=this;select.disabled=true;$('[data-checkout-submit]').prop('disabled',true);$.getJSON(location.pathname,{handler:'Quote',campaignId:$('#CampaignId').val(),method:select.value}).done(function(q){$('#ExpectedTotal').val(q.total);$('#checkout-total').text(new Intl.NumberFormat('vi-VN').format(q.total)+' đ');location.replace(location.pathname+'?campaignId='+encodeURIComponent($('#CampaignId').val())+'&method='+encodeURIComponent(select.value));}).fail(function(){window.TopstarNotify?.error('Không tải được chi phí thanh toán. Vui lòng thử lại.');}).always(function(){select.disabled=false;$('[data-checkout-submit]').prop('disabled',false);});});});
</script>
}
