@page "/"
@model Topstar.Web.Pages.IndexModel
@{
    var home = Model.Homepage;
    ViewData["Title"] = "TopStar - Nền tảng KOC/KOL dành cho Brand";
    ViewData["Description"] = home.HeroDescription;
    ViewData["ShareImage"] = home.HeroImageUrl;
}
@section Styles {
    <link rel="stylesheet" href="~/css/public/homepage.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public/homepage-feature-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/public/homepage-partners-swiper.css" asp-append-version="true" />
}

<main class="landing-home home-cms">
    <section class="landing-hero py-5 reveal-up">
        <div class="container">
            <div class="row align-items-center g-3">
                <div class="col-lg-6 hero-copy-col">
                    <span class="landing-pill"><i class="fi-rr-sparkles"></i> @home.TrustLabel</span>
                    <h1 class="landing-title mt-3">@home.HeroTitle</h1>
                    <p class="landing-desc mt-3">@home.HeroDescription</p>
                    <div class="d-flex gap-2 mt-4 flex-wrap">
                        <a class="btn landing-btn-primary" href="@home.PrimaryCtaUrl">@home.PrimaryCtaText</a>
                        <a class="btn landing-btn-outline" href="@home.SecondaryCtaUrl">@home.SecondaryCtaText</a>
                    </div>
                </div>
                <div class="col-lg-6 hero-right-col">
                    <div class="hero-visual-wrap">
                        <img src="@home.HeroImageUrl" alt="TopStar KOC/KOL" class="hero-main-couple" />
                    </div>
                </div>
            </div>
            @if (home.ShowFeaturedCreators)
            {
                <div class="swiper hero-koc-swiper">
                    <div class="swiper-wrapper">
                        @foreach (var item in home.Creators.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder))
                        {
                            <div class="swiper-slide">
                                <article class="hero-koc-card">
                                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                    <div class="hero-koc-tags"><span>@item.Category</span><span>@item.Followers</span></div>
                                    <div class="hero-koc-card-body"><strong>@item.Name</strong><small>KOC nổi bật TopStar</small></div>
                                </article>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <section class="home-section home-about reveal-up">
        <div class="container home-about__grid"><div class="home-about__visual"><img src="~/images/icon/12.png" alt="Hệ sinh thái TopStar" loading="lazy"/><span class="home-float-card"><b>500+</b> Brand tin dùng</span></div><div><p class="home-eyebrow">@home.AboutEyebrow</p><h2>@home.AboutTitle</h2><p class="home-lead">@home.AboutDescription</p><div class="home-feature-list">@foreach(var item in home.Features.Where(x=>x.IsVisible).OrderBy(x=>x.DisplayOrder)){<article><span>@if(item.IconClass.StartsWith('/')){<img src="@item.IconClass" alt="" loading="lazy"/>}else{<i class="@item.IconClass"></i>}</span><div><h3>@item.Title</h3><p>@item.Description</p></div></article>}</div></div></div>
    </section>

    <section class="home-section home-process reveal-up"><div class="container"><p class="home-eyebrow text-center">QUY TRÌNH TINH GỌN</p><h2 class="text-center">@home.ProcessTitle</h2><div class="home-process__grid">@foreach(var item in home.ProcessSteps.Where(x=>x.IsVisible).OrderBy(x=>x.DisplayOrder)){<article><span>@item.StepNumber</span><h3>@item.Title</h3><p>@item.Description</p></article>}</div><div class="text-center mt-4"><a class="home-btn home-btn--primary" href="@home.PrimaryCtaUrl">Bắt đầu chiến dịch <i class="fa-solid fa-arrow-right"></i></a></div></div></section>

    @if (home.ShowMetrics)
    {
        var metricIcons = new[] { "fa-building", "fa-users", "fa-bullhorn", "fa-face-smile-beam" };
        var metricIndex = 0;
        <section class="home-section home-proof reveal-up">
            <div class="container">
                <div class="home-proof__heading">
                    <p class="home-eyebrow">SỐ LIỆU VẬN HÀNH</p>
                    <h2>@home.MetricsTitle</h2>
                    <p>Những con số phản ánh quy mô cộng đồng và năng lực triển khai chiến dịch của TopStar.</p>
                </div>
                <div class="home-metrics">
                    @foreach (var item in home.Metrics.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder))
                    {
                        var digits = System.Text.RegularExpressions.Regex.Replace(item.Value ?? string.Empty, "[^0-9]", string.Empty);
                        var suffix = (item.Value ?? string.Empty).Trim().EndsWith("+", StringComparison.Ordinal) ? "+" : (item.Value ?? string.Empty).Trim().EndsWith("%", StringComparison.Ordinal) ? "%" : string.Empty;
                        var iconClass = metricIcons[metricIndex % metricIcons.Length];
                        <article class="home-metric">
                            <span class="home-metric__icon" aria-hidden="true"><i class="fa-solid @iconClass"></i></span>
                            <div>
                                <strong class="counter-value" data-target="@digits" data-suffix="@suffix">@item.Value</strong>
                                <span>@item.Label</span>
                            </div>
                        </article>
                        metricIndex++;
                    }
                </div>
                <div class="home-proof__foot">
                    <span><i class="fa-solid fa-circle-check"></i> Hồ sơ được xác thực</span>
                    <span><i class="fa-solid fa-chart-line"></i> Hiệu quả được theo dõi</span>
                    <span><i class="fa-solid fa-shield-halved"></i> Quy trình có lưu vết</span>
                </div>
            </div>
        </section>
    }

    @if (home.ShowPartners)
    {
        var visiblePartners = home.Partners.Where(x => x.IsVisible).OrderBy(x => x.DisplayOrder).ToArray();
        <section class="home-section home-partners reveal-up">
            <div class="container">
                <p class="home-eyebrow text-center">ĐỐI TÁC TIN CẬY</p>
                <h2 class="text-center">@home.PartnerTitle</h2>
                <p class="home-section-desc">@home.PartnerDescription</p>
                @if (visiblePartners.Length > 0)
                {
                    <div class="home-partners__shell">
                        <div class="swiper home-partners-swiper" data-partner-count="@visiblePartners.Length">
                            <div class="swiper-wrapper">
                                @foreach (var item in visiblePartners)
                                {
                                    <div class="swiper-slide"><a href="@item.Url" aria-label="@item.Name"><img src="@item.LogoUrl" alt="@item.Name" loading="lazy" /></a></div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <section class="home-final reveal-up"><div class="container"><div><p class="home-eyebrow">ĐỒNG HÀNH CÙNG TOPSTAR</p><h2>@home.FinalCtaTitle</h2><p>@home.FinalCtaDescription</p></div><div class="home-actions"><a class="home-btn home-btn--light" href="@home.FinalPrimaryCtaUrl">@home.FinalPrimaryCtaText</a><a class="home-btn home-btn--ghost" href="@home.FinalSecondaryCtaUrl">@home.FinalSecondaryCtaText</a></div></div></section>
</main>
